index 0000000..2cd110b
--- /dev/null
+++ b/win32/winapi/src/d3d9/device.rs
@@ -0,0 +1,310 @@
+//! IDirect3DDevice9 COM identity and browser-backed attachment lifecycle.
+use super::*;
+#[derive(Clone,Copy,Default)]
+struct Stream{buffer:u32,offset:u32,stride:u32}
+#[derive(Clone)]
+struct Device{refs:u32,parent:u32,backend:u32,focus:u32,flags:u32,scene:bool,color:u32,depth:u32,states:HashMap<u32,u32>,transforms:HashMap<u32,[u32;16]>,streams:[Stream;16],indices:u32,declaration:u32,fvf:u32,shaders:[u32;2],textures:[u32;16],samplers:[[u32;14];16],viewport:[u32;6],target_size:[u32;2],constants:std::sync::Arc<Mutex<super::constants::Registers>>}
+static DEVICES:LazyLock<Mutex<HashMap<u32,Device>>>=LazyLock::new(||Mutex::new(HashMap::new()));
+pub static mut VTABLE:u32=0;
+const IID_DEVICE:[u8;16]=[0x96,0x3b,0x22,0xd0,0x7a,0xbf,0xfd,0x43,0x92,0xbd,0xa4,0x3b,0x0d,0x82,0xb9,0xeb];
