+pub fn create(ctx:&mut Context,parent:u32,backend:u32,focus:u32,flags:u32,width:u32,height:u32,format:u32)->u32{
+ let vtable=unsafe{VTABLE};assert!(valid(ctx,vtable,119*4),"device vtable not linked");
+ let p=kernel32::lock().process_heap.alloc(&mut ctx.memory,4);ctx.memory.write::<u32>(p,vtable);
+ let color=IDirect3DSurface9::create_owned(ctx,p,width,height,format,1);let depth=IDirect3DSurface9::create_owned(ctx,p,width,height,75,2);
+ IDirect3D9::AddRef(ctx,parent);assert!(DEVICES.lock().unwrap().insert(p,Device{refs:1,parent,backend,focus,flags,scene:false,color,depth,states:default_states()}).is_none());p
+}
+#[win32_derive::dllexport]
+pub fn QueryInterface(ctx:&mut Context,this:u32,iid:u32,out:u32)->u32{
+ device(this);if !valid(ctx,out,4){return E_POINTER}ctx.memory.write::<u32>(out,0);
+ if !valid(ctx,iid,16){return E_POINTER}let id=&ctx.memory.bytes[iid as usize..iid as usize+16];
+ if id!=IID_UNKNOWN&&id!=IID_DEVICE{return E_NOINTERFACE}AddRef(ctx,this);ctx.memory.write::<u32>(out,this);D3D_OK
