+#[cfg(test)]
+mod relative_mouse_tests {
+    use super::Mouse;
+
+    #[test]
+    fn pointer_lock_delta_resolves_after_guest_warp() {
+        let mut mouse = Mouse::default();
+        mouse.warp(400, 300);
+        let resolved = mouse.resolve_relative(&host::RelativeMouseMessage {
+            dx: 7,
+            dy: -4,
+            buttons: host::MouseButton::Left,
+        });
+        assert_eq!((resolved.x, resolved.y), (407, 296));
+        assert_eq!(resolved.buttons, host::MouseButton::Left);
     }
 }
 
