+//! BASS compatibility shim.
+//!
+//! Some older multimedia programs import BASS for optional music. These calls
+//! preserve the ABI and successful lifecycle semantics while leaving actual
+//! browser audio to a later shared WebAudio backend.
+
+use runtime::Context;
+
+#[win32_derive::dllexport]
+pub fn BASS_Stop(_ctx: &mut Context) -> bool { true }
+
+#[win32_derive::dllexport]
+pub fn BASS_ChannelSetAttributes(_ctx: &mut Context, _handle: u32, _freq: i32, _volume: i32, _pan: i32) -> bool { true }
+
+#[win32_derive::dllexport]
+pub fn BASS_Free(_ctx: &mut Context) -> bool { true }
+
+#[win32_derive::dllexport]
+pub fn BASS_Init(_ctx: &mut Context, _device: i32, _freq: u32, _flags: u32, _win: u32, _clsid: u32) -> bool { true }
+
+#[win32_derive::dllexport]
+pub fn BASS_Start(_ctx: &mut Context) -> bool { true }
+
+#[win32_derive::dllexport]
+pub fn BASS_SetConfig(_ctx: &mut Context, _option: u32, _value: u32) -> bool { true }
+
+#[win32_derive::dllexport]
+pub fn BASS_ChannelStop(_ctx: &mut Context, _handle: u32) -> bool { true }
+
+#[win32_derive::dllexport]
+pub fn BASS_MusicPlayEx(_ctx: &mut Context, _handle: u32, _start: u32, _flags: u32, _restart: bool) -> bool { true }
+
+#[win32_derive::dllexport]
+pub fn BASS_ErrorGetCode(_ctx: &mut Context) -> i32 { 0 }
+
+#[win32_derive::dllexport]
+pub fn BASS_MusicLoad(_ctx: &mut Context, _mem: bool, _file: u32, _offset_low: u32, _offset_high: u32, _length: u32, _flags: u32) -> u32 { 1 }
