+#[win32_derive::dllexport]
+pub fn Release(ctx:&mut Context,this:u32)->u32{
+ let mut map=DEVICES.lock().unwrap();let d=map.get_mut(&this).expect("invalid device Release");d.refs-=1;let refs=d.refs;
+ if refs!=0{return refs}let d=map.remove(&this).unwrap();drop(map);
+ IDirect3DSurface9::destroy_owned(ctx,d.color);IDirect3DSurface9::destroy_owned(ctx,d.depth);
+ host::graphics_call(2,&[d.backend]);IDirect3D9::Release(ctx,d.parent);ctx.memory.write::<u32>(this,0);kernel32::lock().process_heap.free(&mut ctx.memory,this);0
