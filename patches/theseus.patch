+fn rectangle_offset(m: &Mip, format: u32, r: [u32; 4]) -> Option<u32> {
+    let [left, top, right, bottom] = r;
+    let (block, bytes) = match format {
+        21 | 22 => (1, 4),
+        50 => (1, 1),
+        0x31545844 => (4, 8),
+        _ => (4, 16),
+    };
