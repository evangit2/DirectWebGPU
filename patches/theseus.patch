@@ -0,0 +1,162 @@
+use crate::codegen::{CodeGen, get_mem, set_mem};
+
+fn xmm_index(register: iced_x86::Register) -> usize {
+    use iced_x86::Register::*;
+    match register {
+        XMM0 => 0, XMM1 => 1, XMM2 => 2, XMM3 => 3,
+        XMM4 => 4, XMM5 => 5, XMM6 => 6, XMM7 => 7,
+        r => panic!("unsupported XMM register {r:?}"),
+    }
+}
+
+impl<'a> CodeGen<'a> {
+    fn sse_vec_get(&self, instr: &iced_x86::Instruction, n: u32) -> String {
+        use iced_x86::OpKind::*;
+        match instr.op_kind(n) {
+            Register => format!("ctx.cpu.sse.get({})", xmm_index(instr.op_register(n))),
+            Memory => get_mem("[u32;4]".into(), self.gen_addr(instr)),
+            k => panic!("unsupported SSE operand {k:?}"),
+        }
+    }
+
+    fn sse_vec_set(&self, instr: &iced_x86::Instruction, n: u32, expr: String) -> String {
+        use iced_x86::OpKind::*;
+        match instr.op_kind(n) {
+            Register => format!("ctx.cpu.sse.set({}, {expr});", xmm_index(instr.op_register(n))),
+            Memory => set_mem("[u32;4]".into(), self.gen_addr(instr), expr),
+            k => panic!("unsupported SSE destination {k:?}"),
+        }
+    }
+
+    fn sse_scalar_get(&self, instr: &iced_x86::Instruction, n: u32) -> String {
+        use iced_x86::OpKind::*;
+        match instr.op_kind(n) {
+            Register => format!("ctx.cpu.sse.get({})[0]", xmm_index(instr.op_register(n))),
+            Memory => get_mem("u32".into(), self.gen_addr(instr)),
+            k => panic!("unsupported scalar SSE operand {k:?}"),
+        }
+    }
+
+    fn sse_scalar_set(&self, instr: &iced_x86::Instruction, n: u32, expr: String) -> String {
+        use iced_x86::OpKind::*;
+        match instr.op_kind(n) {
+            Register => format!("ctx.cpu.sse.set({}, sse_set_scalar(ctx.cpu.sse.get({}), {expr}));", xmm_index(instr.op_register(n)), xmm_index(instr.op_register(n))),
+            Memory => set_mem("u32".into(), self.gen_addr(instr), expr),
+            k => panic!("unsupported scalar SSE destination {k:?}"),
+        }
+    }
+
+    fn sse_predicate(name: &str) -> Option<u32> {
+        Some(match name {
+            "Cmpps" | "Cmpss" | "Cmpeqps" | "Cmpeqss" => 0,
+            "Cmpltps" | "Cmpltss" => 1,
+            "Cmpleps" | "Cmpless" => 2,
+            "Cmpunordps" | "Cmpunordss" => 3,
+            "Cmpneqps" | "Cmpneqss" => 4,
+            "Cmpnltps" | "Cmpnltss" => 5,
+            "Cmpnleps" | "Cmpnless" => 6,
+            "Cmpordps" | "Cmpordss" => 7,
+            _ => return None,
+        })
+    }
+
+    pub fn codegen_sse(&mut self, instr: &iced_x86::Instruction) -> bool {
+        if !(0..instr.op_count()).any(|n| instr.op_kind(n) == iced_x86::OpKind::Register && instr.op_register(n).is_xmm()) {
+            return false;
+        }
+        let name = format!("{:?}", instr.mnemonic());
+        match name.as_str() {
+            "Movaps" | "Movups" | "Movdqa" | "Movdqu" | "Movntps" => {
+                if name == "Movntps" {
+                    self.line(self.sse_vec_set(instr, 0, self.sse_vec_get(instr, 1)));
+                } else {
+                    self.line(self.sse_vec_set(instr, 0, self.sse_vec_get(instr, 1)));
+                }
+            }
+            "Movss" => {
+                self.line(self.sse_scalar_set(instr, 0, self.sse_scalar_get(instr, 1)));
+            }
+            "Movd" => {
+                use iced_x86::OpKind::*;
+                if instr.op_kind(0) == Register && instr.op_register(0).is_xmm() {
+                    let source = if instr.op_kind(1) == Register && instr.op_register(1).is_xmm() {
+                        format!("ctx.cpu.sse.get({})[0]", xmm_index(instr.op_register(1)))
+                    } else {
+                        self.get_op(instr, 1)
+                    };
+                    self.line(format!("ctx.cpu.sse.set({}, [({source}) as u32, 0, 0, 0]);", xmm_index(instr.op_register(0))));
+                } else {
+                    let source = format!("ctx.cpu.sse.get({})[0]", xmm_index(instr.op_register(1)));
+                    self.line(self.set_op(instr, 0, source));
+                }
+            }
+            "Movlps" | "Movq" => {
+                use iced_x86::OpKind::*;
+                if instr.op_kind(0) == Register && instr.op_kind(1) == Memory {
+                    let dst = format!("ctx.cpu.sse.get({})", xmm_index(instr.op_register(0)));
+                    let value = get_mem("[u32;2]".into(), self.gen_addr(instr));
+                    self.line(format!("ctx.cpu.sse.set({}, sse_set_low2({dst}, {value}));", xmm_index(instr.op_register(0))));
+                } else {
+                    let value = format!("[ctx.cpu.sse.get({})[0], ctx.cpu.sse.get({})[1]]", xmm_index(instr.op_register(1)), xmm_index(instr.op_register(1)));
+                    self.line(set_mem("[u32;2]".into(), self.gen_addr(instr), value));
+                }
+            }
+            "Movhps" => {
+                use iced_x86::OpKind::*;
+                if instr.op_kind(0) == Register && instr.op_kind(1) == Memory {
