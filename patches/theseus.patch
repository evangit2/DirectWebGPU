+//! D3D9 sampled 2D texture COM objects with persistent mip lock storage.
+use super::*;
+pub static mut VTABLE: u32 = 0;
+#[derive(Clone, Debug)]
+struct Mip {
+    width: u32,
+    height: u32,
+    pitch: u32,
+    offset: u32,
+    size: u32,
+    locked: Option<bool>,
+}
+#[derive(Clone)]
+struct Texture {
+    refs: u32,
+    bindings: u32,
+    owner: u32,
+    backend: u32,
+    gpu: u32,
+    data: u32,
+    usage: u32,
+    pool: u32,
+    format: u32,
+    mips: Vec<Mip>,
+    surfaces: Vec<u32>,
+}
+static TEXTURES: LazyLock<Mutex<HashMap<u32, Texture>>> =
+    LazyLock::new(|| Mutex::new(HashMap::new()));
+pub const VTABLE_ENTRIES: [&str; 22] = [
+    "QueryInterface",
+    "AddRef",
+    "Release",
+    "GetDevice",
+    "SetPrivateData",
+    "GetPrivateData",
+    "FreePrivateData",
+    "SetPriority",
+    "GetPriority",
+    "PreLoad",
+    "GetType",
+    "SetLOD",
+    "GetLOD",
+    "GetLevelCount",
+    "SetAutoGenFilterType",
+    "GetAutoGenFilterType",
+    "GenerateMipSubLevels",
+    "GetLevelDesc",
+    "GetSurfaceLevel",
+    "LockRect",
+    "UnlockRect",
+    "AddDirtyRect",
+];
+fn texture(this: u32) -> Texture {
+    TEXTURES
+        .lock()
+        .unwrap()
+        .get(&this)
+        .expect("invalid texture handle")
+        .clone()
