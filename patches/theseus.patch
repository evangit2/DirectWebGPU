+ #[win32_derive::dllexport] pub fn CheckDeviceType(_ctx:&mut Context,_this:u32,index:u32,kind:u32,display:u32,back:u32,_windowed:u32)->u32{if index==0&&kind==1&&display==22&&[21,22,23,24,25,26].contains(&back){D3D_OK}else{D3DERR_NOTAVAILABLE}}
