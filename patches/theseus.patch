+//! Direct3D 8 compatibility frontend backed by the existing D3D9/WebGPU
+//! resource and draw implementation. D3D8 COM layout differs from D3D9, so
+//! these vtables preserve the D3D8 ABI and translate calls explicitly.
+use runtime::Context;
+use std::{collections::HashMap, sync::{LazyLock, Mutex}};
+use crate::{d3d9, kernel32};
+
+const D3D_OK:u32=d3d9::D3D_OK;
+const D3DERR_INVALIDCALL:u32=d3d9::D3DERR_INVALIDCALL;
+const D3DERR_NOTAVAILABLE:u32=d3d9::D3DERR_NOTAVAILABLE;
+const E_NOINTERFACE:u32=0x80004002;
+const E_POINTER:u32=0x80004003;
+const IID_UNKNOWN:[u8;16]=[0,0,0,0,0,0,0,0,0xc0,0,0,0,0,0,0,0x46];
+const IID_D3D8:[u8;16]=[0xda,0xe8,0xd9,0x1d,0x77,0x1c,0x40,0x4d,0xb0,0xcf,0x98,0xfe,0xfd,0xff,0x95,0x12];
+const IID_DEVICE8:[u8;16]=[0xdf,0xe5,0x85,0x73,0xe8,0x8f,0xd5,0x41,0x86,0xb6,0xd7,0xb4,0x85,0x47,0xb6,0xcf];
+
+fn valid(ctx:&Context,p:u32,n:usize)->bool{p>=0x1000&&(p as usize).checked_add(n).is_some_and(|e|e<=ctx.memory.bytes.len())}
+fn overwrite_vtable(ctx:&mut Context,p:u32,vt:u32)->u32{if p!=0{ctx.memory.write::<u32>(p,vt);}p}
+fn fail(ctx:&Context,iface:&str,name:&str)->!{panic!("unsupported API: d3d8!{iface}::{name}; stack_return={:#010x}",ctx.memory.read::<u32>(ctx.cpu.regs.esp))}
+
+pub const VTABLES:[(&str,&[&str]);6]=[
+ ("IDirect3D8",&IDirect3D8::VTABLE_ENTRIES),
+ ("IDirect3DDevice8",&IDirect3DDevice8::VTABLE_ENTRIES),
+ ("IDirect3DTexture8",&IDirect3DTexture8::VTABLE_ENTRIES),
+ ("IDirect3DSurface8",&IDirect3DSurface8::VTABLE_ENTRIES),
+ ("IDirect3DVertexBuffer8",&IDirect3DVertexBuffer8::VTABLE_ENTRIES),
+ ("IDirect3DIndexBuffer8",&IDirect3DIndexBuffer8::VTABLE_ENTRIES),
+];
+
+#[win32_derive::dllexport]
+pub fn Direct3DCreate8(ctx:&mut Context,version:u32)->u32{
+ if version!=120&&version!=220{return 0}
+ let p=d3d9::Direct3DCreate9(ctx,32);if p==0{return 0}
+ overwrite_vtable(ctx,p,unsafe{IDirect3D8::VTABLE});
+ log::info!("D3D8_CREATE8 sdk={version} object={p:#010x}");p
+}
