+        assert_eq!(lock_range(&b, 2, 0, 0), Some((2, 12, false)));
+        assert!(lock_range(&b, u32::MAX, 4, 0).is_none());
+        assert!(lock_range(&b, 12, 4, 0).is_none());
+        assert!(lock_range(&b, 0, 14, 0x10).is_none());
+        assert!(lock_range(&b, 0, 14, 0x3000).is_none());
+        assert!(lock_range(&b, 0, 14, 0x2000).is_some());
+        b.usage = 0;
+        assert!(lock_range(&b, 0, 14, 0x2000).is_none());
+        assert!(lock_range(&b, 0, 14, 0x10).is_some());
+        b.locked = Some((0, 4, false));
+        assert!(lock_range(&b, 4, 4, 0).is_none());
+    }
+    #[test]
+    fn com_description_lock_pointer_and_readonly_unlock() {
+        let mut ctx = runtime::Context {
+            cpu: Default::default(),
+            thread_handle: 1,
+            thread_id: 1,
+            memory: runtime::Memory::leak_new(0x10000),
+            blocks: &[(
+                runtime::RETURN_FROM_X86_ADDR32,
+                runtime::Context::return_from_x86,
+            )],
+            cache: Default::default(),
+            recent: [runtime::Context::return_from_x86; 4],
+        };
+        let this = 0x3000;
+        BUFFERS.lock().unwrap().insert(
+            this,
+            Buffer {
+                refs: 1,
+                bindings: 0,
+                owner: 0,
+                backend: 0,
+                gpu: 0,
+                data: 0x4000,
+                size: 14,
+                usage: 0,
+                pool: 1,
+                kind: 7,
+                format: 101,
+                fvf: 0,
+                locked: None,
+            },
+        );
+        assert_eq!(GetDesc(&mut ctx, this, 0x1100), D3D_OK);
+        assert_eq!(
+            (0..5)
+                .map(|i| ctx.memory.read::<u32>(0x1100 + i * 4))
+                .collect::<Vec<_>>(),
+            vec![101, 7, 0, 1, 14]
+        );
+        ctx.cpu.regs.esp = 0xf000;
+        ctx.call32_x86(runtime::Cont(Lock_stdcall), vec![this, 2, 0, 0x1200, 0x10]);
+        assert_eq!(ctx.cpu.regs.esp, 0xf000);
+        assert_eq!(ctx.cpu.regs.eax, 0);
+        assert_eq!(ctx.memory.read::<u32>(0x1200), 0x4002);
+        assert_eq!(Unlock(&mut ctx, this), D3D_OK);
+        assert_eq!(Unlock(&mut ctx, this), D3DERR_INVALIDCALL);
+        ctx.memory.bytes[0x1300..0x1310].copy_from_slice(&[
+            0x5e, 0xd6, 0x9d, 0x7c, 0xf7, 0xd3, 0x29, 0x45, 0xac, 0xee, 0x78, 0x58, 0x30, 0xac,
+            0xde, 0x35,
+        ]);
+        assert_eq!(QueryInterface(&mut ctx, this, 0x1300, 0x1200), D3D_OK);
+        assert_eq!(ctx.memory.read::<u32>(0x1200), this);
+        assert_eq!(buffer(this).refs, 2);
+        BUFFERS.lock().unwrap().remove(&this);
+    }
+}
+pub(super) fn draw_handle(this:u32)->Option<u32>{let b=buffer(this);if b.locked.is_some(){None}else{Some(b.gpu)}}
+pub(super) fn index_range(ctx:&Context,this:u32,first:u32,count:u32,base:i32,min:u32,num:u32)->Option<u32>{
+ let b=buffer(this);if b.kind!=7||b.locked.is_some(){return None}let width=if b.format==101{2}else{4};if (first as u64+count as u64)*width as u64>b.size as u64{return None}let mut max=0;
+ for i in 0..count{let at=b.data+(first+i)*width;let index=if width==2{ctx.memory.read::<u16>(at)as u32}else{ctx.memory.read::<u32>(at)};if index<min||index as u64>=min as u64+num as u64{return None}let vertex=index as i64+base as i64;if vertex<0||vertex>u32::MAX as i64{return None}max=max.max(vertex as u32)}Some(max)
+}
diff --git a/win32/winapi/src/d3d9/constants.rs b/win32/winapi/src/d3d9/constants.rs
