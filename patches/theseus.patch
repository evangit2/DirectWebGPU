+ pub const VTABLE_ENTRIES:[&str;16]=["QueryInterface","AddRef","Release","RegisterSoftwareDevice","GetAdapterCount","GetAdapterIdentifier","GetAdapterModeCount","EnumAdapterModes","GetAdapterDisplayMode","CheckDeviceType","CheckDeviceFormat","CheckDeviceMultiSampleType","CheckDepthStencilMatch","GetDeviceCaps","GetAdapterMonitor","CreateDevice"];
