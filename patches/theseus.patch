+#[win32_derive::dllexport]
+pub fn GetDevice(ctx: &mut Context, this: u32, out: u32) -> u32 {
+    let b = buffer(this);
+    if !valid(ctx, out, 4) {
+        return D3DERR_INVALIDCALL;
+    }
+    IDirect3DDevice9::AddRef(ctx, b.owner);
+    ctx.memory.write::<u32>(out, b.owner);
+    D3D_OK
+}
+#[win32_derive::dllexport]
+pub fn GetType(_ctx: &mut Context, this: u32) -> u32 {
+    buffer(this).kind
+}
+#[win32_derive::dllexport]
+pub fn GetDesc(ctx: &mut Context, this: u32, out: u32) -> u32 {
+    let b = buffer(this);
+    let values = [b.format, b.kind, b.usage, b.pool, b.size, b.fvf];
+    let n = if b.kind == 6 { 6 } else { 5 };
+    if !valid(ctx, out, n * 4) {
+        return D3DERR_INVALIDCALL;
+    }
+    for i in 0..n {
+        ctx.memory.write::<u32>(out + i as u32 * 4, values[i]);
+    }
+    D3D_OK
+}
+fn lock_range(b: &Buffer, offset: u32, size: u32, flags: u32) -> Option<(u32, u32, bool)> {
+    if b.locked.is_some() || flags & !0x3010 != 0 || offset >= b.size {
+        return None;
+    }
+    let count = if size == 0 { b.size - offset } else { size };
+    if count > b.size - offset {
+        return None;
+    }
+    let readonly = flags & 0x10 != 0;
+    let discard = flags & 0x2000 != 0;
+    let nooverwrite = flags & 0x1000 != 0;
+    if (readonly && (b.usage & 8 != 0 || discard || nooverwrite))
+        || ((discard || nooverwrite) && b.usage & 0x200 == 0)
+        || (discard && nooverwrite)
+    {
+        return None;
+    }
+    Some((offset, count, readonly))
+}
+#[win32_derive::dllexport]
+pub fn Lock(ctx: &mut Context, this: u32, offset: u32, size: u32, out: u32, flags: u32) -> u32 {
+    if !valid(ctx, out, 4) {
+        return D3DERR_INVALIDCALL;
+    }
+    ctx.memory.write::<u32>(out, 0);
+    let mut map = BUFFERS.lock().unwrap();
+    let b = map.get_mut(&this).expect("invalid buffer Lock");
+    let Some(range) = lock_range(b, offset, size, flags) else {
+        return D3DERR_INVALIDCALL;
+    };
+    // DISCARD invalidates all previous contents. Zeroing is one permitted value
+    // for undefined bytes; upload the full allocation when it is unlocked.
+    if flags & 0x2000 != 0 {
+        ctx.memory.bytes[b.data as usize..(b.data + ((b.size + 3) & !3)) as usize].fill(0);
+        b.locked = Some((0, b.size, false));
+    } else {
+        b.locked = Some(range)
+    }
+    ctx.memory.write::<u32>(out, b.data + offset);
+    D3D_OK
+}
+#[win32_derive::dllexport]
+pub fn Unlock(ctx: &mut Context, this: u32) -> u32 {
+    let b = buffer(this);
+    let Some((offset, count, readonly)) = b.locked else {
+        return D3DERR_INVALIDCALL;
+    };
+    if !readonly {
+        let start = offset & !3;
+        let end = (offset + count + 3) & !3;
+        let pointer = ctx.memory.bytes[b.data as usize + start as usize..].as_ptr() as usize as u32;
+        let result = host::graphics_call(6, &[b.backend, b.gpu, start, pointer, end - start]);
+        if result != 1 {
+            return result;
+        }
+    }
+    BUFFERS.lock().unwrap().get_mut(&this).unwrap().locked = None;
+    D3D_OK
+}
