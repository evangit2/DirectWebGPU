+#[cfg(test)]
+mod bit_tests {
+    use super::*;
+    #[test]
+    fn memory_bitstrings_and_carry() {
+        let mut memory = Memory::leak_new(0x2000);
+        let mut flags = Flags::ZF;
+        bit_memory(&mut memory, &mut flags, 0x1020, -1, 32, 1);
+        assert!(!flags.contains(Flags::CF));
+        assert!(flags.contains(Flags::ZF));
+        assert_eq!(memory.read::<u32>(0x101c), 0x80000000);
+        bit_memory(&mut memory, &mut flags, 0x1020, -1, 32, 2);
+        assert!(flags.contains(Flags::CF));
+        assert_eq!(memory.read::<u32>(0x101c), 0);
+        bit_memory(&mut memory, &mut flags, 0x1020, 63, 32, 3);
+        assert_eq!(memory.read::<u32>(0x1024), 0x80000000);
+        bit_memory(&mut memory, &mut flags, 0x1020, 63, 32, 0);
+        assert!(flags.contains(Flags::CF));
+        assert_eq!(memory.read::<u32>(0x1024), 0x80000000);
+        bit_memory(&mut memory, &mut flags, 0x1040, -1, 16, 1);
+        assert_eq!(memory.read::<u16>(0x103e), 0x8000);
+        assert_eq!(bit_word(0, 33, 32, 1, &mut flags), 2);
+        assert_eq!(bit_word(0, 17, 16, 1, &mut flags), 2);
+        assert_eq!(bit_address(0xffff_fffc, 32, 32), 0);
+    }
 }
