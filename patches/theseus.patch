+        .collect();
+    SHADERS.lock().unwrap().insert(
+        this,
+        Shader {
+            refs: 1,
+            bindings: 0,
+            owner,
+            backend: 1,
+            gpu: 1,
+            stage,
+            bytes: bytes.into(),
+        },
+    );
+    this
+}
