+    /// Resolve browser pointer-lock motion at the point where Win32 consumes
+    /// it. This keeps a preceding SetCursorPos ordered with the next delta.
+    pub fn resolve_relative(&self, mouse: &host::RelativeMouseMessage) -> host::MouseMessage {
+        host::MouseMessage {
+            x: self.x.saturating_add(mouse.dx).max(0) as u32,
+            y: self.y.saturating_add(mouse.dy).max(0) as u32,
+            button: host::MouseButton::empty(),
+            buttons: mouse.buttons,
+        }
+    }
+}
