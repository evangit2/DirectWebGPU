+// FSAVE/FRSTOR image: Intel SDM volume 1, figure 8-9. Arithmetic remains f64.
+fn encode80(v: f64) -> [u8; 10] {
+    let bits = v.to_bits();
+    let sign = ((bits >> 63) as u16) << 15;
+    let exp = ((bits >> 52) & 0x7ff) as i32;
+    let frac = bits & 0x000fffffffffffff;
+    let (mant, e) = if exp == 0 {
+        if frac == 0 {
+            (0, 0)
+        } else {
+            let n = 63 - frac.leading_zeros();
+            (frac << (63 - n), (n as i32 - 1074 + 16383) as u16)
+        }
+    } else if exp == 2047 {
+        ((1u64 << 63) | (frac << 11), 0x7fff)
+    } else {
+        (((1u64 << 52) | frac) << 11, (exp - 1023 + 16383) as u16)
+    };
+    let mut out = [0; 10];
+    out[..8].copy_from_slice(&mant.to_le_bytes());
+    out[8..].copy_from_slice(&(sign | e).to_le_bytes());
+    out
+}
+fn decode80(v: [u8; 10]) -> f64 {
+    let mant = u64::from_le_bytes(v[..8].try_into().unwrap());
+    let se = u16::from_le_bytes(v[8..].try_into().unwrap());
+    let e = se & 0x7fff;
+    let sign = u64::from(se >> 15) << 63;
+    let value = if e == 0 && mant == 0 {
+        f64::from_bits(sign)
+    } else if e == 0x7fff {
+        assert!(
+            mant >> 63 == 1 && mant & 2047 == 0,
+            "unsupported extended x87 NaN encoding"
+        );
+        f64::from_bits(sign | 0x7ff0000000000000 | ((mant & 0x7fffffffffffffff) >> 11))
+    } else {
+        assert!(
+            e != 0 && mant >> 63 == 1,
+            "unsupported extended x87 denormal/unnormal"
+        );
+        let power = i32::from(e) - 16383;
+        assert!(
+            (-1074..=1023).contains(&power),
+            "unsupported extended x87 exponent"
+        );
+        let magnitude = (mant as f64 / 9223372036854775808.0) * 2.0f64.powi(power.max(-1022));
+        let magnitude = if power < -1022 {
+            magnitude * 2.0f64.powi(power + 1022)
+        } else {
+            magnitude
+        };
+        f64::from_bits(magnitude.to_bits() | sign)
+    };
+    assert_eq!(encode80(value), v, "unsupported x87 precision beyond f64");
+    value
+}
+impl FPU {
+    pub fn save_image32(&self) -> [u8; 108] {
+        let mut b = [0u8; 108];
+        b[0..2].copy_from_slice(&self.control.to_le_bytes());
+        b[4..6].copy_from_slice(&self.status().to_le_bytes());
+        let mut tags = 0u16;
+        for i in 0..8 {
+            let v = self.st[i];
+            let tag = if i < self.st_top {
+                3
+            } else if v == 0.0 {
+                1
+            } else if !v.is_finite() {
+                2
+            } else {
+                0
+            };
+            tags |= tag << (2 * i);
+        }
+        b[8..10].copy_from_slice(&tags.to_le_bytes());
+        b[12..16].copy_from_slice(&self.instruction.0.to_le_bytes());
+        b[16..18].copy_from_slice(&self.instruction.1.to_le_bytes());
+        b[18..20].copy_from_slice(&self.instruction.2.to_le_bytes());
+        b[20..24].copy_from_slice(&self.operand.0.to_le_bytes());
+        b[24..26].copy_from_slice(&self.operand.1.to_le_bytes());
+        for i in 0..8 {
+            b[28 + i * 10..38 + i * 10].copy_from_slice(&encode80(self.st[(self.st_top + i) & 7]));
+        }
+        b
+    }
+    pub fn restore_image32(&mut self, b: [u8; 108]) {
+        let word = |o| u16::from_le_bytes(b[o..o + 2].try_into().unwrap());
+        let dword = |o| u32::from_le_bytes(b[o..o + 4].try_into().unwrap());
+        let status = word(4);
+        let tags = word(8);
+        let top = usize::from((status >> 11) & 7);
+        let mut f = Self::default();
+        f.control = word(0);
+        assert_eq!(
+            status & !f.control & 0x3f,
+            0,
+            "unsupported restored unmasked x87 exception"
+        );
+        f.st_top = if tags == 0xffff && top == 0 { 8 } else { top };
+        for i in 0..8 {
+            assert_eq!(
+                (tags >> (2 * i)) & 3 == 3,
+                i < f.st_top,
+                "unsupported noncontiguous restored x87 stack"
+            );
+        }
+        f.invalid = status & 1 != 0;
+        f.unordered = status & 0x4500 == 0x4500;
+        f.cmp = if status & 0x4000 != 0 {
+            std::cmp::Ordering::Equal
+        } else if status & 0x100 != 0 {
+            std::cmp::Ordering::Less
+        } else {
+            std::cmp::Ordering::Greater
+        };
+        f.status_extra = status & !0x7901;
+        f.instruction = (dword(12), word(16), word(18) & 0x7ff);
+        f.operand = (dword(20), word(24));
+        for i in 0..8 {
+            f.st[(top + i) & 7] = decode80(b[28 + i * 10..38 + i * 10].try_into().unwrap());
+        }
+        *self = f;
+    }
+}
+#[cfg(test)]
+mod state_tests {
+    use super::*;
+    #[test]
+    fn extended_encoding_and_save_layout() {
+        for bits in [
+            0,
+            1,
+            0x8000000000000000,
+            0x3ff0000000000000,
+            0x4008000000000000,
+            0x7fefffffffffffff,
+            0x0010000000000000,
+            0x000fffffffffffff,
+            0x7ff0000000000000,
+            0x7ff8000000000001,
+        ] {
+            assert_eq!(decode80(encode80(f64::from_bits(bits))).to_bits(), bits);
+        }
+        assert_eq!(encode80(1.0), [0, 0, 0, 0, 0, 0, 0, 128, 255, 63]);
+        let mut f = FPU::default();
+        assert_eq!(f.status(), 0);
+        f.push(3.0);
+        f.push(-0.0);
+        f.compare(1.0, 2.0, true);
+        f.instruction = (0x421000, 0x1b, 0x123);
+        f.operand = (0x12000, 0x23);
+        let image = f.save_image32();
+        assert_eq!(u16::from_le_bytes(image[8..10].try_into().unwrap()), 0x1fff);
+        assert_eq!(&image[28..38], &encode80(-0.0));
+        assert_eq!(&image[38..48], &encode80(3.0));
+        let mut g = FPU::default();
+        g.restore_image32(image);
+        assert_eq!(g.save_image32(), image);
+        assert_eq!(g.get(1), 3.0);
+    }
+}
