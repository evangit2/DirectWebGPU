+pub fn bit_address(base: u32, index: i32, width: u32) -> u32 {
+    let shift = match width {
+        16 => 4,
+        32 => 5,
+        _ => panic!("invalid bit width"),
+    };
+    base.wrapping_add((index >> shift).wrapping_mul((width / 8) as i32) as u32)
 }
