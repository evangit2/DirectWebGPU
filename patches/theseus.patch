@@ -0,0 +1,163 @@
+//! D3D9 shader register state. Float/int registers preserve all input bits.
+use super::*;
+#[derive(Clone, Copy)]
+pub enum Kind {
+    Float,
+    Int,
+    Bool,
+}
+#[derive(Default)]
+pub struct Registers {
+    vertex: Stage,
+    pixel: Stage,
+}
+struct Stage {
+    floats: [u32; 1024],
+    ints: [u32; 64],
+    bools: [u32; 16],
+}
+impl Default for Stage {
+    fn default() -> Self {
+        Self {
+            floats: [0; 1024],
+            ints: [0; 64],
+            bools: [0; 16],
+        }
+    }
+}
+impl Registers {
+    pub fn transfer(
+        &mut self,
+        ctx: &mut Context,
+        pixel: bool,
+        kind: Kind,
+        start: u32,
+        pointer: u32,
+        count: u32,
+        write: bool,
+    ) -> u32 {
+        let stage = if pixel {
+            &mut self.pixel
+        } else {
+            &mut self.vertex
+        };
+        let (words, width): (&mut [u32], usize) = match kind {
+            Kind::Float => (
+                if pixel {
+                    &mut stage.floats[..128]
+                } else {
+                    &mut stage.floats[..]
+                },
+                4,
+            ),
+            Kind::Int => (&mut stage.ints, 4),
+            Kind::Bool => (&mut stage.bools, 1),
+        };
+        let capacity = (words.len() / width) as u32;
+        if start > capacity || count > capacity - start {
+            return D3DERR_INVALIDCALL;
+        }
+        if count == 0 {
+            return D3D_OK;
+        }
+        let n = count as usize * width;
+        if !valid(ctx, pointer, n * 4) {
+            return D3DERR_INVALIDCALL;
+        }
+        let registers = &mut words[start as usize * width..start as usize * width + n];
+        for (i, word) in registers.iter_mut().enumerate() {
+            let address = pointer + i as u32 * 4;
+            if write {
+                let value = ctx.memory.read::<u32>(address);
+                *word = if matches!(kind, Kind::Bool) {
+                    u32::from(value != 0)
+                } else {
+                    value
+                };
+            } else {
+                ctx.memory.write::<u32>(address, *word)
+            }
+        }
+        D3D_OK
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn registers_preserve_bits_boundaries_and_stage_isolation() {
+        let mut ctx = Context {
+            cpu: Default::default(),
+            thread_handle: 1,
+            thread_id: 1,
+            memory: runtime::Memory::leak_new(0x3000),
+            blocks: &[],
+            cache: Default::default(),
+            recent: [Context::return_from_x86; 4],
+        };
+        let mut state = Registers::default();
+        let bits = [0x7fc12345, 0x80000000, 0x7f800000, 0xff800000];
+        for (i, value) in bits.into_iter().enumerate() {
+            ctx.memory.write::<u32>(0x1000 + i as u32 * 4, value)
+        }
+        assert_eq!(
+            state.transfer(&mut ctx, false, Kind::Float, 255, 0x1000, 1, true),
+            D3D_OK
+        );
+        assert_eq!(
+            state.transfer(&mut ctx, false, Kind::Float, 255, 0x1100, 1, false),
+            D3D_OK
+        );
+        assert_eq!(
+            &ctx.memory.bytes[0x1000..0x1010],
+            &ctx.memory.bytes[0x1100..0x1110]
+        );
+        assert_eq!(
+            state.transfer(&mut ctx, true, Kind::Float, 31, 0x1100, 1, false),
+            D3D_OK
+        );
+        assert!(ctx.memory.bytes[0x1100..0x1110].iter().all(|b| *b == 0));
+        assert_eq!(
+            state.transfer(&mut ctx, false, Kind::Float, 255, 0x1000, 2, true),
+            D3DERR_INVALIDCALL
+        );
+        assert_eq!(
+            state.transfer(&mut ctx, false, Kind::Float, u32::MAX, 0, 1, true),
+            D3DERR_INVALIDCALL
+        );
+        assert_eq!(
+            state.transfer(&mut ctx, false, Kind::Float, 255, 0x2ff4, 1, true),
+            D3DERR_INVALIDCALL
+        );
+        assert_eq!(
+            state.transfer(&mut ctx, false, Kind::Float, 255, 0x1100, 1, false),
+            D3D_OK
+        );
+        assert_eq!(ctx.memory.read::<u32>(0x1100), bits[0]);
+        assert_eq!(
+            state.transfer(&mut ctx, true, Kind::Int, 15, 0x1000, 1, true),
+            D3D_OK
+        );
+        assert_eq!(
+            state.transfer(&mut ctx, true, Kind::Int, 15, 0x1100, 1, false),
+            D3D_OK
+        );
+        assert_eq!(ctx.memory.read::<u32>(0x1100), bits[0]);
+        ctx.memory.write::<u32>(0x1000, 0);
+        ctx.memory.write::<u32>(0x1004, 0xffffffff);
+        assert_eq!(
+            state.transfer(&mut ctx, true, Kind::Bool, 14, 0x1000, 2, true),
+            D3D_OK
+        );
+        assert_eq!(
+            state.transfer(&mut ctx, true, Kind::Bool, 14, 0x1100, 2, false),
+            D3D_OK
+        );
+        assert_eq!(ctx.memory.read::<u32>(0x1100), 0);
+        assert_eq!(ctx.memory.read::<u32>(0x1104), 1);
+        assert_eq!(
+            state.transfer(&mut ctx, true, Kind::Bool, 16, 0, 0, true),
+            D3D_OK
+        );
+    }
+}
