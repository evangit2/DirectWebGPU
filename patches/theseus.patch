+// The Windows compatibility runtime executes guest code at virtual CPL3/IOPL0.
+pub fn pushfd(ctx: &mut Context) {
+    ctx.push32((ctx.cpu.flags.bits() & 0x00244dd5) | 0x202);
+}
+pub fn popfd(ctx: &mut Context) {
+    let bits = ctx.pop32();
+    assert_eq!(bits & 0x100, 0, "unsupported x86 single-step flag");
+    ctx.cpu.flags = Flags::from_bits_retain((bits & 0x00244dd5) | 0x202);
+}
+#[cfg(test)]
+mod flag_stack_tests {
+    use super::*;
+    #[test]
+    fn cpuid_flag_toggle_and_stack() {
+        let mut ctx = Context {
+            cpu: Default::default(),
+            thread_handle: 1,
+            thread_id: 1,
+            memory: crate::Memory::leak_new(0x3000),
+            blocks: &[],
+            cache: Default::default(),
+            recent: [Context::return_from_x86; 4],
+        };
+        ctx.cpu.regs.esp = 0x2000;
+        ctx.cpu.flags = Flags::CF | Flags::OF;
+        pushfd(&mut ctx);
+        assert_eq!(ctx.cpu.regs.esp, 0x1ffc);
+        let original = ctx.pop32();
+        assert_eq!(original, 0xa03);
+        ctx.push32(original ^ Flags::ID.bits());
+        popfd(&mut ctx);
+        pushfd(&mut ctx);
+        assert_eq!(ctx.pop32() ^ original, Flags::ID.bits());
+        ctx.push32(0x3000);
+        popfd(&mut ctx);
+        pushfd(&mut ctx);
+        assert_eq!(ctx.pop32(), 0x202);
+        assert_eq!(ctx.cpu.regs.esp, 0x2000);
+    }
+}
