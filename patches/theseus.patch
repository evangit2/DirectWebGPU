+#[win32_derive::dllexport]
+pub fn EnumDisplaySettingsA(ctx: &mut runtime::Context, name: crate::Ptr<u8>, index: u32, mode: crate::Ptr<u8>) -> bool {
+    if name.addr != 0 { panic!("named display enumeration is unsupported"); }
+    if index != 0 && index != 0xffff_ffff && index != 0xffff_fffe { return false; }
+    let addr = mode.addr as usize;
+    if addr < 0x1000 || addr.checked_add(124).is_none_or(|end| end > ctx.memory.bytes.len()) { return false; }
