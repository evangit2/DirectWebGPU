+#[win32_derive::dllexport]
+pub fn GetSurfaceLevel(ctx: &mut Context, this: u32, level: u32, out: u32) -> u32 {
+    if !valid(ctx, out, 4) {
+        return D3DERR_INVALIDCALL;
+    }
+    ctx.memory.write::<u32>(out, 0);
+    let t = texture(this);
+    let Some(m) = t.mips.get(level as usize) else {
+        return D3DERR_INVALIDCALL;
+    };
+    let mut surface = t.surfaces[level as usize];
+    if surface == 0 {
+        surface = IDirect3DSurface9::create_texture(
+            ctx,
+            t.owner,
+            this,
+            level,
+            [t.format, 1, t.usage, t.pool, 0, 0, m.width, m.height],
+        );
+        if surface == 0 {
+            return 0x8007000e;
+        }
+        TEXTURES.lock().unwrap().get_mut(&this).unwrap().surfaces[level as usize] = surface;
+    }
+    IDirect3DSurface9::AddRef(ctx, surface);
+    ctx.memory.write::<u32>(out, surface);
+    D3D_OK
+}
