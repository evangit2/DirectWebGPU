+//! Direct3D 9 asynchronous event-query COM object and WebGPU fence bridge.
+use super::*;
+use std::sync::atomic::{AtomicU32, Ordering};
+
+const S_FALSE: u32 = 1;
+const E_OUTOFMEMORY: u32 = 0x8007000e;
+const D3DQUERYTYPE_EVENT: u32 = 8;
+const D3DISSUE_END: u32 = 1;
+const D3DGETDATA_FLUSH: u32 = 1;
+const IID_QUERY: [u8; 16] = [
+    0x60, 0x14, 0x77, 0xd9, 0x95, 0xa6, 0x26, 0x4f,
+    0xbb, 0xd3, 0x27, 0xb8, 0x40, 0xb5, 0x41, 0xcc,
+];
+
+#[derive(Clone)]
+struct Query {
+    refs: u32,
+    device: u32,
+    backend: u32,
+    kind: u32,
+    issued: bool,
+}
+
+static QUERIES: LazyLock<Mutex<HashMap<u32, Query>>> =
+    LazyLock::new(|| Mutex::new(HashMap::new()));
+
+pub const VTABLE_ENTRIES: [&str; 8] = [
+    "QueryInterface",
+    "AddRef",
+    "Release",
+    "GetDevice",
+    "GetType",
+    "GetDataSize",
+    "Issue",
+    "GetData",
+];
+
+fn query(this: u32) -> Query {
+    QUERIES.lock().unwrap().get(&this)
+        .expect("invalid/released IDirect3DQuery9").clone()
+}
+
+fn completion(ctx: &Context, this: u32) -> &AtomicU32 {
+    debug_assert!(valid(ctx, this + 4, 4));
+    let pointer = ctx.memory.bytes.as_ptr().wrapping_add((this + 4) as usize) as *mut u32;
+    // The COM allocation is four-byte aligned and guest memory is leaked for
+    // the Context lifetime, so the shared atomic remains aligned and stable.
+    unsafe { AtomicU32::from_ptr(pointer) }
+}
+
+pub(super) fn create(ctx: &mut Context, owner: u32, kind: u32, out: u32) -> u32 {
+    let owner_state = device(owner);
+    if kind != D3DQUERYTYPE_EVENT { return D3DERR_NOTAVAILABLE; }
+    if out == 0 { return D3D_OK; }
+    if !valid(ctx, out, 4) { return D3DERR_INVALIDCALL; }
+    ctx.memory.write::<u32>(out, 0);
+    let vtable = unsafe { crate::d3d9::IDirect3DQuery9::VTABLE };
+    assert!(valid(ctx, vtable, VTABLE_ENTRIES.len() * 4), "query vtable missing");
+    // The second word is an atomic completion flag written by the GPU worker.
+    let this = kernel32::lock().process_heap.alloc(&mut ctx.memory, 8);
+    if this == 0 { return E_OUTOFMEMORY; }
+    ctx.memory.write::<u32>(this, vtable);
+    completion(ctx, this).store(1, Ordering::Release);
+    IDirect3DDevice9::AddRef(ctx, owner);
+    QUERIES.lock().unwrap().insert(this, Query {
+        refs: 1,
+        device: owner,
+        backend: owner_state.backend,
+        kind,
+        issued: false,
+    });
+    ctx.memory.write::<u32>(out, this);
+    D3D_OK
+}
+
+#[win32_derive::dllexport]
+pub fn QueryInterface(ctx: &mut Context, this: u32, iid: u32, out: u32) -> u32 {
+    query(this);
+    if !valid(ctx, out, 4) { return E_POINTER; }
+    ctx.memory.write::<u32>(out, 0);
+    if !valid(ctx, iid, 16) { return E_POINTER; }
+    let id = &ctx.memory.bytes[iid as usize..iid as usize + 16];
+    if id != IID_UNKNOWN && id != IID_QUERY { return E_NOINTERFACE; }
+    AddRef(ctx, this);
+    ctx.memory.write::<u32>(out, this);
+    D3D_OK
+}
+
+#[win32_derive::dllexport]
+pub fn AddRef(_ctx: &mut Context, this: u32) -> u32 {
+    let mut queries = QUERIES.lock().unwrap();
+    let query = queries.get_mut(&this).expect("invalid query AddRef");
+    query.refs = query.refs.checked_add(1).expect("query ref overflow");
+    query.refs
+}
+
+#[win32_derive::dllexport]
+pub fn Release(ctx: &mut Context, this: u32) -> u32 {
+    let removed = {
+        let mut queries = QUERIES.lock().unwrap();
+        let query = queries.get_mut(&this).expect("invalid query Release");
+        query.refs -= 1;
+        if query.refs != 0 { return query.refs; }
+        queries.remove(&this).unwrap()
+    };
+    // A pending browser marker writes to this+4. Drain it before recycling the
+    // guest allocation so the callback cannot corrupt a later COM object.
+    if removed.issued && completion(ctx, this).load(Ordering::Acquire) == 0 {
+        host::graphics_call(18, &[removed.backend, this + 4]);
+    }
+    IDirect3DDevice9::Release(ctx, removed.device);
+    completion(ctx, this).store(0, Ordering::Release);
+    ctx.memory.write::<u32>(this, 0);
+    kernel32::lock().process_heap.free(&mut ctx.memory, this);
+    0
+}
+
+#[win32_derive::dllexport]
+pub fn GetDevice(ctx: &mut Context, this: u32, out: u32) -> u32 {
+    let query = query(this);
+    if !valid(ctx, out, 4) { return D3DERR_INVALIDCALL; }
+    IDirect3DDevice9::AddRef(ctx, query.device);
+    ctx.memory.write::<u32>(out, query.device);
+    D3D_OK
+}
+
+#[win32_derive::dllexport]
+pub fn GetType(_ctx: &mut Context, this: u32) -> u32 { query(this).kind }
+
+#[win32_derive::dllexport]
+pub fn GetDataSize(_ctx: &mut Context, this: u32) -> u32 {
+    query(this);
+    4
+}
+
+#[win32_derive::dllexport]
+pub fn Issue(ctx: &mut Context, this: u32, flags: u32) -> u32 {
+    let current = query(this);
+    if flags != D3DISSUE_END || current.issued && completion(ctx, this).load(Ordering::Acquire) == 0 {
+        return D3DERR_INVALIDCALL;
+    }
+    completion(ctx, this).store(0, Ordering::Release);
+    QUERIES.lock().unwrap().get_mut(&this).unwrap().issued = true;
+    host::graphics_notify(17, &[current.backend, this + 4]);
+    D3D_OK
+}
+
+#[win32_derive::dllexport]
+pub fn GetData(ctx: &mut Context, this: u32, data: u32, size: u32, flags: u32) -> u32 {
+    let current = query(this);
+    if flags > D3DGETDATA_FLUSH || !matches!(size, 0 | 4) || size != 0 && !valid(ctx, data, 4) {
+        return D3DERR_INVALIDCALL;
+    }
+    if completion(ctx, this).load(Ordering::Acquire) == 0 && flags == D3DGETDATA_FLUSH {
+        let result = host::graphics_call(18, &[current.backend, this + 4]);
+        if result != 1 { return result; }
+    }
+    if completion(ctx, this).load(Ordering::Acquire) == 0 { return S_FALSE; }
+    if size == 4 { ctx.memory.write::<u32>(data, 1); }
+    D3D_OK
+}
