+#[cfg(test)]
+mod parity_tests {
+    use super::*;
+    fn taken(ctx: &mut Context) -> Cont {
+        ctx.cpu.regs.eax = 1;
+        Cont(taken)
+    }
+    fn skipped(ctx: &mut Context) -> Cont {
+        ctx.cpu.regs.eax = 0;
+        Cont(skipped)
+    }
+    #[test]
+    fn test_low_byte_parity_branches() {
+        let mut ctx = Context {
+            cpu: Default::default(),
+            thread_handle: 1,
+            thread_id: 1,
+            memory: crate::Memory::leak_new(4096),
+            blocks: &[],
+            cache: Default::default(),
+            recent: [skipped; 4],
+        };
+        for bits in 0u32..=511 {
+            crate::and(bits, 0xffffffff, &mut ctx.cpu.flags);
+            let even = (bits as u8).count_ones() % 2 == 0;
+            let flags = ctx.cpu.flags.bits();
+            ctx.jp(Cont(skipped), Cont(taken)).0(&mut ctx);
+            assert_eq!(ctx.cpu.regs.eax, u32::from(even));
+            ctx.jnp(Cont(skipped), Cont(taken)).0(&mut ctx);
+            assert_eq!(ctx.cpu.regs.eax, u32::from(!even));
+            assert_eq!(ctx.cpu.flags.bits(), flags);
+        }
