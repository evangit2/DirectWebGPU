+#[cfg(test)]
+mod realloc_tests {
+    use super::*;
+    #[test]
+    fn preserve_grow_shrink_and_failure() {
+        let mut mem = Memory::leak_new(0x4000);
+        let heap = Heap::new(0x1000, 0x1000);
+        let p = heap.alloc(&mut mem, 4);
+        mem.write::<u32>(p, 0xdeadbeef);
+        let q = heap.realloc(&mut mem, p, 12, true).unwrap();
+        assert_eq!(mem.read::<u32>(q), 0xdeadbeef);
+        assert_eq!(&mem.bytes[q as usize+4..q as usize+12], &[0;8]);
+        assert_eq!(heap.realloc(&mut mem, q, 0x2000, false), None);
+        assert_eq!(mem.read::<u32>(q), 0xdeadbeef);
+        let t = heap.realloc(&mut mem, q, 2, false).unwrap();
+        assert_eq!(mem.read::<u16>(t), 0xbeef);
+        assert_eq!(heap.realloc(&mut mem, t, u32::MAX, false), None);
+    }
+}
