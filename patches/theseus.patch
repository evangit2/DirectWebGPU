+#[cfg(test)]
+mod memory_stats_tests {
+    use super::*;
+    #[test]
+    fn occupancy_tracks_headers_free_and_failed_realloc() {
+        let mut mem = Memory::leak_new(0x4000);
+        let heap = Heap::new(0x1000, 0x1000);
+        assert_eq!(heap.memory_stats(), (0, 0x1000, 1));
+        let a = heap.alloc(&mut mem, 12);
+        let b = heap.alloc(&mut mem, 28);
+        assert_eq!(heap.memory_stats().0, 48);
+        heap.free(&mut mem, a);
+        assert_eq!(heap.memory_stats().0, 32);
+        assert!(heap.realloc(&mut mem, b, 0x2000, false).is_none());
+        assert_eq!(heap.memory_stats().0, 32);
+        heap.free(&mut mem, b);
+        assert_eq!(heap.memory_stats().0, 0);
+    }
+}
