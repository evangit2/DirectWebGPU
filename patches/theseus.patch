diff --git a/win32/winapi/src/d3d9/buffers.rs b/win32/winapi/src/d3d9/buffers.rs
new file mode 100644
index 0000000..5073f2f
--- /dev/null
+++ b/win32/winapi/src/d3d9/buffers.rs
@@ -0,0 +1,460 @@
+//! Vertex/index buffer COM storage with persistent guest lock memory.
+use super::*;
+#[derive(Clone)]
+struct Buffer {
+    refs: u32,
+    bindings: u32,
+    owner: u32,
+    backend: u32,
+    gpu: u32,
+    data: u32,
+    size: u32,
+    usage: u32,
+    pool: u32,
+    kind: u32,
+    format: u32,
+    fvf: u32,
+    locked: Option<(u32, u32, bool)>,
+}
+static BUFFERS: LazyLock<Mutex<HashMap<u32, Buffer>>> =
+    LazyLock::new(|| Mutex::new(HashMap::new()));
+pub const VTABLE_ENTRIES: [&str; 14] = [
+    "QueryInterface",
+    "AddRef",
+    "Release",
+    "GetDevice",
+    "SetPrivateData",
+    "GetPrivateData",
+    "FreePrivateData",
+    "SetPriority",
+    "GetPriority",
+    "PreLoad",
+    "GetType",
+    "Lock",
+    "Unlock",
+    "GetDesc",
+];
+fn buffer(this: u32) -> Buffer {
+    BUFFERS
+        .lock()
+        .unwrap()
+        .get(&this)
+        .expect("invalid/released geometry buffer")
+        .clone()
+}
+pub fn create(
+    ctx: &mut Context,
+    owner: u32,
+    backend: u32,
+    kind: u32,
+    size: u32,
+    usage: u32,
+    format: u32,
+    pool: u32,
+    fvf: u32,
+    out: u32,
+    shared: u32,
+) -> u32 {
+    if !valid(ctx, out, 4) {
+        return D3DERR_INVALIDCALL;
+    }
+    ctx.memory.write::<u32>(out, 0);
+    if shared != 0
+        || size == 0
+        || size > 64 * 1024 * 1024
+        || pool > 1
+        || usage & !0x208 != 0
+        || (usage & 0x200 != 0 && pool == 1)
+        || (kind == 7
+            && (![101, 102].contains(&format) || size % if format == 101 { 2 } else { 4 } != 0))
+    {
+        return D3DERR_INVALIDCALL;
+    }
+    let gpu = host::graphics_call(5, &[backend, kind, size, format]);
+    if gpu >= 0x80000000 {
+        return gpu;
+    }
+    let padded = (size + 3) & !3;
+    let data = kernel32::lock().process_heap.alloc(&mut ctx.memory, padded);
+    if data == 0 {
+        host::graphics_call(7, &[backend, gpu]);
+        return 0x8007000e;
+    }
+    ctx.memory.bytes[data as usize..(data + padded) as usize].fill(0);
+    let this = kernel32::lock().process_heap.alloc(&mut ctx.memory, 4);
+    if this == 0 {
+        kernel32::lock().process_heap.free(&mut ctx.memory, data);
+        host::graphics_call(7, &[backend, gpu]);
+        return 0x8007000e;
+    }
+    let vt = unsafe {
+        if kind == 6 {
+            IDirect3DVertexBuffer9::VTABLE
+        } else {
+            IDirect3DIndexBuffer9::VTABLE
+        }
+    };
+    assert!(valid(ctx, vt, 14 * 4), "buffer vtable missing");
+    ctx.memory.write::<u32>(this, vt);
+    IDirect3DDevice9::AddRef(ctx, owner);
+    BUFFERS.lock().unwrap().insert(
+        this,
+        Buffer {
+            refs: 1,
+            bindings: 0,
+            owner,
+            backend,
+            gpu,
+            data,
+            size,
+            usage,
+            pool,
+            kind,
+            format,
+            fvf,
+            locked: None,
+        },
+    );
+    ctx.memory.write::<u32>(out, this);
+    D3D_OK
+}
+#[win32_derive::dllexport]
+pub fn QueryInterface(ctx: &mut Context, this: u32, iid: u32, out: u32) -> u32 {
+    let b = buffer(this);
+    if !valid(ctx, out, 4) {
+        return E_POINTER;
+    }
+    ctx.memory.write::<u32>(out, 0);
+    if !valid(ctx, iid, 16) {
+        return E_POINTER;
+    }
+    let id = &ctx.memory.bytes[iid as usize..iid as usize + 16];
+    let own = if b.kind == 6 {
+        [
+            0xb5, 0xb1, 0x4b, 0xb6, 0x70, 0xfd, 0xf6, 0x4d, 0xbf, 0x91, 0x19, 0xd0, 0xa1, 0x24,
+            0x55, 0xe3,
+        ]
+    } else {
+        [
+            0x5e, 0xd6, 0x9d, 0x7c, 0xf7, 0xd3, 0x29, 0x45, 0xac, 0xee, 0x78, 0x58, 0x30, 0xac,
+            0xde, 0x35,
+        ]
+    };
+    let resource = [
+        0x5d, 0xc0, 0xee, 0x05, 0x7d, 0x8f, 0x62, 0x43, 0xb9, 0x99, 0xd1, 0xba, 0xf3, 0x57, 0xc7,
+        0x04,
+    ];
+    if id != IID_UNKNOWN && id != own && id != resource {
+        return E_NOINTERFACE;
+    }
+    AddRef(ctx, this);
+    ctx.memory.write::<u32>(out, this);
+    D3D_OK
+}
+// Binding references keep storage alive without retaining the device. A
+// nonzero external COM refcount retains the device once, avoiding a cycle.
+#[win32_derive::dllexport]
+pub fn AddRef(ctx: &mut Context, this: u32) -> u32 {
+    let mut map = BUFFERS.lock().unwrap();
+    let b = map.get_mut(&this).expect("invalid buffer AddRef");
+    let retain_owner = b.refs == 0;
+    let owner = b.owner;
+    b.refs = b.refs.checked_add(1).expect("buffer ref overflow");
+    let refs = b.refs;
+    drop(map);
+    if retain_owner {
+        IDirect3DDevice9::AddRef(ctx, owner);
+    }
+    refs
+}
+fn destroy(ctx: &mut Context, this: u32, b: Buffer) {
+    assert_eq!(b.refs, 0);
+    assert_eq!(b.bindings, 0);
+    host::graphics_call(7, &[b.backend, b.gpu]);
+    ctx.memory.write::<u32>(this, 0);
+    kernel32::lock().process_heap.free(&mut ctx.memory, b.data);
+    kernel32::lock().process_heap.free(&mut ctx.memory, this);
+}
+#[win32_derive::dllexport]
+pub fn Release(ctx: &mut Context, this: u32) -> u32 {
+    let mut map = BUFFERS.lock().unwrap();
+    let b = map.get_mut(&this).expect("invalid buffer Release");
+    assert!(b.refs > 0, "buffer external reference underflow");
+    b.refs -= 1;
+    if b.refs != 0 {
+        return b.refs;
+    }
+    let owner = b.owner;
+    let removed = if b.bindings == 0 {
+        map.remove(&this)
+    } else {
+        None
+    };
+    drop(map);
+    if let Some(b) = removed {
+        destroy(ctx, this, b)
+    }
+    IDirect3DDevice9::Release(ctx, owner);
+    0
+}
+pub(super) fn binding_valid(this: u32, owner: u32, kind: u32, offset: u32) -> bool {
+    BUFFERS
+        .lock()
+        .unwrap()
+        .get(&this)
+        .is_some_and(|b| b.owner == owner && b.kind == kind && offset < b.size)
+}
+pub(super) fn retain_binding(this: u32) {
+    let mut map = BUFFERS.lock().unwrap();
+    let b = map.get_mut(&this).expect("invalid bound buffer");
+    b.bindings = b.bindings.checked_add(1).expect("buffer binding overflow");
+}
+pub(super) fn release_binding(ctx: &mut Context, this: u32) {
+    if this == 0 {
+        return;
+    }
+    let mut map = BUFFERS.lock().unwrap();
+    let b = map.get_mut(&this).expect("invalid bound buffer");
+    assert!(b.bindings > 0);
+    b.bindings -= 1;
+    let removed = if b.bindings == 0 && b.refs == 0 {
+        map.remove(&this)
+    } else {
+        None
+    };
+    drop(map);
+    if let Some(b) = removed {
+        destroy(ctx, this, b)
+    }
+}
