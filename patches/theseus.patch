+/// Synchronous rare graphics operations; result must be nonzero to signal completion.
+pub fn graphics_call(op:u32, values:&[u32])->u32 {
+    let args=js_sys::Array::new();args.push(&JsValue::from(op));
+    for value in values{args.push(&JsValue::from(*value));}
+    host::host().chan.lock().unwrap().send_sync("graphics_call",args) as u32
+}
