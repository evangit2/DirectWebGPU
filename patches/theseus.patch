+use crate::Flags;
+
+/// The eight XMM registers exposed by the 32-bit SSE instruction set.
+/// Values are kept as raw lanes so integer packing, bitwise operations, and
+/// floating-point operations can share one representation.
+#[derive(Clone, Copy, Debug)]
+pub struct SSE {
+    pub xmm: [[u32; 4]; 8],
+}
+
+impl Default for SSE {
+    fn default() -> Self {
+        Self { xmm: [[0; 4]; 8] }
+    }
+}
+
+impl SSE {
+    pub fn get(&self, index: usize) -> [u32; 4] {
+        self.xmm[index]
+    }
+
+    pub fn set(&mut self, index: usize, value: [u32; 4]) {
+        self.xmm[index] = value;
+    }
+}
+
+fn map_ps(a: [u32; 4], b: [u32; 4], f: impl Fn(f32, f32) -> f32) -> [u32; 4] {
+    std::array::from_fn(|i| f(f32::from_bits(a[i]), f32::from_bits(b[i])).to_bits())
+}
+
+pub fn sse_add_ps(a: [u32; 4], b: [u32; 4]) -> [u32; 4] { map_ps(a, b, |x, y| x + y) }
+pub fn sse_sub_ps(a: [u32; 4], b: [u32; 4]) -> [u32; 4] { map_ps(a, b, |x, y| x - y) }
+pub fn sse_mul_ps(a: [u32; 4], b: [u32; 4]) -> [u32; 4] { map_ps(a, b, |x, y| x * y) }
+pub fn sse_div_ps(a: [u32; 4], b: [u32; 4]) -> [u32; 4] { map_ps(a, b, |x, y| x / y) }
+
+pub fn sse_add_ss(mut a: [u32; 4], b: [u32; 4]) -> [u32; 4] {
+    a[0] = (f32::from_bits(a[0]) + f32::from_bits(b[0])).to_bits(); a
+}
+pub fn sse_sub_ss(mut a: [u32; 4], b: [u32; 4]) -> [u32; 4] {
+    a[0] = (f32::from_bits(a[0]) - f32::from_bits(b[0])).to_bits(); a
+}
+pub fn sse_mul_ss(mut a: [u32; 4], b: [u32; 4]) -> [u32; 4] {
+    a[0] = (f32::from_bits(a[0]) * f32::from_bits(b[0])).to_bits(); a
+}
+pub fn sse_div_ss(mut a: [u32; 4], b: [u32; 4]) -> [u32; 4] {
+    a[0] = (f32::from_bits(a[0]) / f32::from_bits(b[0])).to_bits(); a
+}
+pub fn sse_sqrt_ps(a: [u32; 4]) -> [u32; 4] {
+    std::array::from_fn(|i| f32::from_bits(a[i]).sqrt().to_bits())
+}
+pub fn sse_sqrt_ss(mut a: [u32; 4]) -> [u32; 4] {
+    a[0] = f32::from_bits(a[0]).sqrt().to_bits(); a
+}
+pub fn sse_rcp_ps(a: [u32; 4]) -> [u32; 4] {
+    std::array::from_fn(|i| (1.0f32 / f32::from_bits(a[i])).to_bits())
+}
+pub fn sse_rcp_ss(mut a: [u32; 4]) -> [u32; 4] {
+    a[0] = (1.0f32 / f32::from_bits(a[0])).to_bits(); a
+}
+pub fn sse_rsqrt_ps(a: [u32; 4]) -> [u32; 4] {
+    std::array::from_fn(|i| (1.0f32 / f32::from_bits(a[i]).sqrt()).to_bits())
+}
+pub fn sse_rsqrt_ss(mut a: [u32; 4]) -> [u32; 4] {
+    a[0] = (1.0f32 / f32::from_bits(a[0]).sqrt()).to_bits(); a
+}
+
+pub fn sse_xor_ps(a: [u32; 4], b: [u32; 4]) -> [u32; 4] { std::array::from_fn(|i| a[i] ^ b[i]) }
+pub fn sse_and_ps(a: [u32; 4], b: [u32; 4]) -> [u32; 4] { std::array::from_fn(|i| a[i] & b[i]) }
+pub fn sse_or_ps(a: [u32; 4], b: [u32; 4]) -> [u32; 4] { std::array::from_fn(|i| a[i] | b[i]) }
+pub fn sse_andn_ps(a: [u32; 4], b: [u32; 4]) -> [u32; 4] { std::array::from_fn(|i| (!a[i]) & b[i]) }
+
+pub fn sse_set_scalar(mut a: [u32; 4], value: u32) -> [u32; 4] { a[0] = value; a }
+pub fn sse_set_low2(mut a: [u32; 4], value: [u32; 2]) -> [u32; 4] { a[0] = value[0]; a[1] = value[1]; a }
+pub fn sse_set_high2(mut a: [u32; 4], value: [u32; 2]) -> [u32; 4] { a[2] = value[0]; a[3] = value[1]; a }
+pub fn sse_movhlps(mut a: [u32; 4], b: [u32; 4]) -> [u32; 4] { a[0] = b[2]; a[1] = b[3]; a }
+pub fn sse_movlhps(mut a: [u32; 4], b: [u32; 4]) -> [u32; 4] { a[2] = b[0]; a[3] = b[1]; a }
+
+pub fn sse_shuffle(a: [u32; 4], b: [u32; 4], imm: u8) -> [u32; 4] {
+    [a[(imm & 3) as usize], a[((imm >> 2) & 3) as usize], b[((imm >> 4) & 3) as usize], b[((imm >> 6) & 3) as usize]]
+}
+pub fn sse_unpack_low(a: [u32; 4], b: [u32; 4]) -> [u32; 4] { [a[0], b[0], a[1], b[1]] }
+pub fn sse_unpack_high(a: [u32; 4], b: [u32; 4]) -> [u32; 4] { [a[2], b[2], a[3], b[3]] }
+
+pub fn sse_packssdw(a: [u32; 4], b: [u32; 4]) -> [u32; 4] {
+    let lane = |v: u32| (v as i32).clamp(i16::MIN as i32, i16::MAX as i32) as i16 as u16 as u32;
+    [lane(a[0]) | (lane(a[1]) << 16), lane(a[2]) | (lane(a[3]) << 16), lane(b[0]) | (lane(b[1]) << 16), lane(b[2]) | (lane(b[3]) << 16)]
+}
+
+pub fn sse_compare_ps(a: [u32; 4], b: [u32; 4], predicate: u32) -> [u32; 4] {
+    std::array::from_fn(|i| {
+        let x = f32::from_bits(a[i]); let y = f32::from_bits(b[i]); let unordered = x.is_nan() || y.is_nan();
+        let result = match predicate {
+            0 => !unordered && x == y, 1 => !unordered && x < y, 2 => !unordered && x <= y,
+            3 => unordered, 4 => unordered || x != y, 5 => unordered || x >= y,
+            6 => unordered || x > y, 7 => !unordered,
+            _ => false,
+        };
+        if result { u32::MAX } else { 0 }
+    })
+}
+
+pub fn sse_compare_scalar(a: [u32; 4], b: [u32; 4], predicate: u32) -> [u32; 4] {
+    let mut out = a;
+    out[0] = sse_compare_ps(a, b, predicate)[0]; out
+}
+
+pub fn sse_compare_flags(a: u32, b: u32, flags: &mut Flags) {
+    let x = f32::from_bits(a); let y = f32::from_bits(b); let unordered = x.is_nan() || y.is_nan();
+    flags.set(Flags::ZF, unordered || x == y);
+    flags.set(Flags::CF, unordered || x < y);
+    flags.set(Flags::PF, unordered);
+    flags.remove(Flags::SF | Flags::OF);
+}
