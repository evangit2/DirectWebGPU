+#[cfg(test)]
+mod tests {
+ use super::*;
+
+ #[test]
+ fn d3d8_frontend_preserves_abi_and_resource_vtables() {
+  crate::trace::init("");
+  kernel32::init_state(0x400000,0..0);
+  kernel32::lock().process_heap=crate::heap::Heap::new(0x2000,0x7000);
+  let mut ctx=runtime::Context {cpu:Default::default(),thread_handle:1,thread_id:1,memory:runtime::Memory::leak_new(0x20000),blocks:&[(runtime::RETURN_FROM_X86_ADDR32,runtime::Context::return_from_x86)],cache:Default::default(),recent:[runtime::Context::return_from_x86;4]};
+  unsafe {
+   d3d9::IDirect3D9::VTABLE=0x1000;
+   IDirect3D8::VTABLE=0x1200;
+   d3d9::IDirect3DDevice9::VTABLE=0x1400;
+   IDirect3DDevice8::VTABLE=0x1600;
+   IDirect3DTexture8::VTABLE=0x1800;
+   IDirect3DVertexBuffer8::VTABLE=0x1a00;
+   IDirect3DIndexBuffer8::VTABLE=0x1c00;
+   d3d9::IDirect3DVertexDeclaration9::VTABLE=0x1e00;
+   d3d9::IDirect3DSurface9::VTABLE=0x1f00;
+  }
+  ctx.cpu.regs.esp=0xf000;
+  let original_sp=ctx.cpu.regs.esp;
+  ctx.call32_x86(runtime::Cont(Direct3DCreate8_stdcall),vec![120]);
+  assert_eq!(ctx.cpu.regs.esp,original_sp);
+  let d3d=ctx.cpu.regs.eax;
+  assert_ne!(d3d,0);
+  assert_eq!(ctx.memory.read::<u32>(d3d),0x1200);
+  ctx.memory.bytes[0x1100..0x1110].copy_from_slice(&IID_D3D8);
+  ctx.call32_x86(runtime::Cont(IDirect3D8::QueryInterface_stdcall),vec![d3d,0x1100,0x1300]);
+  assert_eq!(ctx.cpu.regs.esp,original_sp);
+  assert_eq!(ctx.cpu.regs.eax,D3D_OK);
+  assert_eq!(ctx.memory.read::<u32>(0x1300),d3d);
+  assert_eq!(IDirect3D8::GetAdapterDisplayMode(&mut ctx,d3d,0,0x1320),D3D_OK);
+  assert_eq!(ctx.memory.read::<u32>(0x1320),1280);
+
+  let dev=d3d9::IDirect3DDevice9::create(&mut ctx,d3d,1,1,0x40,800,600,22);
+  overwrite_vtable(&mut ctx,dev,unsafe{IDirect3DDevice8::VTABLE});
+  IDirect3DDevice8::init(dev);
+  assert_eq!(ctx.memory.read::<u32>(dev),0x1600);
+  ctx.call32_x86(runtime::Cont(IDirect3DDevice8::SetVertexShader_stdcall),vec![dev,0x142]);
+  assert_eq!(ctx.cpu.regs.esp,original_sp);
+  assert_eq!(ctx.cpu.regs.eax,D3D_OK);
+  assert_eq!(IDirect3DDevice8::GetVertexShader(&mut ctx,dev,0x1330),D3D_OK);
+  assert_eq!(ctx.memory.read::<u32>(0x1330),0x142);
+
+  let tex=d3d9::texture_fixture(&mut ctx,dev);
+  assert_eq!(IDirect3DDevice8::SetTexture(&mut ctx,dev,0,tex),D3D_OK);
+  assert_eq!(IDirect3DDevice8::GetTexture(&mut ctx,dev,0,0x1340),D3D_OK);
+  assert_eq!(ctx.memory.read::<u32>(0x1340),tex);
+  assert_eq!(ctx.memory.read::<u32>(tex),0x1800);
+
+  let vb=d3d9::buffer_fixture(&mut ctx,dev,6);
+  assert_eq!(IDirect3DDevice8::SetStreamSource(&mut ctx,dev,0,vb,24),D3D_OK);
+  assert_eq!(IDirect3DDevice8::GetStreamSource(&mut ctx,dev,0,0x1350,0x1354),D3D_OK);
+  assert_eq!(ctx.memory.read::<u32>(0x1350),vb);
+  assert_eq!(ctx.memory.read::<u32>(0x1354),24);
+  assert_eq!(ctx.memory.read::<u32>(vb),0x1a00);
+
+  let ib=d3d9::buffer_fixture(&mut ctx,dev,7);
+  assert_eq!(IDirect3DDevice8::SetIndices(&mut ctx,dev,ib,23),D3D_OK);
+  assert_eq!(IDirect3DDevice8::GetIndices(&mut ctx,dev,0x1360,0x1364),D3D_OK);
+  assert_eq!(ctx.memory.read::<u32>(0x1360),ib);
+  assert_eq!(ctx.memory.read::<u32>(0x1364),23);
+  assert_eq!(ctx.memory.read::<u32>(ib),0x1c00);
+ }
+}
