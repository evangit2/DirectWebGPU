+//! DirectInput 8 ABI compatibility backed by the existing DirectInput state.
+
+use runtime::Context;
+
+use crate::{dinput, heap::Heap, kernel32};
+
+const DI_OK: u32 = 0;
+const E_NOINTERFACE: u32 = 0x80004002;
+const E_POINTER: u32 = 0x80004003;
+const E_NOTIMPL: u32 = 0x80004001;
+
+pub const VTABLES: [(&'static str, &[&str]); 2] = [
+    ("IDirectInput8", IDirectInput8::VTABLE_ENTRIES.as_slice()),
+    (
+        "IDirectInputDevice8",
+        IDirectInputDevice8::VTABLE_ENTRIES.as_slice(),
+    ),
+];
+
+#[win32_derive::dllexport]
+pub fn DirectInput8Create(
+    ctx: &mut Context,
+    _hinst: u32,
+    _dwVersion: u32,
+    _riidltf: u32,
+    ppvOut: u32,
+    punkOuter: u32,
+) -> u32 {
+    if ppvOut == 0 || punkOuter != 0 {
+        return E_POINTER;
+    }
+    let mut kernel32 = kernel32::lock();
+    let ptr = IDirectInput8::new(ctx, &mut kernel32.process_heap);
+    drop(kernel32);
+    ctx.memory.write::<u32>(ppvOut, ptr);
+    DI_OK
+}
+
