diff --git a/win32/winapi/src/d3d9.rs b/win32/winapi/src/d3d9.rs
new file mode 100644
index 0000000..07b8902
--- /dev/null
+++ b/win32/winapi/src/d3d9.rs
@@ -0,0 +1,282 @@
+//! D3D9 compatibility frontend. The adapter is a virtual canvas display, not a
+//! claim that unimplemented shader/device features are available.
+use runtime::Context;
+use std::{collections::HashMap, sync::{LazyLock, Mutex}};
+use crate::kernel32;
+
+pub const D3D_OK: u32 = 0;
+pub const D3DERR_INVALIDCALL: u32 = 0x8876086c;
+pub const D3DERR_NOTAVAILABLE: u32 = 0x8876086a;
+const E_NOINTERFACE: u32 = 0x80004002;
+const E_POINTER: u32 = 0x80004003;
+const IID_UNKNOWN: [u8;16] = [0,0,0,0,0,0,0,0,0xc0,0,0,0,0,0,0,0x46];
+const IID_D3D9: [u8;16] = [0xca,0xcb,0xbd,0x81,0xd4,0x64,0x6d,0x42,0xae,0x8d,0xad,1,0x47,0xf4,0x27,0x5c];
+static OBJECTS: LazyLock<Mutex<HashMap<u32,u32>>> = LazyLock::new(||Mutex::new(HashMap::new()));
+
+#[path="d3d9/constants.rs"]
+mod constants;
+#[path="d3d9/device.rs"]
+pub mod IDirect3DDevice9;
+#[path="d3d9/surface.rs"]
+pub mod IDirect3DSurface9;
+#[path="d3d9/buffers.rs"]
+mod buffers;
+pub mod IDirect3DVertexBuffer9 { pub use super::buffers::*; pub static mut VTABLE:u32=0; }
+pub mod IDirect3DIndexBuffer9 { pub use super::buffers::*; pub static mut VTABLE:u32=0; }
+#[path="d3d9/declaration.rs"]
+pub mod IDirect3DVertexDeclaration9;
+#[path="d3d9/shader.rs"]
+mod shader;
+pub mod IDirect3DVertexShader9{pub use super::shader::*;pub static mut VTABLE:u32=0;}
+pub mod IDirect3DPixelShader9{pub use super::shader::*;pub static mut VTABLE:u32=0;}
+#[path="d3d9/texture.rs"]
+pub mod IDirect3DTexture9;
+pub const VTABLES: [(&str, &[&str]);9] = [("IDirect3DTexture9", &IDirect3DTexture9::VTABLE_ENTRIES),("IDirect3D9", &IDirect3D9::VTABLE_ENTRIES),("IDirect3DDevice9", &IDirect3DDevice9::VTABLE_ENTRIES),("IDirect3DSurface9", &IDirect3DSurface9::VTABLE_ENTRIES),("IDirect3DVertexBuffer9", &IDirect3DVertexBuffer9::VTABLE_ENTRIES),("IDirect3DIndexBuffer9", &IDirect3DIndexBuffer9::VTABLE_ENTRIES),("IDirect3DVertexDeclaration9", &IDirect3DVertexDeclaration9::VTABLE_ENTRIES),("IDirect3DVertexShader9", &IDirect3DVertexShader9::VTABLE_ENTRIES),("IDirect3DPixelShader9", &IDirect3DPixelShader9::VTABLE_ENTRIES)];
+fn valid(ctx: &Context, p: u32, n: usize) -> bool {
+    p >= 0x1000 && (p as usize).checked_add(n).is_some_and(|end| end <= ctx.memory.bytes.len())
+}
+fn object(this: u32) {
+    assert!(OBJECTS.lock().unwrap().contains_key(&this), "invalid or released IDirect3D9 pointer {this:#010x}");
+}
+fn adapter(this: u32, index: u32) -> bool { object(this); index == 0 }
+fn unsupported(ctx: &Context, method: &str, nargs: u32) -> ! {
+    let esp = ctx.cpu.regs.esp;
+    let args: Vec<_> = (0..nargs).map(|i| ctx.memory.read::<u32>(esp+4+i*4)).collect();
+    panic!("unsupported API: d3d9!IDirect3D9::{method}; args={args:#x?}; stack_return={:#010x}; graphics capability not implemented",ctx.memory.read::<u32>(esp));
+}
+#[win32_derive::dllexport]
+pub fn Direct3DCreate9(ctx: &mut Context, SDKVersion: u32) -> u32 {
+    // SDK 31 is the original DX9 SDK used by this binary; 32 is the later DX9 SDK.
+    if SDKVersion != 31 && SDKVersion != 32 { return 0; }
+    let vtable = unsafe { IDirect3D9::VTABLE };
+    assert!(valid(ctx,vtable,17*4), "D3D9 vtable was not linked into the guest image");
+    let state = kernel32::lock();
+    let addr = state.process_heap.alloc(&mut ctx.memory,4);
+    ctx.memory.write::<u32>(addr,vtable);
+    assert!(OBJECTS.lock().unwrap().insert(addr,1).is_none());
+    log::info!("D3D9_CREATE9 sdk={SDKVersion} object={addr:#010x}");
+    addr
+}
+
+pub mod IDirect3D9 {
+    use super::*;
+    pub static mut VTABLE: u32 = 0;
+    // ABI order from the IDirect3D9 declaration, including the three IUnknown slots.
+    pub const VTABLE_ENTRIES: [&str;17] = ["QueryInterface","AddRef","Release","RegisterSoftwareDevice","GetAdapterCount","GetAdapterIdentifier","GetAdapterModeCount","EnumAdapterModes","GetAdapterDisplayMode","CheckDeviceType","CheckDeviceFormat","CheckDeviceMultiSampleType","CheckDepthStencilMatch","CheckDeviceFormatConversion","GetDeviceCaps","GetAdapterMonitor","CreateDevice"];
+
+    #[win32_derive::dllexport]
+    pub fn QueryInterface(ctx: &mut Context, this: u32, iid: u32, out: u32) -> u32 {
+        object(this);
+        if !valid(ctx,out,4) { return E_POINTER; }
+        ctx.memory.write::<u32>(out,0);
+        if !valid(ctx,iid,16) { return E_POINTER; }
+        let id=&ctx.memory.bytes[iid as usize..iid as usize+16];
+        if id != IID_UNKNOWN && id != IID_D3D9 { return E_NOINTERFACE; }
+        AddRef(ctx,this);
+        ctx.memory.write::<u32>(out,this);
+        D3D_OK
+    }
+    #[win32_derive::dllexport]
+    pub fn AddRef(_ctx: &mut Context, this: u32) -> u32 {
+        let mut objects=OBJECTS.lock().unwrap();
+        let refs=objects.get_mut(&this).expect("invalid AddRef object");
+        *refs=refs.checked_add(1).expect("COM refcount overflow"); *refs
+    }
+    #[win32_derive::dllexport]
+    pub fn Release(ctx: &mut Context, this: u32) -> u32 {
+        let mut objects=OBJECTS.lock().unwrap();
+        let refs=objects.get_mut(&this).expect("invalid Release object");
+        *refs-=1; let left=*refs;
+        if left == 0 { objects.remove(&this); }
+        drop(objects);
+        if left == 0 {
+            ctx.memory.write::<u32>(this,0);
+            kernel32::lock().process_heap.free(&mut ctx.memory,this);
+        }
+        left
+    }
+    #[win32_derive::dllexport]
+    pub fn GetAdapterCount(_ctx: &mut Context, this: u32) -> u32 { object(this); 1 }
+    #[win32_derive::dllexport]
+    pub fn GetAdapterIdentifier(ctx: &mut Context, this: u32, index: u32, flags: u32, out: u32) -> u32 {
+        if !adapter(this,index) || flags & !2 != 0 || !valid(ctx,out,1100) { return D3DERR_INVALIDCALL; }
+        let dst=&mut ctx.memory.bytes[out as usize..out as usize+1100]; dst.fill(0);
+        let driver=b"humus-d3d9"; dst[..driver.len()].copy_from_slice(driver);
+        let description=b"Theseus virtual canvas adapter (graphics subset under development)";
+        dst[512..512+description.len()].copy_from_slice(description);
+        let name=b"\\\\.\\DISPLAY1"; dst[1024..1024+name.len()].copy_from_slice(name);
+        // Vendor/device IDs and WHQL level are deliberately zero: not a hardware ID.
+        dst[1080..1096].copy_from_slice(&IID_D3D9);
+        D3D_OK
+    }
+    #[win32_derive::dllexport]
+    pub fn GetAdapterModeCount(_ctx: &mut Context, this: u32, index: u32, format: u32) -> u32 {
+        if adapter(this,index) && format == 22 {1} else {0} // X8R8G8B8
+    }
+    fn write_mode(ctx: &mut Context, out: u32) -> u32 {
+        if !valid(ctx,out,16) { return D3DERR_INVALIDCALL; }
+        // The same virtual display exposed by EnumDisplaySettingsA. Refresh 0=default.
+        for (i,value) in [1280u32,720,0,22].into_iter().enumerate() {ctx.memory.write::<u32>(out+i as u32*4,value);}
+        D3D_OK
+    }
+    #[win32_derive::dllexport]
+    pub fn EnumAdapterModes(ctx: &mut Context, this: u32, index: u32, format: u32, mode: u32, out: u32) -> u32 {
+        if !adapter(this,index) || mode != 0 {return D3DERR_INVALIDCALL;}
+        if format != 22 {return D3DERR_NOTAVAILABLE;}
+        write_mode(ctx,out)
+    }
+    #[win32_derive::dllexport]
+    pub fn GetAdapterDisplayMode(ctx: &mut Context, this: u32, index: u32, out: u32) -> u32 {
+        if !adapter(this,index) {return D3DERR_INVALIDCALL;}
