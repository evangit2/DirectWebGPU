+        assert_eq!(RegQueryValueExA(&mut ctx, h, 0x1200, 0, 0, 0, 0x1500), 5);
+        assert_eq!(RegCloseKey(&mut ctx, h), 0);
+        assert_eq!(RegCloseKey(&mut ctx, h), 6);
+        assert_eq!(RegOpenKeyExA(&mut ctx, 0x80000002, 0x1100, 0, 1, 0x1300), 0);
+        let h = ctx.memory.read::<u32>(0x1300);
+        assert_eq!(
+            RegQueryValueExA(&mut ctx, h, 0x1200, 0, 0x1504, 0, 0x1500),
+            0
+        );
+        assert_eq!(ctx.memory.read::<u32>(0x1500), 4);
+        assert_eq!(ctx.memory.read::<u32>(0x1504), 4);
+        ctx.memory.write::<u32>(0x1500, 2);
+        ctx.memory.write::<u32>(0x1600, 0xa5a5a5a5);
+        assert_eq!(
+            RegQueryValueExA(&mut ctx, h, 0x1200, 0, 0, 0x1600, 0x1500),
+            234
+        );
+        assert_eq!(ctx.memory.read::<u32>(0x1600), 0xa5a5a5a5);
+        assert_eq!(
+            RegQueryValueExA(&mut ctx, h, 0x1200, 0, 0, 0x1600, 0x1500),
+            0
+        );
+        assert_eq!(ctx.memory.read::<u32>(0x1600), 0x12345678);
+        assert_eq!(RegSetValueExA(&mut ctx, h, 0x1200, 0, 4, 0x1400, 4), 5);
+        assert_eq!(RegCloseKey(&mut ctx, h), 0);
+        seed_registry_dword(0x80000002,"Software\\EnumTest","WindowedRight",1280).unwrap();
+        let path=b"Software\\EnumTest\0";
+        ctx.memory.bytes[0x1100..0x1100+path.len()].copy_from_slice(path);
+        assert_eq!(RegOpenKeyExA(&mut ctx,0x80000002,0x1100,0,1,0x1300),0);
+        let h=ctx.memory.read::<u32>(0x1300);
+        assert!(seed_registry_dword(0x80000002,"x","y",1).is_err());
+        ctx.memory.write::<u32>(0x1500,2);
+        ctx.memory.write::<u32>(0x1508,2);
+        assert_eq!(RegEnumValueA(&mut ctx,h,0,0x1600,0x1500,0,0x1504,0x1700,0x1508),234);
+        assert_eq!(ctx.memory.read::<u32>(0x1508),4);
+        ctx.memory.write::<u32>(0x1500,32);
+        ctx.call32_x86(runtime::Cont(RegEnumValueA_stdcall),vec![h,0,0x1600,0x1500,0,0x1504,0,0]);
+        assert_eq!(ctx.cpu.regs.eax,0);
+        assert_eq!(ctx.cpu.regs.esp,0x4000);
+        assert_eq!(&ctx.memory.bytes[0x1600..0x160e],b"WindowedRight\0");
+        assert_eq!(ctx.memory.read::<u32>(0x1500),13);
+        ctx.memory.write::<u32>(0x1500,32);
+        assert_eq!(RegEnumValueA(&mut ctx,h,0,0x1600,0x1500,0,0,0x1700,0x1508),0);
+        assert_eq!(ctx.memory.read::<u32>(0x1700),1280);
+        assert_eq!(RegEnumValueA(&mut ctx,h,1,0x1600,0x1500,0,0,0,0),259);
+        assert_eq!(RegEnumValueA(&mut ctx,h,0,0x1600,0x5000,0,0,0,0),87);
+        assert_eq!(RegCloseKey(&mut ctx,h),0);
+    }
+}
