+ #[win32_derive::dllexport] pub fn CheckDeviceMultiSampleType(_ctx:&mut Context,_this:u32,index:u32,kind:u32,format:u32,_windowed:u32,multi:u32)->u32{if index==0&&kind==1&&[21,22,75].contains(&format)&&multi==0{D3D_OK}else{D3DERR_NOTAVAILABLE}}
+ #[win32_derive::dllexport] pub fn CheckDepthStencilMatch(_ctx:&mut Context,_this:u32,index:u32,kind:u32,adapter:u32,target:u32,depth:u32)->u32{if index==0&&kind==1&&adapter==22&&[21,22,23,24,25,26].contains(&target)&&depth==75{D3D_OK}else{D3DERR_NOTAVAILABLE}}
+ pub(super) fn write_caps(ctx:&mut Context,out:u32)->u32{
+  if !valid(ctx,out,53*4){return D3DERR_INVALIDCALL}let mut c=[0u32;53];
+  c[0]=1;c[1]=0;c[3]=0x20000000|0x00080000;c[5]=1;c[7]=0x00080000;
+  c[8]=0x2|0x10|0x20|0x40|0x80|0x800;c[9]=0x10|0x400000;c[10]=0xff;c[11]=0x7ff;c[12]=0x3ff;c[13]=0xff;
+  c[15]=0x1|0x4|0x40|0x4000;c[16]=0x100|0x200|0x10000|0x20000;c[19]=0x1|0x2|0x4;c[21]=0x1|0x2|0x4|0x8;
+  c[22]=4096;c[23]=4096;c[25]=8192;c[26]=4096;c[27]=1;c[28]=1e10f32.to_bits();c[34]=0xff;c[35]=8;c[36]=0x3ffffff;c[37]=8;c[38]=1;c[42]=1;c[44]=1.0f32.to_bits();c[45]=349525;c[46]=0xffffff;c[47]=16;c[48]=2048;c[52]=1.0f32.to_bits();
+  for(i,v)in c.into_iter().enumerate(){ctx.memory.write::<u32>(out+i as u32*4,v)}D3D_OK
+ }
+ #[win32_derive::dllexport] pub fn GetDeviceCaps(ctx:&mut Context,_this:u32,index:u32,kind:u32,out:u32)->u32{if index!=0||kind!=1{return D3DERR_NOTAVAILABLE}write_caps(ctx,out)}
+ #[win32_derive::dllexport] pub fn GetAdapterMonitor(ctx:&mut Context,this:u32,index:u32)->u32{d3d9::IDirect3D9::GetAdapterMonitor(ctx,this,index)}
+ #[win32_derive::dllexport] pub fn CreateDevice(ctx:&mut Context,this:u32,index:u32,kind:u32,focus:u32,behavior:u32,presentation:u32,out:u32)->u32{
+  if !valid(ctx,presentation,52)||!valid(ctx,out,4){return D3DERR_INVALIDCALL}
