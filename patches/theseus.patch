+pub(crate) fn create_device_with_vtable(
+    ctx: &mut Context,
+    lpGUID: u32,
+    lplpDirectInputDevice: u32,
+    vtable: u32,
+) -> u32 {
+    let guid = crate::Ptr::<GUID>::new(lpGUID).read(&ctx.memory).unwrap();
+    let kind = if guid == GUID_SysKeyboard {
+        DeviceKind::Keyboard
+    } else if guid == GUID_SysMouse {
+        DeviceKind::Mouse
+    } else {
+        log::warn!("CreateDevice: unknown GUID {guid:?}");
+        return DIERR_DEVICENOTREG;
+    };
+    let mut kernel32 = kernel32::lock();
+    let device = IDirectInputDevice::new_with_vtable(ctx, &mut kernel32.process_heap, vtable);
+    drop(kernel32);
+    lock().devices.insert(
+        device,
+        Device {
+            kind,
+            acquired: false,
+        },
+    );
+    ctx.memory.write::<u32>(lplpDirectInputDevice, device);
