index 0000000..993ab95
--- /dev/null
+++ b/win32/winapi/src/d3d9/constants.rs
@@ -0,0 +1,164 @@
+//! D3D9 shader register state. Float/int registers preserve all input bits.
+use super::*;
+#[derive(Clone, Copy)]
+pub enum Kind {
+    Float,
+    Int,
+    Bool,
+}
+#[derive(Default)]
+pub struct Registers {
+    vertex: Stage,
+    pixel: Stage,
+}
+struct Stage {
+    floats: [u32; 1024],
+    ints: [u32; 64],
+    bools: [u32; 16],
+}
+impl Default for Stage {
+    fn default() -> Self {
+        Self {
+            floats: [0; 1024],
+            ints: [0; 64],
+            bools: [0; 16],
+        }
+    }
+}
+impl Registers {
+    pub fn transfer(
+        &mut self,
+        ctx: &mut Context,
+        pixel: bool,
+        kind: Kind,
+        start: u32,
+        pointer: u32,
+        count: u32,
+        write: bool,
+    ) -> u32 {
+        let stage = if pixel {
+            &mut self.pixel
+        } else {
+            &mut self.vertex
+        };
+        let (words, width): (&mut [u32], usize) = match kind {
+            Kind::Float => (
+                if pixel {
+                    &mut stage.floats[..128]
+                } else {
+                    &mut stage.floats[..]
+                },
+                4,
+            ),
+            Kind::Int => (&mut stage.ints, 4),
+            Kind::Bool => (&mut stage.bools, 1),
+        };
+        let capacity = (words.len() / width) as u32;
+        if start > capacity || count > capacity - start {
+            return D3DERR_INVALIDCALL;
+        }
+        if count == 0 {
+            return D3D_OK;
+        }
+        let n = count as usize * width;
+        if !valid(ctx, pointer, n * 4) {
+            return D3DERR_INVALIDCALL;
+        }
+        let registers = &mut words[start as usize * width..start as usize * width + n];
+        for (i, word) in registers.iter_mut().enumerate() {
+            let address = pointer + i as u32 * 4;
+            if write {
+                let value = ctx.memory.read::<u32>(address);
+                *word = if matches!(kind, Kind::Bool) {
+                    u32::from(value != 0)
+                } else {
+                    value
+                };
+            } else {
+                ctx.memory.write::<u32>(address, *word)
+            }
+        }
+        D3D_OK
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn registers_preserve_bits_boundaries_and_stage_isolation() {
+        let mut ctx = Context {
+            cpu: Default::default(),
+            thread_handle: 1,
+            thread_id: 1,
+            memory: runtime::Memory::leak_new(0x3000),
+            blocks: &[],
+            cache: Default::default(),
+            recent: [Context::return_from_x86; 4],
+        };
+        let mut state = Registers::default();
+        let bits = [0x7fc12345, 0x80000000, 0x7f800000, 0xff800000];
+        for (i, value) in bits.into_iter().enumerate() {
+            ctx.memory.write::<u32>(0x1000 + i as u32 * 4, value)
+        }
+        assert_eq!(
+            state.transfer(&mut ctx, false, Kind::Float, 255, 0x1000, 1, true),
+            D3D_OK
+        );
+        assert_eq!(
+            state.transfer(&mut ctx, false, Kind::Float, 255, 0x1100, 1, false),
+            D3D_OK
+        );
+        assert_eq!(
+            &ctx.memory.bytes[0x1000..0x1010],
+            &ctx.memory.bytes[0x1100..0x1110]
+        );
+        assert_eq!(
+            state.transfer(&mut ctx, true, Kind::Float, 31, 0x1100, 1, false),
+            D3D_OK
+        );
+        assert!(ctx.memory.bytes[0x1100..0x1110].iter().all(|b| *b == 0));
+        assert_eq!(
+            state.transfer(&mut ctx, false, Kind::Float, 255, 0x1000, 2, true),
+            D3DERR_INVALIDCALL
+        );
+        assert_eq!(
+            state.transfer(&mut ctx, false, Kind::Float, u32::MAX, 0, 1, true),
+            D3DERR_INVALIDCALL
+        );
+        assert_eq!(
+            state.transfer(&mut ctx, false, Kind::Float, 255, 0x2ff4, 1, true),
+            D3DERR_INVALIDCALL
+        );
+        assert_eq!(
+            state.transfer(&mut ctx, false, Kind::Float, 255, 0x1100, 1, false),
+            D3D_OK
+        );
+        assert_eq!(ctx.memory.read::<u32>(0x1100), bits[0]);
+        assert_eq!(
+            state.transfer(&mut ctx, true, Kind::Int, 15, 0x1000, 1, true),
+            D3D_OK
+        );
+        assert_eq!(
+            state.transfer(&mut ctx, true, Kind::Int, 15, 0x1100, 1, false),
+            D3D_OK
+        );
+        assert_eq!(ctx.memory.read::<u32>(0x1100), bits[0]);
+        ctx.memory.write::<u32>(0x1000, 0);
+        ctx.memory.write::<u32>(0x1004, 0xffffffff);
+        assert_eq!(
+            state.transfer(&mut ctx, true, Kind::Bool, 14, 0x1000, 2, true),
+            D3D_OK
+        );
+        assert_eq!(
+            state.transfer(&mut ctx, true, Kind::Bool, 14, 0x1100, 2, false),
+            D3D_OK
+        );
+        assert_eq!(ctx.memory.read::<u32>(0x1100), 0);
+        assert_eq!(ctx.memory.read::<u32>(0x1104), 1);
+        assert_eq!(
+            state.transfer(&mut ctx, true, Kind::Bool, 16, 0, 0, true),
+            D3D_OK
+        );
+    }
+}
+impl Registers{pub fn draw_words(&self,out:&mut Vec<u32>){out.extend_from_slice(&self.vertex.floats);out.extend_from_slice(&self.vertex.ints);out.extend_from_slice(&self.vertex.bools);out.extend_from_slice(&self.pixel.floats[..128]);out.extend_from_slice(&self.pixel.ints);out.extend_from_slice(&self.pixel.bools);}}
diff --git a/win32/winapi/src/d3d9/declaration.rs b/win32/winapi/src/d3d9/declaration.rs
new file mode 100644
index 0000000..629b941
--- /dev/null
+++ b/win32/winapi/src/d3d9/declaration.rs
@@ -0,0 +1,319 @@
+//! Owned copies of D3DVERTEXELEMENT9 arrays. Conversion at draw time is separate.
+use super::*;
+#[derive(Clone)]
+struct Declaration {
+    refs: u32,
+    bindings: u32,
+    owner: u32,
+    bytes: Vec<u8>,
+}
+static DECLARATIONS: LazyLock<Mutex<HashMap<u32, Declaration>>> =
+    LazyLock::new(|| Mutex::new(HashMap::new()));
+pub static mut VTABLE: u32 = 0;
+pub const VTABLE_ENTRIES: [&str; 5] = [
+    "QueryInterface",
+    "AddRef",
+    "Release",
+    "GetDevice",
+    "GetDeclaration",
+];
+const IID: [u8; 16] = [
+    0x9c, 0xc5, 0x13, 0xdd, 0xfa, 0x36, 0x98, 0x40, 0xa8, 0xfb, 0xc7, 0xed, 0x39, 0xdc, 0x85, 0x46,
+];
+const END: [u8; 8] = [0xff, 0, 0, 0, 17, 0, 0, 0];
+fn parse(ctx: &Context, pointer: u32) -> Option<Vec<u8>> {
+    let mut bytes = Vec::new();
+    let mut semantics = std::collections::HashSet::new();
+    for n in 0..=64u32 {
+        let p = pointer.checked_add(n * 8)?;
+        if !valid(ctx, p, 8) {
+            return None;
+        }
+        let element = &ctx.memory.bytes[p as usize..p as usize + 8];
+        if element == END {
+            if n == 0 {
+                return None;
+            }
+            bytes.extend_from_slice(element);
+            return Some(bytes);
+        }
+        let stream = u16::from_le_bytes([element[0], element[1]]);
+        let offset = u16::from_le_bytes([element[2], element[3]]) as u32;
+        // FLOAT1..FLOAT4 only until packed-color/integer conversion is implemented.
+        if n == 64
+            || stream >= 16
+            || element[4] > 3
+            || element[5] != 0
+            || element[6] > 13
+            || element[7] > 15
+            || offset % 4 != 0
+            || offset + 4 * (element[4] as u32 + 1) > 2048
+            || !semantics.insert((element[6], element[7]))
+        {
+            return None;
+        }
+        bytes.extend_from_slice(element);
+    }
+    None
+}
+pub(super) fn create(ctx: &mut Context, owner: u32, elements: u32, out: u32) -> u32 {
+    if !valid(ctx, out, 4) {
+        return D3DERR_INVALIDCALL;
+    }
+    ctx.memory.write::<u32>(out, 0);
+    let Some(bytes) = parse(ctx, elements) else {
+        return D3DERR_INVALIDCALL;
+    };
+    match create_owned(ctx, owner, bytes) {
+        Ok(this) => {
+            ctx.memory.write::<u32>(out, this);
+            D3D_OK
+        }
+        Err(e) => e,
+    }
+}
+pub(super) fn create_owned(ctx: &mut Context, owner: u32, bytes: Vec<u8>) -> Result<u32, u32> {
+    let vt = unsafe { VTABLE };
+    assert!(valid(ctx, vt, 20), "declaration vtable missing");
+    let this = kernel32::lock().process_heap.alloc(&mut ctx.memory, 4);
+    if this == 0 {
+        return Err(0x8007000e);
+    }
+    ctx.memory.write::<u32>(this, vt);
+    IDirect3DDevice9::AddRef(ctx, owner);
+    DECLARATIONS.lock().unwrap().insert(
+        this,
+        Declaration {
+            refs: 1,
+            bindings: 0,
+            owner,
+            bytes,
+        },
+    );
+    Ok(this)
+}
+fn declaration(this: u32) -> Declaration {
+    DECLARATIONS
+        .lock()
+        .unwrap()
+        .get(&this)
+        .expect("invalid/released vertex declaration")
+        .clone()
+}
+#[win32_derive::dllexport]
+pub fn QueryInterface(ctx: &mut Context, this: u32, iid: u32, out: u32) -> u32 {
+    declaration(this);
+    if !valid(ctx, out, 4) {
+        return E_POINTER;
+    }
+    ctx.memory.write::<u32>(out, 0);
+    if !valid(ctx, iid, 16) {
+        return E_POINTER;
+    }
+    let bytes = &ctx.memory.bytes[iid as usize..iid as usize + 16];
+    if bytes != IID && bytes != IID_UNKNOWN {
+        return E_NOINTERFACE;
+    }
+    AddRef(ctx, this);
+    ctx.memory.write::<u32>(out, this);
+    D3D_OK
+}
+#[win32_derive::dllexport]
+pub fn AddRef(ctx: &mut Context, this: u32) -> u32 {
+    let mut map = DECLARATIONS.lock().unwrap();
+    let d = map.get_mut(&this).expect("invalid declaration AddRef");
+    let retain = d.refs == 0;
+    let owner = d.owner;
+    d.refs = d.refs.checked_add(1).expect("declaration ref overflow");
+    let refs = d.refs;
+    drop(map);
+    if retain {
+        IDirect3DDevice9::AddRef(ctx, owner);
+    }
+    refs
+}
+fn destroy(ctx: &mut Context, this: u32) {
+    ctx.memory.write::<u32>(this, 0);
+    kernel32::lock().process_heap.free(&mut ctx.memory, this);
+}
+#[win32_derive::dllexport]
+pub fn Release(ctx: &mut Context, this: u32) -> u32 {
+    let mut map = DECLARATIONS.lock().unwrap();
+    let d = map.get_mut(&this).expect("invalid declaration Release");
+    assert!(d.refs > 0);
+    d.refs -= 1;
+    if d.refs != 0 {
+        return d.refs;
+    }
+    let owner = d.owner;
+    let remove = d.bindings == 0;
+    if remove {
+        map.remove(&this);
+    }
+    drop(map);
+    if remove {
+        destroy(ctx, this)
+    }
+    IDirect3DDevice9::Release(ctx, owner);
+    0
+}
+pub(super) fn retain_binding(this: u32, owner: u32) -> bool {
+    let mut map = DECLARATIONS.lock().unwrap();
+    let Some(d) = map.get_mut(&this) else {
+        return false;
+    };
+    if d.owner != owner {
+        return false;
+    }
+    d.bindings = d
+        .bindings
+        .checked_add(1)
+        .expect("declaration binding overflow");
+    true
+}
+pub(super) fn release_binding(ctx: &mut Context, this: u32) {
+    if this == 0 {
+        return;
+    }
+    let mut map = DECLARATIONS.lock().unwrap();
+    let d = map.get_mut(&this).expect("invalid declaration binding");
+    assert!(d.bindings > 0);
+    d.bindings -= 1;
+    let remove = d.refs == 0 && d.bindings == 0;
+    if remove {
+        map.remove(&this);
+    }
+    drop(map);
+    if remove {
+        destroy(ctx, this)
+    }
+}
+#[win32_derive::dllexport]
+pub fn GetDevice(ctx: &mut Context, this: u32, out: u32) -> u32 {
+    let d = declaration(this);
+    if !valid(ctx, out, 4) {
+        return D3DERR_INVALIDCALL;
+    }
+    IDirect3DDevice9::AddRef(ctx, d.owner);
+    ctx.memory.write::<u32>(out, d.owner);
+    D3D_OK
+}
+#[win32_derive::dllexport]
+pub fn GetDeclaration(ctx: &mut Context, this: u32, out: u32, count: u32) -> u32 {
+    let d = declaration(this);
+    if !valid(ctx, count, 4) || (out != 0 && !valid(ctx, out, d.bytes.len())) {
+        return D3DERR_INVALIDCALL;
+    }
+    if out != 0 {
+        ctx.memory.bytes[out as usize..out as usize + d.bytes.len()].copy_from_slice(&d.bytes)
+    }
+    ctx.memory.write::<u32>(count, (d.bytes.len() / 8) as u32);
+    D3D_OK
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn declaration_bounds_terminator_types_and_semantics() {
+        let mut ctx = Context {
+            cpu: Default::default(),
+            thread_handle: 1,
+            thread_id: 1,
+            memory: runtime::Memory::leak_new(0x3000),
+            blocks: &[],
+            cache: Default::default(),
+            recent: [Context::return_from_x86; 4],
+        };
+        let source = [
+            0, 0, 0, 0, 2, 0, 0, 0, 1, 0, 12, 0, 1, 0, 5, 0, 255, 0, 0, 0, 17, 0, 0, 0,
+        ];
+        ctx.memory.bytes[0x1000..0x1018].copy_from_slice(&source);
+        assert_eq!(parse(&ctx, 0x1000), Some(source.to_vec()));
+        ctx.memory.bytes[0x1004] = 4;
+        assert!(parse(&ctx, 0x1000).is_none());
+        ctx.memory.bytes[0x1004] = 2;
+        ctx.memory.bytes[0x100e] = 0;
+        assert!(parse(&ctx, 0x1000).is_none());
+        assert!(parse(&ctx, u32::MAX - 4).is_none());
+        assert!(parse(&ctx, 0x2ffc).is_none());
+    }
+}
+pub(super) fn draw_bytes(this: u32) -> Vec<u8> {
+    DECLARATIONS
+        .lock()
+        .unwrap()
+        .get(&this)
+        .expect("invalid draw declaration")
+        .bytes
+        .clone()
+}
+
+// FVF subset mapped to D3DVERTEXELEMENT9; blended positions remain unsupported.
+pub(super) fn from_fvf(fvf: u32) -> Option<Vec<u8>> {
+    let position = fvf & 0x400e;
+    let tex = (fvf >> 8) & 15;
+    if !matches!(position, 2 | 4 | 0x4002)
+        || tex > 8
+        || fvf & 0x0000b001 != 0
+        || (position == 4 && fvf & 0x10 != 0)
+    {
+        return None;
+    }
+    if tex < 8 && (fvf >> (16 + tex * 2)) != 0 {
+        return None;
+    }
+    let mut bytes = Vec::new();
+    let mut offset = 0u16;
+    let mut add = |ty: u8, usage: u8, index: u8, size: u16| {
+        bytes.extend_from_slice(&[0, 0, offset as u8, (offset >> 8) as u8, ty, 0, usage, index]);
+        offset += size;
+    };
+    match position {
+        2 => add(2, 0, 0, 12),
+        4 => add(3, 9, 0, 16),
+        0x4002 => add(3, 0, 0, 16),
+        _ => unreachable!(),
+    }
+    if fvf & 0x10 != 0 {
+        add(2, 3, 0, 12);
+    }
+    if fvf & 0x20 != 0 {
+        add(0, 4, 0, 4);
+    }
+    if fvf & 0x40 != 0 {
+        add(4, 10, 0, 4);
+    }
+    if fvf & 0x80 != 0 {
+        add(4, 10, 1, 4);
+    }
+    for i in 0..tex {
+        let n = match (fvf >> (16 + 2 * i)) & 3 {
+            0 => 2,
+            1 => 3,
+            2 => 4,
+            _ => 1,
+        };
+        add(n - 1, 5, i as u8, u16::from(n) * 4);
+    }
+    bytes.extend_from_slice(&END);
+    Some(bytes)
+}
+#[cfg(test)]
+mod fvf_tests {
+    #[test]
+    fn fvf_layout_order_and_dimensions() {
+        assert_eq!(
+            super::from_fvf(0x142).unwrap(),
+            vec![
+                0, 0, 0, 0, 2, 0, 0, 0, 0, 0, 12, 0, 4, 0, 10, 0, 0, 0, 16, 0, 1, 0, 5, 0, 255, 0,
+                0, 0, 17, 0, 0, 0
+            ]
+        );
+        assert!(super::from_fvf(0x114).is_none());
+        assert!(super::from_fvf(0x10006).is_none());
+        assert!(super::from_fvf(0x902).is_none());
+        assert!(super::from_fvf(0x10042).is_none());
+        let b = super::from_fvf(0x30102).unwrap();
+        assert_eq!(b[12], 0);
+    }
+}
diff --git a/win32/winapi/src/d3d9/device.rs b/win32/winapi/src/d3d9/device.rs
