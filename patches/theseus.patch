+ #[win32_derive::dllexport] pub fn AddRef(ctx:&mut Context,this:u32)->u32{d3d9::IDirect3D9::AddRef(ctx,this)}
+ #[win32_derive::dllexport] pub fn Release(ctx:&mut Context,this:u32)->u32{d3d9::IDirect3D9::Release(ctx,this)}
+ pub fn RegisterSoftwareDevice_stdcall(ctx:&mut Context)->runtime::Cont{fail(ctx,"IDirect3D8","RegisterSoftwareDevice")}
+ #[win32_derive::dllexport] pub fn GetAdapterCount(ctx:&mut Context,this:u32)->u32{d3d9::IDirect3D9::GetAdapterCount(ctx,this)}
