+#[win32_derive::dllexport]
+pub fn GetLevelDesc(ctx: &mut Context, this: u32, level: u32, out: u32) -> u32 {
+    let t = texture(this);
+    let Some(m) = t.mips.get(level as usize) else {
+        return D3DERR_INVALIDCALL;
+    };
+    if !valid(ctx, out, 32) {
+        return D3DERR_INVALIDCALL;
+    }
+    for (i, v) in [t.format, 1, t.usage, t.pool, 0, 0, m.width, m.height]
+        .into_iter()
+        .enumerate()
+    {
+        ctx.memory.write::<u32>(out + i as u32 * 4, v)
+    }
+    D3D_OK
+}
+fn lockable(t: &Texture, level: u32, flags: u32) -> bool {
+    let Some(m) = t.mips.get(level as usize) else {
+        return false;
+    };
+    m.locked.is_none()
+        && flags & !0x2810 == 0
+        && !(flags & 0x10 != 0 && flags & 0x2000 != 0)
+        && (t.pool != 0 || t.usage & 0x200 != 0)
+        && (flags & 0x2000 == 0 || t.usage & 0x200 != 0)
