+#[cfg(test)]
+mod freelist_tests {
+    use super::*;
+
+    #[test]
+    fn freeing_above_all_free_nodes_preserves_address_order() {
+        let mut mem = Memory::leak_new(0x4000);
+        let heap = Heap::new(0x1000, 0x1000);
+        let a = heap.alloc(&mut mem, 0x100);
+        let b = heap.alloc(&mut mem, 0x100);
+        let c = heap.alloc(&mut mem, 0xdf4);
+
+        heap.free(&mut mem, a);
+        heap.free(&mut mem, c);
+
+        let free = heap.freelist.borrow();
+        assert_eq!(free.nodes.len(), 2);
+        assert!(free.nodes[0].addr < free.nodes[1].addr);
+        assert_eq!(free.nodes[0].addr, a - 4);
+        assert_eq!(free.nodes[1].addr, c - 4);
