+/// Enumerate the runtime's single virtual canvas display. Refresh 0 means default,
+/// not a measured physical refresh rate. Only the documented five fields change.
+#[win32_derive::dllexport]
+pub fn EnumDisplaySettingsA(ctx: &mut runtime::Context, name: crate::Ptr<u8>, index: u32, mode: crate::Ptr<u8>) -> bool {
+    if name.addr != 0 { panic!("named display enumeration is unsupported"); }
+    if index != 0 && index != 0xffff_ffff && index != 0xffff_fffe { return false; }
+    let addr = mode.addr as usize;
+    if addr < 0x1000 || addr.checked_add(124).is_none_or(|end| end > ctx.memory.bytes.len()) { return false; }
+    let size = ctx.memory.read::<u16>(mode.addr + 36);
+    if size != 0 && size < 124 { return false; }
+    // Older callers sometimes leave dmSize zero. Retain their buffer extent.
+    for (offset, value) in [(104,32u32),(108,1280),(112,720),(116,0),(120,0)] {
+        ctx.memory.write::<u32>(mode.addr + offset,value);
+    }
+    true
+}
