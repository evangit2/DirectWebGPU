+        || top >= bottom
+        || right > m.width
+        || bottom > m.height
+        || left % block != 0
+        || top % block != 0
+        || (right != m.width && right % block != 0)
+        || (bottom != m.height && bottom % block != 0)
+    {
+        return None;
+    }
+    Some(top / block * m.pitch + left / block * bytes)
