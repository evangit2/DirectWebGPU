+//! Direct3D 9 state-block capture, recording, COM lifetime, and application.
+use super::*;
+
+#[derive(Clone)]
+struct StateBlock {
+    refs: u32,
+    device: u32,
+    mask: StateMask,
+    values: StateValues,
+}
+
+static BLOCKS: LazyLock<Mutex<HashMap<u32, StateBlock>>> =
+    LazyLock::new(|| Mutex::new(HashMap::new()));
+
+pub const VTABLE_ENTRIES: [&str; 6] = [
+    "QueryInterface",
+    "AddRef",
+    "Release",
+    "GetDevice",
+    "Capture",
+    "Apply",
+];
+
+const IID_STATE_BLOCK: [u8; 16] = [
+    0xe5, 0x4f, 0x7c, 0xb0, 0x0d, 0x31, 0xa8, 0x4b,
+    0xa2, 0x3c, 0x4f, 0x0f, 0x20, 0x6f, 0x21, 0x8b,
+];
+
+fn block(this: u32) -> StateBlock {
+    BLOCKS.lock().unwrap().get(&this)
+        .expect("invalid/released IDirect3DStateBlock9").clone()
+}
+
+fn create_owned(
+    ctx: &mut Context,
+    owner: u32,
+    mask: StateMask,
+    values: StateValues,
+    resources_retained: bool,
+) -> Result<u32, u32> {
+    let vtable = unsafe { crate::d3d9::IDirect3DStateBlock9::VTABLE };
+    assert!(valid(ctx, vtable, VTABLE_ENTRIES.len() * 4), "state-block vtable missing");
+    let this = kernel32::lock().process_heap.alloc(&mut ctx.memory, 4);
+    if this == 0 {
+        if resources_retained { values.release_resources(ctx, &mask); }
+        return Err(0x8007000e);
+    }
+    if !resources_retained { values.retain_resources(owner, &mask); }
+    ctx.memory.write::<u32>(this, vtable);
+    IDirect3DDevice9::AddRef(ctx, owner);
+    BLOCKS.lock().unwrap().insert(this, StateBlock { refs: 1, device: owner, mask, values });
+    Ok(this)
+}
+
+pub(super) fn create_typed(ctx: &mut Context, owner: u32, kind: u32, out: u32) -> u32 {
+    if !valid(ctx, out, 4) { return D3DERR_INVALIDCALL; }
+    ctx.memory.write::<u32>(out, 0);
+    let current = device(owner);
+    if current.recording.is_some() { return D3DERR_INVALIDCALL; }
+    let Some(mask) = state_mask(kind, &current) else { return D3DERR_INVALIDCALL; };
+    let values = StateValues::capture(&current);
+    match create_owned(ctx, owner, mask, values, false) {
+        Ok(this) => { ctx.memory.write::<u32>(out, this); D3D_OK }
+        Err(error) => error,
+    }
+}
+
+pub(super) fn begin(owner: u32) -> u32 {
+    let current = device(owner);
+    if current.recording.is_some() { return D3DERR_INVALIDCALL; }
+    let recording = Recording { mask: StateMask::default(), values: StateValues::capture(&current) };
+    DEVICES.lock().unwrap().get_mut(&owner).unwrap().recording = Some(recording);
+    D3D_OK
+}
+
+pub(super) fn end(ctx: &mut Context, owner: u32, out: u32) -> u32 {
+    if !valid(ctx, out, 4) { return D3DERR_INVALIDCALL; }
+    ctx.memory.write::<u32>(out, 0);
+    let recording = {
+        let mut devices = DEVICES.lock().unwrap();
+        let device = devices.get_mut(&owner).expect("invalid state-block device");
+        let Some(recording) = device.recording.take() else { return D3DERR_INVALIDCALL; };
+        recording
+    };
+    match create_owned(ctx, owner, recording.mask, recording.values, true) {
+        Ok(this) => { ctx.memory.write::<u32>(out, this); D3D_OK }
+        Err(error) => error,
+    }
+}
+
+fn apply_values(owner: u32, mask: &StateMask, values: &StateValues) -> u32 {
+    {
+        let mut devices = DEVICES.lock().unwrap();
+        let device = devices.get_mut(&owner).expect("invalid state-block device");
+        for state in &mask.render_states {
+            if let Some(value) = values.states.get(state) { device.states.insert(*state, *value); }
+        }
+        for (stage, state) in &mask.texture_stages {
+            device.texture_stages[*stage as usize][texture_stage_slot(*state)] =
+                values.texture_stages[*stage as usize][texture_stage_slot(*state)];
+        }
+        for (stage, state) in &mask.sampler_states {
+            device.samplers[*stage as usize][*state as usize] = values.samplers[*stage as usize][*state as usize];
+        }
+        for transform in &mask.transforms {
+            match values.transforms.get(transform) {
+                Some(value) => { device.transforms.insert(*transform, *value); }
+                None => { device.transforms.remove(transform); }
+            }
+        }
+        for light in &mask.lights {
+            match values.lights.get(light) {
+                Some(value) => { device.lights.insert(*light, *value); }
+                None => { device.lights.remove(light); }
+            }
+        }
+        for light in &mask.light_enabled {
+            match values.light_enabled.get(light) {
+                Some(value) => { device.light_enabled.insert(*light, *value); }
+                None => { device.light_enabled.remove(light); }
+            }
+        }
+        if mask.material { device.material = values.material; }
+        if mask.viewport { device.viewport = values.viewport; }
+        if mask.scissor { device.scissor = values.scissor; }
+    }
+    {
+        let target = device(owner).constants;
+        let mut target = target.lock().unwrap();
+        let source = values.constants.lock().unwrap();
+        target.copy_selected_from(&source, false, super::super::constants::Kind::Float, &mask.constants.vertex_float);
+        target.copy_selected_from(&source, false, super::super::constants::Kind::Int, &mask.constants.vertex_int);
+        target.copy_selected_from(&source, false, super::super::constants::Kind::Bool, &mask.constants.vertex_bool);
+        target.copy_selected_from(&source, true, super::super::constants::Kind::Float, &mask.constants.pixel_float);
+        target.copy_selected_from(&source, true, super::super::constants::Kind::Int, &mask.constants.pixel_int);
+        target.copy_selected_from(&source, true, super::super::constants::Kind::Bool, &mask.constants.pixel_bool);
+    }
+    D3D_OK
+}
+
+fn apply_resources(ctx: &mut Context, owner: u32, mask: &StateMask, values: &StateValues) -> u32 {
+    for stream in &mask.streams {
+        let value = values.streams[*stream as usize];
+        let result = SetStreamSource(ctx, owner, *stream, value.buffer, value.offset, value.stride);
+        if result != D3D_OK { return result; }
+    }
+    if mask.indices {
+        let result = SetIndices(ctx, owner, values.indices);
+        if result != D3D_OK { return result; }
+    }
+    if mask.vertex_input {
+        let result = if values.fvf != 0 {
+            SetFVF(ctx, owner, values.fvf)
+        } else {
+            SetVertexDeclaration(ctx, owner, values.declaration)
+        };
+        if result != D3D_OK { return result; }
+    }
+    for stage in 0..2 {
+        if mask.shaders[stage] {
+            let result = if stage == 0 {
+                SetVertexShader(ctx, owner, values.shaders[stage])
+            } else {
+                SetPixelShader(ctx, owner, values.shaders[stage])
+            };
+            if result != D3D_OK { return result; }
+        }
+    }
+    for stage in &mask.textures {
+        let result = SetTexture(ctx, owner, *stage, values.textures[*stage as usize]);
+        if result != D3D_OK { return result; }
+    }
+    D3D_OK
+}
+
+#[win32_derive::dllexport]
+pub fn QueryInterface(ctx: &mut Context, this: u32, iid: u32, out: u32) -> u32 {
+    block(this);
+    if !valid(ctx, out, 4) { return E_POINTER; }
+    ctx.memory.write::<u32>(out, 0);
+    if !valid(ctx, iid, 16) { return E_POINTER; }
+    let id = &ctx.memory.bytes[iid as usize..iid as usize + 16];
+    if id != IID_UNKNOWN && id != IID_STATE_BLOCK { return E_NOINTERFACE; }
+    AddRef(ctx, this);
+    ctx.memory.write::<u32>(out, this);
+    D3D_OK
+}
+
+#[win32_derive::dllexport]
+pub fn AddRef(_ctx: &mut Context, this: u32) -> u32 {
+    let mut blocks = BLOCKS.lock().unwrap();
+    let block = blocks.get_mut(&this).expect("invalid state-block AddRef");
+    block.refs = block.refs.checked_add(1).expect("state-block ref overflow");
+    block.refs
+}
+
+#[win32_derive::dllexport]
+pub fn Release(ctx: &mut Context, this: u32) -> u32 {
+    let removed = {
+        let mut blocks = BLOCKS.lock().unwrap();
+        let block = blocks.get_mut(&this).expect("invalid state-block Release");
+        block.refs -= 1;
+        if block.refs != 0 { return block.refs; }
+        blocks.remove(&this).unwrap()
+    };
+    removed.values.release_resources(ctx, &removed.mask);
+    IDirect3DDevice9::Release(ctx, removed.device);
+    ctx.memory.write::<u32>(this, 0);
+    kernel32::lock().process_heap.free(&mut ctx.memory, this);
+    0
+}
+
+#[win32_derive::dllexport]
+pub fn GetDevice(ctx: &mut Context, this: u32, out: u32) -> u32 {
+    let block = block(this);
+    if !valid(ctx, out, 4) { return D3DERR_INVALIDCALL; }
+    IDirect3DDevice9::AddRef(ctx, block.device);
+    ctx.memory.write::<u32>(out, block.device);
+    D3D_OK
+}
+
+#[win32_derive::dllexport]
+pub fn Capture(ctx: &mut Context, this: u32) -> u32 {
+    let block = block(this);
+    let current = device(block.device);
+    if current.recording.is_some() { return D3DERR_INVALIDCALL; }
+    let values = StateValues::capture(&current);
+    values.retain_resources(block.device, &block.mask);
+    let old = {
+        let mut blocks = BLOCKS.lock().unwrap();
+        std::mem::replace(&mut blocks.get_mut(&this).unwrap().values, values)
+    };
+    old.release_resources(ctx, &block.mask);
+    D3D_OK
+}
+
+#[win32_derive::dllexport]
+pub fn Apply(ctx: &mut Context, this: u32) -> u32 {
+    let block = block(this);
+    if recording_active(block.device) { return D3DERR_INVALIDCALL; }
+    let result = apply_values(block.device, &block.mask, &block.values);
+    if result != D3D_OK { return result; }
+    apply_resources(ctx, block.device, &block.mask, &block.values)
+}
