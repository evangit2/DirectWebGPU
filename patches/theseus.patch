+//! Bounded user-pointer vertex normalization; no rasterization or geometry replacement.
+pub struct Prepared{pub kind:u32,pub stride:u32,pub declaration:Vec<u8>,pub bytes:Vec<u8>}
+pub fn vertex_count(kind:u32,primitives:u32)->Option<u32>{
+ if primitives==0||primitives>349525{return None;}
+ match kind{1=>Some(primitives),2=>primitives.checked_mul(2),3=>primitives.checked_add(1),4=>primitives.checked_mul(3),5|6=>primitives.checked_add(2),_=>None}
+}
+pub fn prepare(kind:u32,primitives:u32,stride:u32,declaration:&[u8],source:&[u8])->Option<Prepared>{
+ let count=vertex_count(kind,primitives)?;
+ if stride==0||stride>2048||stride%4!=0||source.len()!=count.checked_mul(stride)? as usize||source.len()>16*1024*1024||declaration.len()<16||declaration.len()>520||declaration.len()%8!=0{return None;}
+ let end=[255,0,0,0,17,0,0,0];if declaration[declaration.len()-8..]!=end{return None;}
+ let mut layout=Vec::new();let mut fields=Vec::new();let mut width=0u32;
+ for e in declaration[..declaration.len()-8].chunks_exact(8){
+  let offset=u16::from_le_bytes([e[2],e[3]])as u32;let ty=e[4];
+  if e[0]!=0||e[1]!=0||ty>4||e[5]!=0||offset%4!=0{return None;}
+  let input=if ty==4{4}else{4*(ty as u32+1)};let output=if ty==4{16}else{input};
+  if offset.checked_add(input)?>stride||width+output>2048{return None;}
+  let mut normalized=e.to_vec();normalized[2..4].copy_from_slice(&(width as u16).to_le_bytes());if ty==4{normalized[4]=3;}layout.extend_from_slice(&normalized);
+  fields.push((offset as usize,input as usize,ty));width+=output;
+ }
+ layout.extend_from_slice(&end);
+ let output_kind=match kind{3=>2,5|6=>4,_=>kind};let factor=match output_kind{1=>1,2=>2,4=>3,_=>return None};
+ let bytes_len=primitives.checked_mul(factor)?.checked_mul(width)?as usize;if bytes_len>16*1024*1024{return None;}
+ let mut bytes=Vec::with_capacity(bytes_len);
+ for i in 0..primitives*factor{
+  let vertex=match kind{3=>i/2+i%2,5=>{let triangle=i/3;let corner=i%3;triangle+if triangle%2==1&&corner<2{1-corner}else{corner}},6=>{let corner=i%3;if corner==0{0}else{i/3+corner}},_=>i};
+  let start=(vertex*stride)as usize;
+  for &(offset,input,ty) in &fields{
+   let raw=&source[start+offset..start+offset+input];
+   if ty==4{for channel in [raw[2],raw[1],raw[0],raw[3]]{bytes.extend_from_slice(&(channel as f32/255.0).to_le_bytes());}}
+   else{bytes.extend_from_slice(raw);}
+  }
+ }
+ Some(Prepared{kind:output_kind,stride:width,declaration:layout,bytes})
+}
+#[cfg(test)]mod tests{
+ use super::*;
+ #[test]fn fan_color_and_input_bounds(){
+  let declaration=crate::d3d9::IDirect3DVertexDeclaration9::from_fvf(0x142).unwrap();
+  let mut source=Vec::new();for i in 0..4{source.extend_from_slice(&(i as f32).to_le_bytes());source.extend_from_slice(&[0;8]);source.extend_from_slice(&[0x11,0x22,0x33,0x44]);source.extend_from_slice(&[0;8]);}
+  let p=prepare(6,2,24,&declaration,&source).unwrap();assert_eq!((p.kind,p.stride,p.bytes.len()),(4,36,216));
+  for (record,id) in p.bytes.chunks_exact(36).zip([0.,1.,2.,0.,2.,3.]){assert_eq!(f32::from_le_bytes(record[..4].try_into().unwrap()),id);for (offset,value) in [(12,0x33),(16,0x22),(20,0x11),(24,0x44)]{assert_eq!(f32::from_le_bytes(record[offset..offset+4].try_into().unwrap()),value as f32/255.);}}
+  assert_eq!(&p.declaration[10..13],&[12,0,3]);assert_eq!(&p.declaration[18..20],&[28,0]);
+  assert!(prepare(6,2,24,&declaration,&source[..95]).is_none());assert!(prepare(6,u32::MAX,24,&declaration,&source).is_none());
+  let mut invalid=declaration.clone();invalid[0]=1;assert!(prepare(6,2,24,&invalid,&source).is_none());
+ }
+ #[test]fn strip_winding_and_line_segments(){
+  let decl=[0,0,0,0,0,0,0,0,255,0,0,0,17,0,0,0];let source:Vec<u8>=(0u32..5).flat_map(u32::to_le_bytes).collect();
+  let p=prepare(5,3,4,&decl,&source).unwrap();let ids:Vec<u32>=p.bytes.chunks_exact(4).map(|b|u32::from_le_bytes(b.try_into().unwrap())).collect();assert_eq!(ids,[0,1,2,2,1,3,2,3,4]);
+  let p=prepare(3,4,4,&decl,&source).unwrap();let ids:Vec<u32>=p.bytes.chunks_exact(4).map(|b|u32::from_le_bytes(b.try_into().unwrap())).collect();assert_eq!(ids,[0,1,1,2,2,3,3,4]);
+ }
+}
