+// Explicit fatal imports pending implementation. Generated from compiler diagnostics.
+#[win32_derive::dllexport]
+pub fn CreateFileMappingA(
+    _ctx: &mut runtime::Context,
+    hFile: crate::HANDLE,
+    _attributes: u32,
+    _protect: u32,
+    maximum_size_high: u32,
+    maximum_size_low: u32,
+    _name: u32,
+) -> crate::HANDLE {
+    use std::io::{Read, Seek, SeekFrom};
+
+    const MAX_MAPPING_BYTES: usize = 64 << 20;
+    let requested = ((maximum_size_high as u64) << 32 | maximum_size_low as u64)
+        .min(MAX_MAPPING_BYTES as u64) as usize;
+    let mut bytes = Vec::new();
+    let mut kernel32 = crate::kernel32::lock();
+    if let Some(crate::kernel32::Object::File(file)) = kernel32.objects.get_mut(hFile) {
+        let position = file.stream_position().unwrap_or(0);
+        let _ = file.seek(SeekFrom::Start(0));
+        let _ = file.read_to_end(&mut bytes);
+        let _ = file.seek(SeekFrom::Start(position));
+    }
+    // A zero maximum size means "the current file length" for a file-backed
+    // mapping. Anonymous callers still receive a bounded page, matching the
+    // minimum useful view size for old loaders.
+    let size = if requested == 0 { bytes.len().max(4096) } else { requested };
+    let size = size.min(MAX_MAPPING_BYTES);
+    bytes.truncate(size);
+    bytes.resize(size, 0);
+    kernel32.objects.add(crate::kernel32::Object::FileMapping(crate::kernel32::FileMapping { bytes }))
+}
