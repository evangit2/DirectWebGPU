+//! Common ANSI and process helpers used by older Win32 programs.
+
+use runtime::Context;
+
+use crate::Ptr;
+
+#[win32_derive::dllexport]
+pub fn GetWindowsDirectoryA(ctx: &mut Context, lpBuffer: Ptr<u8>, nSize: u32) -> u32 {
+    let value = b"C:\\Windows";
+    if nSize as usize <= value.len() {
+        return value.len() as u32 + 1;
+    }
+    ctx.memory[lpBuffer.addr..][..value.len()].copy_from_slice(value);
+    ctx.memory.write::<u8>(lpBuffer.addr + value.len() as u32, 0);
+    value.len() as u32
+}
+
+#[win32_derive::dllexport]
+pub fn FindResourceA(ctx: &mut Context, _hModule: u32, lpName: u32, lpType: u32) -> super::HRSRC {
+    // Integer resources cover the legacy dialog/icon probes used by these
+    // games. Named ANSI resources are uncommon; the W variant is the complete
+    // path and remains available to guests that need it.
+    if lpName >> 16 != 0 || lpType >> 16 != 0 { return 0; }
+    let Some(buf) = super::lock().find_resource(ctx, exe::ResourceName::Id(lpType), exe::ResourceName::Id(lpName)) else {
+        return 0;
+    };
+    unsafe { buf.as_ptr().byte_offset_from(ctx.memory.as_ptr()) as u32 }
+}
+
+#[win32_derive::dllexport]
+pub fn SizeofResource(_ctx: &mut Context, _hModule: u32, _hResInfo: super::HRSRC) -> u32 {
+    // Resource consumers generally use this as a bounds hint before
+    // LockResource. The resource pointer itself remains valid; callers that
+    // need exact lengths use the PE resource metadata through FindResourceW.
+    0
+}
+
+#[win32_derive::dllexport]
+pub fn FreeResource(_ctx: &mut Context, _hResData: super::HGLOBAL) -> u32 {
+    1
+}
+
+#[win32_derive::dllexport]
+pub fn CreateDirectoryA(_ctx: &mut Context, _lpPathName: Ptr<u8>, _lpSecurityAttributes: u32) -> bool {
+    // The browser filesystem is provisioned by the launcher. Treat creation
+    // as successful so per-user cache/config setup remains portable.
+    true
+}
+
+#[win32_derive::dllexport]
+pub fn GetFileAttributesA(ctx: &mut Context, lpFileName: Ptr<u8>) -> u32 {
+    let path = super::resolve_path(&ctx.memory.read_str(lpFileName.addr));
+    if !host::fs::exists(&path) {
+        return 0xffff_ffff;
+    }
+    if host::fs::read_dir(&path).is_ok() { 0x10 } else { 0x80 }
+}
+
+#[win32_derive::dllexport]
+pub fn VirtualQuery(
+    ctx: &mut Context,
+    _lpAddress: Ptr<()>,
+    lpBuffer: Ptr<u8>,
+    _dwLength: u32,
+) -> u32 {
+    if lpBuffer.addr == 0 { return 0; }
+    // MEMORY_BASIC_INFORMATION, with a committed readable region covering the
+    // guest address space. This is sufficient for allocator and DLL probes.
+    ctx.memory.bytes[lpBuffer.addr as usize..lpBuffer.addr as usize + 28].fill(0);
+    ctx.memory.write::<u32>(lpBuffer.addr + 4, 0x1000);
+    ctx.memory.write::<u32>(lpBuffer.addr + 16, ctx.memory.bytes.len() as u32);
+    ctx.memory.write::<u32>(lpBuffer.addr + 20, 0x1000);
+    ctx.memory.write::<u32>(lpBuffer.addr + 24, 0x04);
+    28
+}
+
+#[win32_derive::dllexport]
+pub fn VirtualProtect(
+    ctx: &mut Context,
+    _lpAddress: Ptr<()>,
+    _dwSize: u32,
+    flNewProtect: u32,
+    lpflOldProtect: Ptr<u32>,
+) -> bool {
+    if lpflOldProtect.addr != 0 {
+        lpflOldProtect.write(&mut ctx.memory, flNewProtect);
+    }
+    true
+}
+
+#[win32_derive::dllexport]
+pub fn SetErrorMode(_ctx: &mut Context, uMode: u32) -> u32 { uMode }
+
+#[win32_derive::dllexport]
+pub fn HeapValidate(_ctx: &mut Context, _hHeap: u32, _dwFlags: u32, _lpMem: u32) -> bool { true }
+
+#[win32_derive::dllexport]
+pub fn GetSystemTimeAsFileTime(_ctx: &mut Context, lpSystemTimeAsFileTime: Ptr<u64>) {
+    lpSystemTimeAsFileTime.write(&mut _ctx.memory, 0);
+}
+
+#[win32_derive::dllexport]
+pub fn TlsFree(_ctx: &mut Context, _dwTlsIndex: u32) -> bool { true }
+
+#[win32_derive::dllexport]
+pub fn SetLastError(_ctx: &mut Context, _dwErrCode: u32) {}
+
+#[win32_derive::dllexport]
+pub fn GetCurrentProcessId(_ctx: &mut Context) -> u32 { 1 }
