+//! COM views of device-owned GPU attachments. External refs retain the device.
+use super::*;
+#[derive(Clone)]
+struct Surface{refs:u32,device:u32,desc:[u32;8]}
+static SURFACES:LazyLock<Mutex<HashMap<u32,Surface>>>=LazyLock::new(||Mutex::new(HashMap::new()));
+pub static mut VTABLE:u32=0;
+const IID_SURFACE:[u8;16]=[0x3a,0xaf,0xfb,0x0c,0xf6,0x9f,0x9a,0x42,0x99,0xb3,0xa2,0x79,0x6a,0xf8,0xb8,0x9b];
+const IID_RESOURCE:[u8;16]=[0x5d,0xc0,0xee,0x05,0x7d,0x8f,0x62,0x43,0xb9,0x99,0xd1,0xba,0xf3,0x57,0xc7,0x04];
+pub const VTABLE_ENTRIES:[&str;17]=["QueryInterface","AddRef","Release","GetDevice","SetPrivateData","GetPrivateData","FreePrivateData","SetPriority","GetPriority","PreLoad","GetType","GetContainer","GetDesc","LockRect","UnlockRect","GetDC","ReleaseDC"];
+fn surface(this:u32)->Surface{SURFACES.lock().unwrap().get(&this).expect("invalid/released surface").clone()}
+pub fn create_owned(ctx:&mut Context,owner:u32,width:u32,height:u32,format:u32,usage:u32)->u32{
+ let vt=unsafe{VTABLE};assert!(valid(ctx,vt,17*4),"surface vtable missing");let p=kernel32::lock().process_heap.alloc(&mut ctx.memory,4);ctx.memory.write::<u32>(p,vt);
+ assert!(SURFACES.lock().unwrap().insert(p,Surface{refs:0,device:owner,desc:[format,1,usage,0,0,0,width,height]}).is_none());p
+}
+pub fn destroy_owned(ctx:&mut Context,this:u32){let s=SURFACES.lock().unwrap().remove(&this).expect("invalid owned surface");assert_eq!(s.refs,0);ctx.memory.write::<u32>(this,0);kernel32::lock().process_heap.free(&mut ctx.memory,this);}
+#[win32_derive::dllexport]
+pub fn QueryInterface(ctx:&mut Context,this:u32,iid:u32,out:u32)->u32{surface(this);if !valid(ctx,out,4){return E_POINTER}ctx.memory.write::<u32>(out,0);if !valid(ctx,iid,16){return E_POINTER}let id=&ctx.memory.bytes[iid as usize..iid as usize+16];if id!=IID_UNKNOWN&&id!=IID_SURFACE&&id!=IID_RESOURCE{return E_NOINTERFACE}AddRef(ctx,this);ctx.memory.write::<u32>(out,this);D3D_OK}
+#[win32_derive::dllexport]
+pub fn AddRef(ctx:&mut Context,this:u32)->u32{let mut map=SURFACES.lock().unwrap();let s=map.get_mut(&this).expect("invalid surface AddRef");s.refs=s.refs.checked_add(1).expect("surface ref overflow");let n=s.refs;let owner=s.device;drop(map);IDirect3DDevice9::AddRef(ctx,owner);n}
+#[win32_derive::dllexport]
+pub fn Release(ctx:&mut Context,this:u32)->u32{let mut map=SURFACES.lock().unwrap();let s=map.get_mut(&this).expect("invalid surface Release");assert!(s.refs>0);s.refs-=1;let n=s.refs;let owner=s.device;drop(map);IDirect3DDevice9::Release(ctx,owner);n}
+#[win32_derive::dllexport]
+pub fn GetDevice(ctx:&mut Context,this:u32,out:u32)->u32{let s=surface(this);if !valid(ctx,out,4){return D3DERR_INVALIDCALL}IDirect3DDevice9::AddRef(ctx,s.device);ctx.memory.write::<u32>(out,s.device);D3D_OK}
+#[win32_derive::dllexport]
+pub fn GetType(_ctx:&mut Context,this:u32)->u32{surface(this);1}
+#[win32_derive::dllexport]
+pub fn GetDesc(ctx:&mut Context,this:u32,out:u32)->u32{let s=surface(this);if !valid(ctx,out,32){return D3DERR_INVALIDCALL}for(i,v)in s.desc.into_iter().enumerate(){ctx.memory.write::<u32>(out+i as u32*4,v);}D3D_OK}
