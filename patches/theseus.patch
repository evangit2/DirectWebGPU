+// Per-WASM-instance virtual registry. No host registry access or cross-launch persistence.
+use std::{
+    collections::HashMap,
+    sync::{LazyLock, Mutex},
+};
+#[derive(Default)]
+struct Registry {
+    keys: HashMap<String, HashMap<String, (u32, Vec<u8>)>>,
+    handles: HashMap<u32, (String, u32)>,
+    next: u32,
+    bytes: usize,
+}
+static REGISTRY: LazyLock<Mutex<Registry>> = LazyLock::new(|| {
+    Mutex::new(Registry {
+        next: 0x10000,
+        ..Default::default()
+    })
+});
+fn range(ctx: &Context, p: u32, n: usize) -> bool {
+    p >= 0x1000
+        && (p as usize)
+            .checked_add(n)
+            .is_some_and(|end| end <= ctx.memory.bytes.len())
+}
+fn name(ctx: &Context, p: u32) -> Result<String, u32> {
+    if p == 0 {
+        return Ok(String::new());
+    }
+    if !range(ctx, p, 1) {
+        return Err(87);
+    }
+    let bytes = &ctx.memory.bytes[p as usize..];
+    let Some(n) = bytes.iter().take(4097).position(|&b| b == 0) else {
+        return Err(87);
+    };
+    if !bytes[..n].is_ascii() {
+        return Err(50);
+    }
+    Ok(String::from_utf8(bytes[..n].to_vec())
+        .unwrap()
+        .to_ascii_lowercase())
+}
+fn key(r: &Registry, h: u32) -> Result<(String, u32), u32> {
+    if (0x80000000..=0x80000003).contains(&h) {
+        return Ok((format!("{h:08x}"), 0xf003f));
+    }
+    r.handles.get(&h).cloned().ok_or(6)
+}
+fn open_key(
+    ctx: &mut Context,
+    h: u32,
+    sub: u32,
+    access: u32,
+    out: u32,
+    disposition: u32,
+    create: bool,
+) -> u32 {
+    if !range(ctx, out, 4) || (disposition != 0 && !range(ctx, disposition, 4)) {
+        return 87;
+    }
+    if access & !0xf023f != 0 {
+        return 50;
+    }
+    let sub = match name(ctx, sub) {
+        Ok(n) => n,
+        Err(e) => return e,
+    };
+    let mut r = REGISTRY.lock().unwrap();
+    let (base, rights) = match key(&r, h) {
+        Ok(k) => k,
+        Err(e) => return e,
+    };
+    if create && rights & 4 == 0 {
+        return 5;
+    }
+    let path = if sub.is_empty() {
+        base
+    } else {
+        format!("{}\\{}", base, sub.trim_matches('\\'))
+    };
+    let existed = r.keys.contains_key(&path);
+    if !existed && !create {
+        return ERROR_FILE_NOT_FOUND;
+    }
+    if r.handles.len() >= 4096 || (!existed && r.keys.len() >= 4096) {
+        return 8;
+    }
+    if !existed {
+        r.keys.insert(path.clone(), HashMap::new());
+    }
+    let handle = r.next;
+    r.next = r.next.checked_add(1).expect("registry handle exhaustion");
+    r.handles.insert(handle, (path.clone(), access));
+    ctx.memory.write::<u32>(out, handle);
+    if disposition != 0 {
+        ctx.memory
+            .write::<u32>(disposition, if existed { 2 } else { 1 });
+    }
+    log::info!(
+        "VIRTUAL_REGISTRY_OPEN path={path} handle={handle:#x} created={}",
+        !existed
+    );
+    0
+}
+#[win32_derive::dllexport]
+pub fn RegCreateKeyExA(
+    ctx: &mut Context,
+    hKey: u32,
+    lpSubKey: u32,
+    Reserved: u32,
+    lpClass: u32,
+    dwOptions: u32,
+    samDesired: u32,
+    lpSecurityAttributes: u32,
+    phkResult: u32,
+    lpdwDisposition: u32,
+) -> u32 {
+    if Reserved != 0 {
+        return 87;
+    }
+    if dwOptions > 1 || lpSecurityAttributes != 0 {
+        return 50;
+    }
+    if let Err(e) = name(ctx, lpClass) {
+        return e;
+    }
+    open_key(
+        ctx,
+        hKey,
+        lpSubKey,
+        samDesired,
+        phkResult,
+        lpdwDisposition,
+        true,
+    )
+}
+#[win32_derive::dllexport]
+pub fn RegOpenKeyExA(
+    ctx: &mut Context,
+    hKey: u32,
+    lpSubKey: u32,
+    ulOptions: u32,
+    samDesired: u32,
+    phkResult: u32,
+) -> u32 {
+    if ulOptions != 0 {
+        return 87;
+    }
+    open_key(ctx, hKey, lpSubKey, samDesired, phkResult, 0, false)
+}
+#[win32_derive::dllexport]
+pub fn RegCloseKey(_ctx: &mut Context, hKey: u32) -> u32 {
+    if (0x80000000..=0x80000003).contains(&hKey) {
+        return 0;
+    }
+    if REGISTRY.lock().unwrap().handles.remove(&hKey).is_some() {
+        0
+    } else {
+        6
+    }
+}
+#[win32_derive::dllexport]
+pub fn RegSetValueExA(
+    ctx: &mut Context,
+    hKey: u32,
+    lpValueName: u32,
+    Reserved: u32,
+    dwType: u32,
+    lpData: u32,
+    cbData: u32,
+) -> u32 {
+    if Reserved != 0 || (cbData != 0 && !range(ctx, lpData, cbData as usize)) {
+        return 87;
+    }
+    if cbData > 65536 {
+        return 8;
+    }
+    if !matches!(dwType, 1 | 3 | 4 | 7) {
+        return 50;
+    }
+    if dwType == 4 && cbData != 4 {
+        return 87;
+    }
+    let n = match name(ctx, lpValueName) {
+        Ok(n) => n,
+        Err(e) => return e,
+    };
+    let data = if cbData == 0 {
+        vec![]
+    } else {
+        ctx.memory.bytes[lpData as usize..lpData as usize + cbData as usize].to_vec()
+    };
+    let mut r = REGISTRY.lock().unwrap();
+    let (path, rights) = match key(&r, hKey) {
+        Ok(k) => k,
+        Err(e) => return e,
+    };
+    if rights & 2 == 0 {
+        return 5;
+    }
+    let Some(values) = r.keys.get(&path) else {
+        return 6;
+    };
+    let old = values.get(&n).map_or(0, |v| v.1.len());
+    if r.bytes - old + data.len() > 1048576
+        || (!values.contains_key(&n) && r.keys.values().map(|v| v.len()).sum::<usize>() >= 4096)
+    {
+        return 8;
+    }
+    r.bytes = r.bytes - old + data.len();
+    r.keys
+        .get_mut(&path)
+        .unwrap()
+        .insert(n.clone(), (dwType, data));
+    log::info!("VIRTUAL_REGISTRY_SET path={path} name={n} type={dwType} bytes={cbData}");
+    0
+}
+#[win32_derive::dllexport]
+pub fn RegQueryValueExA(
+    ctx: &mut Context,
+    hKey: u32,
+    lpValueName: u32,
+    lpReserved: u32,
+    lpType: u32,
+    lpData: u32,
+    lpcbData: u32,
+) -> u32 {
+    if lpReserved != 0
+        || (lpType != 0 && !range(ctx, lpType, 4))
+        || (lpcbData != 0 && !range(ctx, lpcbData, 4))
+        || (lpData != 0 && lpcbData == 0)
+    {
+        return 87;
+    }
+    let n = match name(ctx, lpValueName) {
+        Ok(n) => n,
+        Err(e) => return e,
+    };
+    let r = REGISTRY.lock().unwrap();
+    let (path, rights) = match key(&r, hKey) {
+        Ok(k) => k,
+        Err(e) => return e,
+    };
+    if rights & 1 == 0 {
+        return 5;
+    }
+    let Some((kind, data)) = r.keys.get(&path).and_then(|v| v.get(&n)) else {
+        return ERROR_FILE_NOT_FOUND;
+    };
+    let cap = if lpcbData != 0 {
+        ctx.memory.read::<u32>(lpcbData) as usize
+    } else {
+        0
+    };
+    if lpData != 0 && cap >= data.len() && !range(ctx, lpData, data.len()) {
+        return 87;
+    }
+    if lpType != 0 {
+        ctx.memory.write::<u32>(lpType, *kind);
+    }
+    if lpcbData != 0 {
+        ctx.memory.write::<u32>(lpcbData, data.len() as u32);
+    }
+    if lpData != 0 {
+        if cap < data.len() {
+            return 234;
+        }
+        ctx.memory.bytes[lpData as usize..lpData as usize + data.len()].copy_from_slice(data);
+    }
+    0
+}
