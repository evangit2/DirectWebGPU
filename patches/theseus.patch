+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn com_identity_lifetime_modes_and_stdcall_stack() {
+        crate::trace::init("");
+        kernel32::init_state(0x400000,0..0);
+        kernel32::lock().process_heap=crate::heap::Heap::new(0x2000,0x4000);
+        let mut ctx=runtime::Context {cpu:Default::default(), thread_handle:1, thread_id:1, memory:runtime::Memory::leak_new(0x10000), blocks:&[(runtime::RETURN_FROM_X86_ADDR32, runtime::Context::return_from_x86)],cache:Default::default(),recent:[runtime::Context::return_from_x86;4]};
+        unsafe {IDirect3D9::VTABLE=0x1000;}
+        ctx.cpu.regs.esp=0xf000;
+        let original_sp=ctx.cpu.regs.esp;
+        ctx.call32_x86(runtime::Cont(Direct3DCreate9_stdcall),vec![31]);
+        assert_eq!(ctx.cpu.regs.esp,original_sp);
+        let obj=ctx.cpu.regs.eax;assert_ne!(obj,0);
+        assert_eq!(ctx.memory.read::<u32>(obj),0x1000);
+        ctx.memory.bytes[0x1100..0x1110].copy_from_slice(&IID_UNKNOWN);
+        // Invoke the actual generated stdcall adapter and verify cleanup/return value.
+        ctx.call32_x86(runtime::Cont(IDirect3D9::QueryInterface_stdcall),vec![obj,0x1100,0x1200]);
+        assert_eq!(ctx.cpu.regs.esp,original_sp);assert_eq!(ctx.cpu.regs.eax,D3D_OK);
+        assert_eq!(ctx.memory.read::<u32>(0x1200),obj);
+        ctx.memory.bytes[0x1100..0x1110].fill(0xff);
+        assert_eq!(IDirect3D9::QueryInterface(&mut ctx,obj,0x1100,0x1200),E_NOINTERFACE);
+        assert_eq!(ctx.memory.read::<u32>(0x1200),0);
+        assert_eq!(IDirect3D9::GetAdapterDisplayMode(&mut ctx,obj,0,0xfffffff8),D3DERR_INVALIDCALL);
+        assert_eq!(IDirect3D9::GetAdapterDisplayMode(&mut ctx,obj,1,0x1300),D3DERR_INVALIDCALL);
+        assert_eq!(IDirect3D9::GetAdapterDisplayMode(&mut ctx,obj,0,0x1300),D3D_OK);
+        assert_eq!(ctx.memory.read::<u32>(0x1300),1280);
+        unsafe {IDirect3DDevice9::VTABLE=0x1800;IDirect3DSurface9::VTABLE=0x1a00;}
+        let dev=IDirect3DDevice9::create(&mut ctx,obj,1,1,0x40,800,600,21);
+        assert_eq!(IDirect3DDevice9::BeginScene(&mut ctx,dev),D3D_OK);
+        assert_eq!(IDirect3DDevice9::BeginScene(&mut ctx,dev),D3DERR_INVALIDCALL);
+        assert_eq!(IDirect3DDevice9::EndScene(&mut ctx,dev),D3D_OK);
+        assert_eq!(IDirect3DDevice9::EndScene(&mut ctx,dev),D3DERR_INVALIDCALL);
+        assert_eq!(IDirect3DDevice9::GetDirect3D(&mut ctx,dev,0x1200),D3D_OK);
+        assert_eq!(ctx.memory.read::<u32>(0x1200),obj);IDirect3D9::Release(&mut ctx,obj);
+        assert_eq!(IDirect3DDevice9::SetRenderState(&mut ctx,dev,137,0),D3D_OK);
+        assert_eq!(IDirect3DDevice9::GetRenderState(&mut ctx,dev,137,0x1200),D3D_OK);assert_eq!(ctx.memory.read::<u32>(0x1200),0);
+        assert_eq!(IDirect3DDevice9::GetRenderTarget(&mut ctx,dev,0,0x1200),D3D_OK);
+        let surface=ctx.memory.read::<u32>(0x1200);
+        assert_eq!(IDirect3DDevice9::Release(&mut ctx,dev),1); // Surface keeps device alive.
+        assert_eq!(IDirect3DSurface9::GetDesc(&mut ctx,surface,0x1600),D3D_OK);
+        assert_eq!(ctx.memory.read::<u32>(0x1618),800);assert_eq!(ctx.memory.read::<u32>(0x161c),600);
+        assert_eq!(IDirect3DSurface9::GetDevice(&mut ctx,surface,0x1200),D3D_OK);assert_eq!(ctx.memory.read::<u32>(0x1200),dev);
+        assert_eq!(IDirect3DSurface9::Release(&mut ctx,surface),0);
+        assert_eq!(IDirect3DDevice9::AddRef(&mut ctx,dev),2);
+        assert_eq!(IDirect3DDevice9::Release(&mut ctx,dev),1);
+        assert_eq!(IDirect3DDevice9::Release(&mut ctx,dev),0);
+        assert_eq!(ctx.memory.read::<u32>(dev),0);
+        ctx.memory.bytes[0x1400..0x1530].fill(0xa5);
+        ctx.call32_x86(runtime::Cont(IDirect3D9::GetDeviceCaps_stdcall),vec![obj,0,1,0x1400]);
+        assert_eq!(ctx.cpu.regs.esp,original_sp);assert_eq!(ctx.cpu.regs.eax,D3DERR_NOTAVAILABLE);
+        assert!(ctx.memory.bytes[0x1400..0x1530].iter().all(|b|*b==0xa5));
+        assert_eq!(IDirect3D9::GetDeviceCaps(&mut ctx,obj,0,1,0),D3DERR_INVALIDCALL);
+        assert_eq!(IDirect3D9::Release(&mut ctx,obj),1);
+        assert_eq!(IDirect3D9::Release(&mut ctx,obj),0);
+        assert_eq!(ctx.memory.read::<u32>(obj),0);
+        assert!(!OBJECTS.lock().unwrap().contains_key(&obj));
+    }
+}
