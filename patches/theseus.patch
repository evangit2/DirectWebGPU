--- /dev/null
+++ b/win32/winapi/src/d3d9/surface.rs
@@ -0,0 +1,249 @@
+//! COM views of device-owned GPU attachments. External refs retain the device.
+use super::*;
+#[derive(Clone)]
+struct Surface {
+    refs: u32,
+    device: u32,
+    desc: [u32; 8],
+    texture: Option<(u32, u32)>,
+}
+static SURFACES: LazyLock<Mutex<HashMap<u32, Surface>>> =
+    LazyLock::new(|| Mutex::new(HashMap::new()));
+pub static mut VTABLE: u32 = 0;
+const IID_SURFACE: [u8; 16] = [
+    0x3a, 0xaf, 0xfb, 0x0c, 0xf6, 0x9f, 0x9a, 0x42, 0x99, 0xb3, 0xa2, 0x79, 0x6a, 0xf8, 0xb8, 0x9b,
+];
+const IID_RESOURCE: [u8; 16] = [
+    0x5d, 0xc0, 0xee, 0x05, 0x7d, 0x8f, 0x62, 0x43, 0xb9, 0x99, 0xd1, 0xba, 0xf3, 0x57, 0xc7, 0x04,
+];
+pub const VTABLE_ENTRIES: [&str; 17] = [
+    "QueryInterface",
+    "AddRef",
+    "Release",
+    "GetDevice",
+    "SetPrivateData",
+    "GetPrivateData",
+    "FreePrivateData",
+    "SetPriority",
+    "GetPriority",
+    "PreLoad",
+    "GetType",
+    "GetContainer",
+    "GetDesc",
+    "LockRect",
+    "UnlockRect",
+    "GetDC",
+    "ReleaseDC",
+];
+fn surface(this: u32) -> Surface {
+    SURFACES
+        .lock()
+        .unwrap()
+        .get(&this)
+        .expect("invalid/released surface")
+        .clone()
+}
+
+pub(crate) fn texture_backing(this: u32) -> Option<(u32, u32)> {
+    surface(this).texture
+}
+
+pub(crate) fn dimensions(this: u32) -> (u32, u32) {
+    let s = surface(this);
+    (s.desc[6], s.desc[7])
+}
+pub fn create_owned(
+    ctx: &mut Context,
+    owner: u32,
+    width: u32,
+    height: u32,
+    format: u32,
+    usage: u32,
+) -> u32 {
+    let vt = unsafe { VTABLE };
+    assert!(valid(ctx, vt, 17 * 4), "surface vtable missing");
+    let p = kernel32::lock().process_heap.alloc(&mut ctx.memory, 4);
+    ctx.memory.write::<u32>(p, vt);
+    assert!(
+        SURFACES
+            .lock()
+            .unwrap()
+            .insert(
+                p,
+                Surface {
+                    refs: 0,
+                    device: owner,
+                    desc: [format, 1, usage, 0, 0, 0, width, height],
+                    texture: None
+                }
+            )
+            .is_none()
+    );
+    p
+}
+pub fn destroy_owned(ctx: &mut Context, this: u32) {
+    let s = SURFACES
+        .lock()
+        .unwrap()
+        .remove(&this)
+        .expect("invalid owned surface");
+    assert_eq!(s.refs, 0);
+    ctx.memory.write::<u32>(this, 0);
+    kernel32::lock().process_heap.free(&mut ctx.memory, this);
+}
+pub(super) fn create_texture(
+    ctx: &mut Context,
+    owner: u32,
+    texture: u32,
+    level: u32,
+    desc: [u32; 8],
+) -> u32 {
+    let vt = unsafe { VTABLE };
+    assert!(valid(ctx, vt, 17 * 4));
+    let p = kernel32::lock().process_heap.alloc(&mut ctx.memory, 4);
+    if p == 0 {
+        return 0;
+    }
+    ctx.memory.write::<u32>(p, vt);
+    SURFACES.lock().unwrap().insert(
+        p,
+        Surface {
+            refs: 0,
+            device: owner,
+            desc,
+            texture: Some((texture, level)),
+        },
+    );
+    p
+}
+#[win32_derive::dllexport]
+pub fn QueryInterface(ctx: &mut Context, this: u32, iid: u32, out: u32) -> u32 {
+    surface(this);
+    if !valid(ctx, out, 4) {
+        return E_POINTER;
+    }
+    ctx.memory.write::<u32>(out, 0);
+    if !valid(ctx, iid, 16) {
+        return E_POINTER;
+    }
+    let id = &ctx.memory.bytes[iid as usize..iid as usize + 16];
+    if id != IID_UNKNOWN && id != IID_SURFACE && id != IID_RESOURCE {
+        return E_NOINTERFACE;
+    }
+    AddRef(ctx, this);
+    ctx.memory.write::<u32>(out, this);
+    D3D_OK
+}
+#[win32_derive::dllexport]
+pub fn AddRef(ctx: &mut Context, this: u32) -> u32 {
+    let mut map = SURFACES.lock().unwrap();
+    let s = map.get_mut(&this).expect("invalid surface AddRef");
+    s.refs = s.refs.checked_add(1).expect("surface ref overflow");
+    let n = s.refs;
+    let owner = s.device;
+    let texture = s.texture;
+    drop(map);
+    if let Some((t, _)) = texture {
+        IDirect3DTexture9::AddRef(ctx, t);
+    } else {
+        IDirect3DDevice9::AddRef(ctx, owner);
+    }
+    n
+}
+#[win32_derive::dllexport]
+pub fn Release(ctx: &mut Context, this: u32) -> u32 {
+    let mut map = SURFACES.lock().unwrap();
+    let s = map.get_mut(&this).expect("invalid surface Release");
+    assert!(s.refs > 0);
+    s.refs -= 1;
+    let n = s.refs;
+    let owner = s.device;
+    let texture = s.texture;
+    drop(map);
+    if let Some((t, _)) = texture {
+        IDirect3DTexture9::Release(ctx, t);
+    } else {
+        IDirect3DDevice9::Release(ctx, owner);
+    }
+    n
+}
+#[win32_derive::dllexport]
+pub fn GetDevice(ctx: &mut Context, this: u32, out: u32) -> u32 {
+    let s = surface(this);
+    if !valid(ctx, out, 4) {
+        return D3DERR_INVALIDCALL;
+    }
+    IDirect3DDevice9::AddRef(ctx, s.device);
+    ctx.memory.write::<u32>(out, s.device);
+    D3D_OK
+}
+#[win32_derive::dllexport]
+pub fn GetType(_ctx: &mut Context, this: u32) -> u32 {
+    surface(this);
+    1
+}
+#[win32_derive::dllexport]
+pub fn GetDesc(ctx: &mut Context, this: u32, out: u32) -> u32 {
+    let s = surface(this);
+    if !valid(ctx, out, 32) {
+        return D3DERR_INVALIDCALL;
+    }
+    for (i, v) in s.desc.into_iter().enumerate() {
+        ctx.memory.write::<u32>(out + i as u32 * 4, v);
+    }
+    D3D_OK
+}
+fn fail(ctx: &Context, name: &str) -> ! {
+    panic!(
+        "unsupported API: d3d9!IDirect3DSurface9::{name}; stack_return={:#010x}",
+        ctx.memory.read::<u32>(ctx.cpu.regs.esp)
+    )
+}
+pub fn SetPrivateData_stdcall(ctx: &mut Context) -> runtime::Cont {
+    fail(ctx, "SetPrivateData")
+}
+pub fn GetPrivateData_stdcall(ctx: &mut Context) -> runtime::Cont {
+    fail(ctx, "GetPrivateData")
+}
+pub fn FreePrivateData_stdcall(ctx: &mut Context) -> runtime::Cont {
+    fail(ctx, "FreePrivateData")
+}
+pub fn SetPriority_stdcall(ctx: &mut Context) -> runtime::Cont {
+    fail(ctx, "SetPriority")
+}
+pub fn GetPriority_stdcall(ctx: &mut Context) -> runtime::Cont {
+    fail(ctx, "GetPriority")
+}
+pub fn PreLoad_stdcall(ctx: &mut Context) -> runtime::Cont {
+    fail(ctx, "PreLoad")
+}
+#[win32_derive::dllexport]
+pub fn GetContainer(ctx: &mut Context, this: u32, iid: u32, out: u32) -> u32 {
+    let s = surface(this);
+    if let Some((t, _)) = s.texture {
+        return IDirect3DTexture9::QueryInterface(ctx, t, iid, out);
+    }
+    fail(ctx, "GetContainer for attachment")
+}
+#[win32_derive::dllexport]
+pub fn LockRect(ctx: &mut Context, this: u32, out: u32, rect: u32, flags: u32) -> u32 {
+    let s = surface(this);
+    if let Some((t, level)) = s.texture {
+        return IDirect3DTexture9::LockRect(ctx, t, level, out, rect, flags);
+    }
+    D3DERR_INVALIDCALL
+}
+#[win32_derive::dllexport]
+pub fn UnlockRect(ctx: &mut Context, this: u32) -> u32 {
+    let s = surface(this);
+    if let Some((t, level)) = s.texture {
+        return IDirect3DTexture9::UnlockRect(ctx, t, level);
+    }
+    D3DERR_INVALIDCALL
+}
+pub fn GetDC_stdcall(ctx: &mut Context) -> runtime::Cont {
+    fail(ctx, "GetDC")
+}
+pub fn ReleaseDC_stdcall(ctx: &mut Context) -> runtime::Cont {
+    fail(ctx, "ReleaseDC")
+}
diff --git a/win32/winapi/src/d3d9/texture.rs b/win32/winapi/src/d3d9/texture.rs
new file mode 100644
index 0000000..9ccb4e4
--- /dev/null
+++ b/win32/winapi/src/d3d9/texture.rs
@@ -0,0 +1,608 @@
+//! D3D9 sampled 2D texture COM objects with persistent mip lock storage.
+use super::*;
+pub static mut VTABLE: u32 = 0;
+#[derive(Clone, Debug)]
+struct Mip {
+    width: u32,
+    height: u32,
+    pitch: u32,
+    offset: u32,
+    size: u32,
+    locked: Option<bool>,
+}
+#[derive(Clone)]
+struct Texture {
+    refs: u32,
+    bindings: u32,
+    owner: u32,
+    backend: u32,
+    gpu: u32,
+    data: u32,
+    usage: u32,
+    pool: u32,
+    format: u32,
+    mips: Vec<Mip>,
+    surfaces: Vec<u32>,
+}
+static TEXTURES: LazyLock<Mutex<HashMap<u32, Texture>>> =
+    LazyLock::new(|| Mutex::new(HashMap::new()));
+pub const VTABLE_ENTRIES: [&str; 22] = [
+    "QueryInterface",
+    "AddRef",
+    "Release",
+    "GetDevice",
+    "SetPrivateData",
+    "GetPrivateData",
+    "FreePrivateData",
+    "SetPriority",
+    "GetPriority",
+    "PreLoad",
+    "GetType",
+    "SetLOD",
+    "GetLOD",
+    "GetLevelCount",
+    "SetAutoGenFilterType",
+    "GetAutoGenFilterType",
+    "GenerateMipSubLevels",
+    "GetLevelDesc",
+    "GetSurfaceLevel",
+    "LockRect",
+    "UnlockRect",
+    "AddDirtyRect",
+];
+fn texture(this: u32) -> Texture {
+    TEXTURES
+        .lock()
+        .unwrap()
+        .get(&this)
+        .expect("invalid texture handle")
+        .clone()
+}
+fn layout(width: u32, height: u32, levels: u32, format: u32) -> Option<Vec<Mip>> {
+    if width == 0 || height == 0 || width > 4096 || height > 4096 {
+        return None;
+    }
+    let (block, bytes) = match format {
+        21 | 22 => (1, 4),
+        50 => (1, 1),
+        0x31545844 => (4, 8),
+        0x33545844 | 0x35545844 => (4, 16),
+        _ => return None,
+    };
+    if width % block != 0 || height % block != 0 {
+        return None;
+    }
+    let max = 32 - width.max(height).leading_zeros();
+    let levels = if levels == 0 { max } else { levels };
+    if levels > max {
+        return None;
+    }
+    let mut offset = 0;
+    let mut mips = Vec::new();
+    for level in 0..levels {
+        let w = (width >> level).max(1);
+        let h = (height >> level).max(1);
+        let pitch = w.div_ceil(block) * bytes;
+        let size = pitch * h.div_ceil(block);
+        mips.push(Mip {
+            width: w,
+            height: h,
+            pitch,
+            offset,
+            size,
+            locked: None,
+        });
+        offset += size;
+    }
+    Some(mips)
+}
+pub(super) fn create(
+    ctx: &mut Context,
+    owner: u32,
+    backend: u32,
+    width: u32,
+    height: u32,
+    levels: u32,
+    usage: u32,
+    format: u32,
+    pool: u32,
+    out: u32,
+    shared: u32,
+) -> u32 {
+    if !valid(ctx, out, 4) {
+        return D3DERR_INVALIDCALL;
+    }
+    ctx.memory.write::<u32>(out, 0);
+    if shared != 0 || pool > 1 || usage & !0x200 != 0 || (pool == 1 && usage != 0) {
+        return D3DERR_INVALIDCALL;
+    }
+    let Some(mips) = layout(width, height, levels, format) else {
+        return D3DERR_INVALIDCALL;
+    };
+    let gpu = host::graphics_call(10, &[backend, width, height, mips.len() as u32, format]);
+    if gpu >= 0x80000000 {
+        return gpu;
+    }
+    let size = mips.last().unwrap().offset + mips.last().unwrap().size;
+    let data = kernel32::lock().process_heap.alloc(&mut ctx.memory, size);
+    if data == 0 {
+        host::graphics_call(12, &[backend, gpu]);
+        return 0x8007000e;
+    }
+    let this = kernel32::lock().process_heap.alloc(&mut ctx.memory, 4);
+    if this == 0 {
+        kernel32::lock().process_heap.free(&mut ctx.memory, data);
+        host::graphics_call(12, &[backend, gpu]);
+        return 0x8007000e;
+    }
+    ctx.memory.bytes[data as usize..(data + size) as usize].fill(0);
+    let vt = unsafe { VTABLE };
+    assert!(valid(ctx, vt, 22 * 4));
+    ctx.memory.write::<u32>(this, vt);
+    IDirect3DDevice9::AddRef(ctx, owner);
+    TEXTURES.lock().unwrap().insert(
+        this,
+        Texture {
+            refs: 1,
+            bindings: 0,
+            owner,
+            backend,
+            gpu,
+            data,
+            usage,
+            pool,
+            format,
+            surfaces: vec![0; mips.len()],
+            mips,
+        },
+    );
+    ctx.memory.write::<u32>(out, this);
+    D3D_OK
+}
+#[win32_derive::dllexport]
+pub fn QueryInterface(ctx: &mut Context, this: u32, iid: u32, out: u32) -> u32 {
+    texture(this);
+    if !valid(ctx, out, 4) {
+        return E_POINTER;
+    }
+    ctx.memory.write::<u32>(out, 0);
+    if !valid(ctx, iid, 16) {
+        return E_POINTER;
+    }
+    const IDS: [[u8; 16]; 4] = [
+        IID_UNKNOWN,
+        [
+            0x5d, 0xc0, 0xee, 0x05, 0x7d, 0x8f, 0x62, 0x43, 0xb9, 0x99, 0xd1, 0xba, 0xf3, 0x57,
+            0xc7, 0x04,
+        ],
+        [
+            0x7e, 0xa8, 0x0c, 0x58, 0x3c, 0x1d, 0x54, 0x4d, 0x99, 0x1d, 0xb7, 0xd3, 0xe3, 0xc2,
+            0x98, 0xce,
+        ],
+        [
+            0x27, 0x12, 0xc3, 0x85, 0xe5, 0x3d, 0x00, 0x4f, 0x9b, 0x3a, 0xf1, 0x1a, 0xc3, 0x8c,
+            0x18, 0xb5,
+        ],
+    ];
+    if !IDS
+        .iter()
+        .any(|id| id == &ctx.memory.bytes[iid as usize..iid as usize + 16])
+    {
+        return E_NOINTERFACE;
+    }
+    AddRef(ctx, this);
+    ctx.memory.write::<u32>(out, this);
+    D3D_OK
+}
+#[win32_derive::dllexport]
+pub fn AddRef(ctx: &mut Context, this: u32) -> u32 {
+    let mut map = TEXTURES.lock().unwrap();
+    let s = map.get_mut(&this).expect("invalid texture AddRef");
+    let retain = s.refs == 0;
+    let owner = s.owner;
+    s.refs = s.refs.checked_add(1).expect("texture ref overflow");
+    let refs = s.refs;
+    drop(map);
+    if retain {
+        IDirect3DDevice9::AddRef(ctx, owner);
+    }
+    refs
+}
+fn destroy(ctx: &mut Context, this: u32, s: Texture) {
+    for surface in s.surfaces {
+        if surface != 0 {
+            IDirect3DSurface9::destroy_owned(ctx, surface)
+        }
+    }
+    host::graphics_call(12, &[s.backend, s.gpu]);
+    kernel32::lock().process_heap.free(&mut ctx.memory, s.data);
+    ctx.memory.write::<u32>(this, 0);
+    kernel32::lock().process_heap.free(&mut ctx.memory, this);
+}
+#[win32_derive::dllexport]
+pub fn Release(ctx: &mut Context, this: u32) -> u32 {
+    let mut map = TEXTURES.lock().unwrap();
+    let s = map.get_mut(&this).expect("invalid texture Release");
+    assert!(s.refs > 0);
+    s.refs -= 1;
+    if s.refs != 0 {
+        return s.refs;
+    }
+    let owner = s.owner;
+    let removed = if s.bindings == 0 {
+        map.remove(&this)
+    } else {
+        None
+    };
+    drop(map);
+    if let Some(s) = removed {
+        destroy(ctx, this, s)
+    }
+    IDirect3DDevice9::Release(ctx, owner);
+    0
+}
+pub(super) fn retain_binding(this: u32, owner: u32) -> bool {
+    let mut map = TEXTURES.lock().unwrap();
+    let Some(s) = map.get_mut(&this) else {
+        return false;
+    };
+    if s.owner != owner {
+        return false;
+    }
+    s.bindings = s.bindings.checked_add(1).expect("texture binding overflow");
+    true
+}
+pub(super) fn release_binding(ctx: &mut Context, this: u32) {
+    if this == 0 {
+        return;
+    }
+    let mut map = TEXTURES.lock().unwrap();
+    let s = map.get_mut(&this).expect("invalid texture binding");
+    assert!(s.bindings > 0);
+    s.bindings -= 1;
+    let removed = if s.refs == 0 && s.bindings == 0 {
+        map.remove(&this)
+    } else {
+        None
+    };
+    drop(map);
+    if let Some(s) = removed {
+        destroy(ctx, this, s)
+    }
+}
+#[win32_derive::dllexport]
+pub fn GetDevice(ctx: &mut Context, this: u32, out: u32) -> u32 {
+    let s = texture(this);
+    if !valid(ctx, out, 4) {
+        return D3DERR_INVALIDCALL;
+    }
+    IDirect3DDevice9::AddRef(ctx, s.owner);
+    ctx.memory.write::<u32>(out, s.owner);
+    D3D_OK
+}
+
+#[win32_derive::dllexport]
+pub fn GetType(_ctx: &mut Context, this: u32) -> u32 {
+    texture(this);
+    3
+}
+#[win32_derive::dllexport]
+pub fn GetLevelCount(_ctx: &mut Context, this: u32) -> u32 {
+    texture(this).mips.len() as u32
+}
+#[win32_derive::dllexport]
+pub fn GetLevelDesc(ctx: &mut Context, this: u32, level: u32, out: u32) -> u32 {
+    let t = texture(this);
+    let Some(m) = t.mips.get(level as usize) else {
+        return D3DERR_INVALIDCALL;
+    };
+    if !valid(ctx, out, 32) {
+        return D3DERR_INVALIDCALL;
+    }
+    for (i, v) in [t.format, 1, t.usage, t.pool, 0, 0, m.width, m.height]
+        .into_iter()
+        .enumerate()
+    {
+        ctx.memory.write::<u32>(out + i as u32 * 4, v)
+    }
+    D3D_OK
+}
+fn lockable(t: &Texture, level: u32, flags: u32) -> bool {
+    let Some(m) = t.mips.get(level as usize) else {
+        return false;
+    };
+    m.locked.is_none()
+        && flags & !0x2810 == 0
+        && !(flags & 0x10 != 0 && flags & 0x2000 != 0)
+        && (t.pool != 0 || t.usage & 0x200 != 0)
+        && (flags & 0x2000 == 0 || t.usage & 0x200 != 0)
+}
+fn rectangle_offset(m: &Mip, format: u32, r: [u32; 4]) -> Option<u32> {
+    let [left, top, right, bottom] = r;
+    let (block, bytes) = match format {
+        21 | 22 => (1, 4),
+        50 => (1, 1),
+        0x31545844 => (4, 8),
+        _ => (4, 16),
+    };
+    if left >= right
+        || top >= bottom
+        || right > m.width
+        || bottom > m.height
+        || left % block != 0
+        || top % block != 0
+        || (right != m.width && right % block != 0)
+        || (bottom != m.height && bottom % block != 0)
+    {
+        return None;
+    }
+    Some(top / block * m.pitch + left / block * bytes)
+}
+#[win32_derive::dllexport]
+pub fn LockRect(ctx: &mut Context, this: u32, level: u32, out: u32, rect: u32, flags: u32) -> u32 {
+    if !valid(ctx, out, 8) {
+        return D3DERR_INVALIDCALL;
+    }
+    let mut map = TEXTURES.lock().unwrap();
+    let t = map.get_mut(&this).expect("invalid texture LockRect");
+    // Upload the full mip on unlock; untouched staging bytes preserve its other regions.
+    if (rect != 0 && flags & 0x2000 != 0)
+        || (flags & 0x2000 != 0 && (level != 0 || t.mips.iter().any(|m| m.locked.is_some())))
+        || !lockable(t, level, flags)
+    {
+        return D3DERR_INVALIDCALL;
+    }
+    let offset = if rect == 0 {
+        0
+    } else {
+        if !valid(ctx, rect, 16) {
+            return D3DERR_INVALIDCALL;
+        }
+        let r = std::array::from_fn(|i| ctx.memory.read::<u32>(rect + i as u32 * 4));
+        let Some(offset) = rectangle_offset(&t.mips[level as usize], t.format, r) else {
+            return D3DERR_INVALIDCALL;
+        };
+        offset
+    };
+    if flags & 0x2000 != 0 {
+        for m in &t.mips {
+            ctx.memory.bytes[(t.data + m.offset) as usize..(t.data + m.offset + m.size) as usize]
+                .fill(0);
+        }
+    }
+    let m = &mut t.mips[level as usize];
+    m.locked = Some(flags & 0x10 != 0);
+    ctx.memory.write::<u32>(out, m.pitch);
+    ctx.memory.write::<u32>(out + 4, t.data + m.offset + offset);
+    D3D_OK
+}
+#[win32_derive::dllexport]
+pub fn UnlockRect(ctx: &mut Context, this: u32, level: u32) -> u32 {
+    let t = texture(this);
+    let Some(m) = t.mips.get(level as usize) else {
+        return D3DERR_INVALIDCALL;
+    };
+    let Some(readonly) = m.locked else {
+        return D3DERR_INVALIDCALL;
+    };
+    if !readonly {
+        let pointer = ctx.memory.bytes[(t.data + m.offset) as usize..].as_ptr() as usize as u32;
+        let result = host::graphics_call(11, &[t.backend, t.gpu, level, pointer, m.pitch, m.size]);
+        if result != 1 {
+            return result;
+        }
+    }
+    TEXTURES.lock().unwrap().get_mut(&this).unwrap().mips[level as usize].locked = None;
+    D3D_OK
+}
