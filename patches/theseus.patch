@@ -34,6 +34,23 @@ impl Heap {
             .unwrap_or_else(|| panic!("heap size {:x} oom {:x}", self.size, size))
     }
 
+    /// Move an allocation without losing the old block on allocation failure.
+    pub fn realloc(&self, mem: &mut Memory, addr: u32, size: u32, zero_new: bool) -> Option<u32> {
+        if addr < self.addr + 4 || !self.range().contains(&(addr - 4)) { return None; }
+        let old_size = self.size(mem, addr);
+        let old_end = addr.checked_add(old_size)?;
+        if old_end > self.addr.checked_add(self.size)? { return None; }
+        size.checked_add(4)?;
+        let new_addr = self.freelist.borrow_mut().alloc(mem, size)?;
+        let copied = old_size.min(size) as usize;
+        mem.bytes.copy_within(addr as usize..addr as usize + copied, new_addr as usize);
+        if zero_new && size > old_size {
+            mem.bytes[new_addr as usize + copied..new_addr as usize + size as usize].fill(0);
+        }
+        self.free(mem, addr);
+        Some(new_addr)
+    }
+
     #[allow(unused)]
     pub fn size(&self, mem: &mut Memory, addr: u32) -> u32 {
         mem.read::<u32>(addr - 4) - 4
@@ -139,3 +156,23 @@ impl FreeNode {
         self.addr..self.addr + self.size
     }
 }
+
+#[cfg(test)]
+mod realloc_tests {
+    use super::*;
+    #[test]
+    fn preserve_grow_shrink_and_failure() {
+        let mut mem = Memory::leak_new(0x4000);
+        let heap = Heap::new(0x1000, 0x1000);
+        let p = heap.alloc(&mut mem, 4);
+        mem.write::<u32>(p, 0xdeadbeef);
+        let q = heap.realloc(&mut mem, p, 12, true).unwrap();
+        assert_eq!(mem.read::<u32>(q), 0xdeadbeef);
+        assert_eq!(&mem.bytes[q as usize+4..q as usize+12], &[0;8]);
+        assert_eq!(heap.realloc(&mut mem, q, 0x2000, false), None);
+        assert_eq!(mem.read::<u32>(q), 0xdeadbeef);
+        let t = heap.realloc(&mut mem, q, 2, false).unwrap();
+        assert_eq!(mem.read::<u16>(t), 0xbeef);
+        assert_eq!(heap.realloc(&mut mem, t, u32::MAX, false), None);
+    }
+}
