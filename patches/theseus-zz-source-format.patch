+pub fn bit_memory(
+    memory: &mut Memory,
+    flags: &mut Flags,
+    base: u32,
+    index: i32,
+    width: u32,
+    operation: u32,
+) {
+    let addr = bit_address(base, index, width);
+    let old = if width == 16 {
+        memory.read::<u16>(addr) as u32
+    } else {
+        memory.read::<u32>(addr)
+    };
+    let value = bit_word(old, index as u32, width, operation, flags);
+    if operation != 0 {
+        if width == 16 {
+            memory.write::<u16>(addr, value as u16)
+        } else {
+            memory.write::<u32>(addr, value)
+        }
+    }
 }
