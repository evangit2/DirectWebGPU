+#[win32_derive::dllexport]
+pub fn AddDirtyRect(ctx: &mut Context, this: u32, face: u32, rect: u32) -> u32 {
+    if !IDirect3DTexture9::is_cube(this) || face >= 6 || (rect != 0 && !valid(ctx, rect, 16)) {
+        D3DERR_INVALIDCALL
+    } else {
+        // UnlockRect uploads complete subresources immediately, so no deferred
+        // dirty-region bookkeeping is needed for the supported managed path.
+        D3D_OK
+    }
+}
