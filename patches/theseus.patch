+// The Windows compatibility runtime executes guest code at virtual CPL3/IOPL0.
+pub fn pushfd(ctx: &mut Context) {
+    ctx.push32((ctx.cpu.flags.bits() & 0x00244dd5) | 0x202);
+}
+pub fn popfd(ctx: &mut Context) {
+    let bits = ctx.pop32();
+    assert_eq!(bits & 0x100, 0, "unsupported x86 single-step flag");
+    ctx.cpu.flags = Flags::from_bits_retain((bits & 0x00244dd5) | 0x202);
+}
