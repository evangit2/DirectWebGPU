+/// Copy a rectangle between texture-backed surfaces. D3D8 uses this path for
+/// image uploads, so the copy updates both the CPU staging bytes and the
+/// browser GPU texture through the same upload operation as UnlockRect.
+pub(crate) fn copy_region(
+    ctx: &mut Context,
+    source: u32,
+    source_level: u32,
+    dest: u32,
+    dest_level: u32,
+    source_rect: [u32; 4],
+    dest_left: u32,
+    dest_top: u32,
+) -> u32 {
+    let src = texture(source);
+    let dst = texture(dest);
+    let Some(sm) = src.mips.get(source_level as usize) else { return D3DERR_INVALIDCALL; };
+    let Some(dm) = dst.mips.get(dest_level as usize) else { return D3DERR_INVALIDCALL; };
+    if src.format != dst.format { return D3DERR_INVALIDCALL; }
+    let [left, top, right, bottom] = source_rect;
+    if left >= right || top >= bottom || right > sm.width || bottom > sm.height {
+        return D3DERR_INVALIDCALL;
+    }
+    let width = right - left;
+    let height = bottom - top;
+    if dest_left.checked_add(width).is_none_or(|v| v > dm.width)
+        || dest_top.checked_add(height).is_none_or(|v| v > dm.height)
+    {
+        return D3DERR_INVALIDCALL;
+    }
+    let (block, bytes) = match src.format {
+        21 | 22 => (1, 4),
+        50 => (1, 1),
+        _ => return D3DERR_INVALIDCALL,
+    };
+    if left % block != 0 || top % block != 0 || dest_left % block != 0 || dest_top % block != 0 {
+        return D3DERR_INVALIDCALL;
+    }
+    let Some(row_bytes_u32) = width.checked_mul(bytes) else { return D3DERR_INVALIDCALL; };
+    let row_bytes = row_bytes_u32 as usize;
+    let src_base = src.data + sm.offset + top / block * sm.pitch + left / block * bytes;
+    let dst_base = dst.data + dm.offset + dest_top / block * dm.pitch + dest_left / block * bytes;
+    for row in 0..height {
+        let src_start = (src_base + row * sm.pitch) as usize;
+        let dst_start = (dst_base + row * dm.pitch) as usize;
+        let Some(src_end) = src_start.checked_add(row_bytes) else { return D3DERR_INVALIDCALL; };
+        let Some(dst_end) = dst_start.checked_add(row_bytes) else { return D3DERR_INVALIDCALL; };
+        if src_end > ctx.memory.bytes.len() || dst_end > ctx.memory.bytes.len() {
+            return D3DERR_INVALIDCALL;
+        }
+        let row_copy = ctx.memory.bytes[src_start..src_end].to_vec();
+        ctx.memory.bytes[dst_start..dst_end].copy_from_slice(&row_copy);
+    }
+    let result = host::graphics_call(11, &[dst.backend, dst.gpu, dest_level, dst.data + dm.offset, dm.pitch, dm.size]);
+    if result == 1 { D3D_OK } else { result }
+}
