+//! Minimal Winsock ABI surface for older games.
+//!
+//! Networking is intentionally local and nonblocking here. Calls retain
+//! their stdcall contracts and fail predictably instead of crashing the guest
+//! when a game probes online services during startup.
+
+use runtime::Context;
+use crate::Ptr;
+
+#[win32_derive::dllexport]
+pub fn ordinal108(_ctx: &mut Context, _handle: u32) -> i32 { 0 }
+
+#[win32_derive::dllexport]
+pub fn ordinal3(_ctx: &mut Context, _socket: u32) -> i32 { 0 }
+
+#[win32_derive::dllexport]
+pub fn ordinal12(_ctx: &mut Context, _addr: u32) -> u32 { 0 }
+
+#[win32_derive::dllexport]
+pub fn ordinal11(ctx: &mut Context, addr: Ptr<u8>) -> u32 {
+    let text = ctx.memory.read_str(addr.addr);
+    let mut value = 0u32;
+    for (i, part) in text.split('.').take(4).enumerate() {
+        let Ok(byte) = part.parse::<u8>() else { return 0xffff_ffff; };
+        value |= (byte as u32) << (i * 8);
+    }
+    value
+}
+
+#[win32_derive::dllexport]
+pub fn ordinal9(_ctx: &mut Context, value: u16) -> u16 { value.to_be() }
+
+#[win32_derive::dllexport]
+pub fn ordinal23(_ctx: &mut Context, _af: i32, _kind: i32, _protocol: i32) -> u32 { 1 }
+
+#[win32_derive::dllexport]
+pub fn ordinal4(_ctx: &mut Context, _socket: u32, _name: u32, _name_len: i32) -> i32 { -1 }
+
+#[win32_derive::dllexport]
+pub fn ordinal10(_ctx: &mut Context, _socket: u32, _cmd: u32, _argp: u32) -> i32 { 0 }
+
+#[win32_derive::dllexport]
+pub fn ordinal19(_ctx: &mut Context, _socket: u32, _buf: u32, _len: i32, _flags: i32) -> i32 { -1 }
+
+#[win32_derive::dllexport]
+pub fn ordinal16(_ctx: &mut Context, _socket: u32, _buf: u32, _len: i32, _flags: i32) -> i32 { 0 }
+
+#[win32_derive::dllexport]
+pub fn ordinal111(_ctx: &mut Context) -> i32 { 0 }
+
+#[win32_derive::dllexport]
+pub fn ordinal115(ctx: &mut Context, _version: u16, data: Ptr<u8>) -> i32 {
+    if data.addr != 0 { ctx.memory.bytes[data.addr as usize..data.addr as usize + 2].copy_from_slice(&1u16.to_le_bytes()); }
