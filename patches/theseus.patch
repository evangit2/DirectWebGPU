+        let mut f = super::FPU::default();
+        for (rc, positive, negative) in [
+            (0, 2.0, -2.0),
+            (1, 2.0, -3.0),
+            (2, 3.0, -2.0),
+            (3, 2.0, -2.0),
+        ] {
+            f.control = (f.control & !0xc00) | (rc << 10);
+            assert_eq!(f.round(2.5), positive);
+            assert_eq!(f.round(-2.5), negative);
+        }
+        f.push(42.0);
+        f.initialize();
+        assert_eq!(f.st_top, 8);
+        assert_eq!(f.status(), 0);
+        assert_eq!(f.control, 0x37f);
+        assert_eq!(f.st[7], 42.0);
+    }
