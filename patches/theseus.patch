+/// User-mode virtual CPU identity. Do not advertise SIMD or OS services
+/// that this runtime cannot execute. Unknown leaves return zero.
+pub fn cpuid(regs: &mut crate::Regs) {
+    let leaf = regs.eax;
+    regs.eax = 0;
+    regs.ebx = 0;
+    regs.ecx = 0;
+    regs.edx = 0;
+    match leaf {
+        0 => {
+            regs.eax = 1;
+            regs.ebx = u32::from_le_bytes(*b"Thes");
+            regs.edx = u32::from_le_bytes(*b"eusW");
+            regs.ecx = u32::from_le_bytes(*b"asm!");
+        }
+        1 => { regs.eax = 0x500; regs.edx = 0x11; } // x87 and the virtual timestamp counter
+        0x8000_0000 => regs.eax = 0x8000_0000,
+        _ => {}
+    }
+}
+
+#[cfg(test)]
+mod virtual_cpu_tests {
+    #[test]
+    fn no_unimplemented_simd_advertised() {
+        let mut regs = crate::Regs::default();
+        regs.eax = 1;
+        regs.esi = 0x12345678;
+        super::cpuid(&mut regs);
+        assert_eq!(regs.edx & ((1 << 23) | (1 << 25) | (1 << 26)), 0);
+        assert_eq!(regs.ecx, 0);
+        assert_eq!(regs.esi, 0x12345678);
+        regs.eax = 7;
+        super::cpuid(&mut regs);
+        assert_eq!((regs.eax, regs.ebx, regs.ecx, regs.edx), (0,0,0,0));
+    }
+}
