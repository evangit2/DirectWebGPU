diff --git a/win32/winapi/src/user32/mod.rs b/win32/winapi/src/user32/mod.rs
index 7147370..7935a9f 100644
--- a/win32/winapi/src/user32/mod.rs
+++ b/win32/winapi/src/user32/mod.rs
@@ -37,6 +37,35 @@ pub struct State {
     pub window: RefCell<Option<Rc<RefCell<Window>>>>,
     message_queue: RefCell<MessageQueue>,
     pub input: RefCell<Input>,
+    pub(crate) cursor: RefCell<CursorState>,
+}
+
+#[derive(Debug)]
+pub(crate) struct CursorState {
+    display_count: i32,
+    handle: HCURSOR,
+}
+
+impl Default for CursorState {
+    fn default() -> Self { Self { display_count: 0, handle: 0 } }
+}
+
+impl CursorState {
+    pub(crate) fn visible(&self) -> bool { self.display_count >= 0 && self.handle != 0 }
+    pub(crate) fn show(&mut self, show: bool) -> i32 {
+        self.display_count = if show { self.display_count.saturating_add(1) } else { self.display_count.saturating_sub(1) };
+        self.display_count
+    }
+    pub(crate) fn set(&mut self, handle: HCURSOR) -> HCURSOR {
+        std::mem::replace(&mut self.handle, handle)
+    }
+}
+
+pub(crate) fn notify_cursor_visibility(visible: bool) {
+    #[cfg(target_family = "wasm")]
+    host::host().set_cursor_visible(visible);
+    #[cfg(not(target_family = "wasm"))]
+    let _ = visible;
 }
 
 // TODO: reuse locking pattern from kernel32
@@ -52,5 +81,24 @@ pub fn state() -> &'static State {
         wndclass: Default::default(),
         message_queue: Default::default(),
         input: Default::default(),
+        cursor: Default::default(),
     })
 }
+
+#[cfg(test)]
+mod cursor_tests {
+    use super::CursorState;
+
+    #[test]
+    fn show_cursor_uses_the_windows_display_counter() {
+        let mut cursor=CursorState::default();
+        cursor.set(0x1234);
+        assert!(cursor.visible());
+        assert_eq!(cursor.show(false),-1);
+        assert!(!cursor.visible());
+        assert_eq!(cursor.show(true),0);
+        assert!(cursor.visible());
+        assert_eq!(cursor.set(0),0x1234);
+        assert!(!cursor.visible());
+    }
+}
