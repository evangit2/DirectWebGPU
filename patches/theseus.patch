+//! Shader COM objects retain original bytecode; GPU translation occurs on draw.
+use super::*;
+#[derive(Clone)]
+struct Shader {
+    refs: u32,
+    bindings: u32,
+    owner: u32,
+    backend: u32,
+    gpu: u32,
+    stage: u32,
+    bytes: std::sync::Arc<[u8]>,
+}
+static SHADERS: LazyLock<Mutex<HashMap<u32, Shader>>> =
+    LazyLock::new(|| Mutex::new(HashMap::new()));
+pub const VTABLE_ENTRIES: [&str; 5] = [
+    "QueryInterface",
+    "AddRef",
+    "Release",
+    "GetDevice",
+    "GetFunction",
+];
+fn shader(this: u32) -> Shader {
+    SHADERS
+        .lock()
+        .unwrap()
+        .get(&this)
+        .expect("invalid shader handle")
+        .clone()
+}
+// Skip full instructions and comments: END-like DWORDs inside DEF or comments
+// are data, not terminators. Full opcode validation is delegated to MojoShader.
+fn bytecode(ctx: &Context, pointer: u32, stage: u32) -> Option<Vec<u8>> {
+    if !valid(ctx, pointer, 8) {
+        return None;
+    }
+    let version = ctx.memory.read::<u32>(pointer);
+    if version != if stage == 0 { 0xfffe0101 } else { 0xffff0200 } {
+        return None;
+    }
+    let mut offset = 4u32;
+    while offset < 1048576 {
+        let address = pointer.checked_add(offset)?;
+        if !valid(ctx, address, 4) {
+            return None;
+        }
+        let token = ctx.memory.read::<u32>(address);
+        let opcode = token & 0xffff;
+        if token == 0xffff {
+            return Some(ctx.memory.bytes[pointer as usize..address as usize + 4].to_vec());
+        }
+        let operands = if opcode == 0xfffe {
+            (token >> 16) & 0x7fff
+        } else if stage == 1 {
+            (token >> 24) & 15
+        } else {
+            match opcode {
+                0 => 0,
+                1 | 6 | 7 | 14 | 15 | 16 | 19 | 78 | 79 => 2,
+                2 | 3 | 5 | 8 | 9 | 10 | 11 | 12 | 13 | 17 | 20..=24 => 3,
+                4 | 18 => 4,
+                31 => 2,
+                81 => 5,
+                _ => return None,
+            }
+        };
+        offset = offset.checked_add((operands + 1) * 4)?;
+    }
+    None
+}
+pub(super) fn create(
+    ctx: &mut Context,
+    owner: u32,
+    backend: u32,
+    stage: u32,
+    pointer: u32,
+    out: u32,
+) -> u32 {
+    if !valid(ctx, out, 4) {
+        return D3DERR_INVALIDCALL;
+    }
+    ctx.memory.write::<u32>(out, 0);
+    let Some(bytes) = bytecode(ctx, pointer, stage) else {
+        return D3DERR_INVALIDCALL;
+    };
+    let host_pointer = ctx.memory.bytes[pointer as usize..].as_ptr() as usize as u32;
+    let gpu = host::graphics_call(8, &[backend, stage, host_pointer, bytes.len() as u32]);
+    if gpu >= 0x80000000 {
+        return gpu;
+    }
+    let this = kernel32::lock().process_heap.alloc(&mut ctx.memory, 4);
+    if this == 0 {
+        host::graphics_call(9, &[backend, gpu]);
+        return 0x8007000e;
+    }
+    let vt = unsafe {
+        if stage == 0 {
+            IDirect3DVertexShader9::VTABLE
+        } else {
+            IDirect3DPixelShader9::VTABLE
+        }
+    };
+    assert!(valid(ctx, vt, 20));
+    ctx.memory.write::<u32>(this, vt);
+    IDirect3DDevice9::AddRef(ctx, owner);
+    SHADERS.lock().unwrap().insert(
+        this,
+        Shader {
+            refs: 1,
+            bindings: 0,
+            owner,
+            backend,
+            gpu,
+            stage,
+            bytes: bytes.into(),
+        },
+    );
+    ctx.memory.write::<u32>(out, this);
+    D3D_OK
+}
+#[win32_derive::dllexport]
+pub fn QueryInterface(ctx: &mut Context, this: u32, iid: u32, out: u32) -> u32 {
+    let s = shader(this);
+    if !valid(ctx, out, 4) {
+        return E_POINTER;
+    }
+    ctx.memory.write::<u32>(out, 0);
+    if !valid(ctx, iid, 16) {
+        return E_POINTER;
+    }
+    let own = if s.stage == 0 {
+        [
+            0x7e, 0x55, 0xc5, 0xef, 0x65, 0x62, 0x13, 0x46, 0x8a, 0x94, 0x43, 0x85, 0x78, 0x89,
+            0xeb, 0x36,
+        ]
+    } else {
+        [
+            0xdc, 0xdb, 0x3b, 0x6d, 0x02, 0x5b, 0x15, 0x44, 0xb8, 0x52, 0xce, 0x5e, 0x8b, 0xcc,
+            0xb2, 0x89,
+        ]
+    };
+    let id = &ctx.memory.bytes[iid as usize..iid as usize + 16];
+    if id != own && id != IID_UNKNOWN {
+        return E_NOINTERFACE;
+    }
+    AddRef(ctx, this);
+    ctx.memory.write::<u32>(out, this);
+    D3D_OK
+}
+#[win32_derive::dllexport]
+pub fn AddRef(ctx: &mut Context, this: u32) -> u32 {
+    let mut map = SHADERS.lock().unwrap();
+    let s = map.get_mut(&this).expect("invalid shader AddRef");
+    let retain = s.refs == 0;
+    let owner = s.owner;
+    s.refs = s.refs.checked_add(1).expect("shader ref overflow");
+    let refs = s.refs;
+    drop(map);
+    if retain {
+        IDirect3DDevice9::AddRef(ctx, owner);
+    }
+    refs
+}
+fn destroy(ctx: &mut Context, this: u32, s: Shader) {
+    host::graphics_call(9, &[s.backend, s.gpu]);
+    ctx.memory.write::<u32>(this, 0);
+    kernel32::lock().process_heap.free(&mut ctx.memory, this);
+}
+#[win32_derive::dllexport]
+pub fn Release(ctx: &mut Context, this: u32) -> u32 {
+    let mut map = SHADERS.lock().unwrap();
+    let s = map.get_mut(&this).expect("invalid shader Release");
+    assert!(s.refs > 0);
+    s.refs -= 1;
+    if s.refs != 0 {
+        return s.refs;
+    }
+    let owner = s.owner;
+    let removed = if s.bindings == 0 {
+        map.remove(&this)
+    } else {
+        None
+    };
+    drop(map);
+    if let Some(s) = removed {
+        destroy(ctx, this, s)
+    }
+    IDirect3DDevice9::Release(ctx, owner);
+    0
+}
+pub(super) fn retain_binding(this: u32, owner: u32, stage: u32) -> bool {
+    let mut map = SHADERS.lock().unwrap();
+    let Some(s) = map.get_mut(&this) else {
+        return false;
+    };
+    if s.owner != owner || s.stage != stage {
+        return false;
+    }
+    s.bindings = s.bindings.checked_add(1).expect("shader binding overflow");
+    true
+}
+pub(super) fn release_binding(ctx: &mut Context, this: u32) {
+    if this == 0 {
+        return;
+    }
+    let mut map = SHADERS.lock().unwrap();
+    let s = map.get_mut(&this).expect("invalid shader binding");
+    assert!(s.bindings > 0);
+    s.bindings -= 1;
+    let removed = if s.refs == 0 && s.bindings == 0 {
+        map.remove(&this)
+    } else {
+        None
+    };
+    drop(map);
+    if let Some(s) = removed {
+        destroy(ctx, this, s)
+    }
+}
+#[win32_derive::dllexport]
+pub fn GetDevice(ctx: &mut Context, this: u32, out: u32) -> u32 {
+    let s = shader(this);
+    if !valid(ctx, out, 4) {
+        return D3DERR_INVALIDCALL;
+    }
+    IDirect3DDevice9::AddRef(ctx, s.owner);
+    ctx.memory.write::<u32>(out, s.owner);
+    D3D_OK
+}
+#[win32_derive::dllexport]
+pub fn GetFunction(ctx: &mut Context, this: u32, out: u32, size: u32) -> u32 {
+    let s = shader(this);
+    if !valid(ctx, size, 4) {
+        return D3DERR_INVALIDCALL;
+    }
+    let capacity = ctx.memory.read::<u32>(size);
+    ctx.memory.write::<u32>(size, s.bytes.len() as u32);
+    if out == 0 {
+        return D3D_OK;
+    }
+    if capacity < s.bytes.len() as u32 || !valid(ctx, out, s.bytes.len()) {
+        return D3DERR_INVALIDCALL;
+    }
+    ctx.memory.bytes[out as usize..out as usize + s.bytes.len()].copy_from_slice(&s.bytes);
+    D3D_OK
+}
+#[cfg(test)]
+pub(super) fn fixture(ctx: &mut Context, owner: u32, stage: u32) -> u32 {
+    // Native COM ownership fixture; no GPU creation is claimed.
+    let this = kernel32::lock().process_heap.alloc(&mut ctx.memory, 4);
+    ctx.memory.write::<u32>(this, 0x1b00);
+    IDirect3DDevice9::AddRef(ctx, owner);
+    let bytes: Vec<u8> = [0xfffe0101u32, 1, 0xc00f0000, 0x90e40000, 0xffff]
+        .into_iter()
+        .flat_map(u32::to_le_bytes)
+        .collect();
+    SHADERS.lock().unwrap().insert(
+        this,
+        Shader {
+            refs: 1,
+            bindings: 0,
+            owner,
+            backend: 1,
+            gpu: 1,
+            stage,
+            bytes: bytes.into(),
+        },
+    );
+    this
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn bytecode_skips_end_values_in_comments_and_def() {
+        let mut ctx = Context {
+            cpu: Default::default(),
+            thread_handle: 1,
+            thread_id: 1,
+            memory: runtime::Memory::leak_new(0x3000),
+            blocks: &[],
+            cache: Default::default(),
+            recent: [Context::return_from_x86; 4],
+        };
+        let words = [
+            0xfffe0101, 0x0001fffe, 0xffff, 81, 0xa00f0000, 0xffff, 0, 0, 0, 0xffff,
+        ];
+        for (i, v) in words.into_iter().enumerate() {
+            ctx.memory.write::<u32>(0x1000 + i as u32 * 4, v)
+        }
+        assert_eq!(bytecode(&ctx, 0x1000, 0).unwrap().len(), 40);
+        assert!(bytecode(&ctx, 0x1000, 1).is_none());
+        assert!(bytecode(&ctx, u32::MAX - 2, 0).is_none());
+        ctx.memory.write::<u32>(0x1004, 12345);
+        assert!(bytecode(&ctx, 0x1000, 0).is_none());
+    }
+}
+pub(super) fn gpu_handle(this:u32)->u32{shader(this).gpu}
