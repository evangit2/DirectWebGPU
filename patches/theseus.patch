+#[cfg(test)]
+mod registry_tests {
+    use super::*;
+    #[test]
+    fn create_query_reopen_rights_and_stdcall() {
+        crate::trace::init("");
+        let mut ctx = Context {
+            cpu: Default::default(),
+            thread_handle: 1,
+            thread_id: 1,
+            memory: runtime::Memory::leak_new(0x5000),
+            blocks: &[(runtime::RETURN_FROM_X86_ADDR32, Context::return_from_x86)],
+            cache: Default::default(),
+            recent: [Context::return_from_x86; 4],
+        };
+        ctx.cpu.regs.esp = 0x4000;
+        let path = b"Software\\RegistryTest\0";
+        ctx.memory.bytes[0x1100..0x1100 + path.len()].copy_from_slice(path);
+        ctx.memory.bytes[0x1200..0x1206].copy_from_slice(b"Value\0");
+        ctx.call32_x86(
+            runtime::Cont(RegCreateKeyExA_stdcall),
+            vec![0x80000002, 0x1100, 0, 0, 0, 0x20006, 0, 0x1300, 0x1304],
+        );
+        assert_eq!(ctx.cpu.regs.eax, 0);
+        assert_eq!(ctx.cpu.regs.esp, 0x4000);
+        assert_eq!(ctx.memory.read::<u32>(0x1304), 1);
+        let h = ctx.memory.read::<u32>(0x1300);
+        ctx.memory.write::<u32>(0x1400, 0x12345678);
+        assert_eq!(RegSetValueExA(&mut ctx, h, 0x1200, 0, 4, 0x1400, 4), 0);
+        assert_eq!(RegQueryValueExA(&mut ctx, h, 0x1200, 0, 0, 0, 0x1500), 5);
+        assert_eq!(RegCloseKey(&mut ctx, h), 0);
+        assert_eq!(RegCloseKey(&mut ctx, h), 6);
+        assert_eq!(RegOpenKeyExA(&mut ctx, 0x80000002, 0x1100, 0, 1, 0x1300), 0);
+        let h = ctx.memory.read::<u32>(0x1300);
+        assert_eq!(
+            RegQueryValueExA(&mut ctx, h, 0x1200, 0, 0x1504, 0, 0x1500),
+            0
+        );
+        assert_eq!(ctx.memory.read::<u32>(0x1500), 4);
+        assert_eq!(ctx.memory.read::<u32>(0x1504), 4);
+        ctx.memory.write::<u32>(0x1500, 2);
+        ctx.memory.write::<u32>(0x1600, 0xa5a5a5a5);
+        assert_eq!(
+            RegQueryValueExA(&mut ctx, h, 0x1200, 0, 0, 0x1600, 0x1500),
+            234
+        );
+        assert_eq!(ctx.memory.read::<u32>(0x1600), 0xa5a5a5a5);
+        assert_eq!(
+            RegQueryValueExA(&mut ctx, h, 0x1200, 0, 0, 0x1600, 0x1500),
+            0
+        );
+        assert_eq!(ctx.memory.read::<u32>(0x1600), 0x12345678);
+        assert_eq!(RegSetValueExA(&mut ctx, h, 0x1200, 0, 4, 0x1400, 4), 5);
+        assert_eq!(RegCloseKey(&mut ctx, h), 0);
+    }
+}
